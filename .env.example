# Tinykit configuration
# AI is optional. Use /tinykit/settings, or uncomment a complete configuration.
# A nonempty LLM_API_KEY or LLM_BASE_URL overrides saved AI settings.

# DeepSeek
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-flash
# LLM_API_KEY=your-deepseek-key

# Local server (use host.docker.internal instead of localhost from Docker)
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=your-loaded-model-id
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=

# Other providers: openai, anthropic, gemini
# Use the exact model ID and key from your provider.
# See docs/ai-providers.md for details.

# Node server configuration (optional; Compose sets its own port to 3000)
PORT=5173
HOST=0.0.0.0

# External PocketBase URL (only if not using built-in)
# POCKETBASE_URL=http://127.0.0.1:8091
