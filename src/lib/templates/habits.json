  ],
  "frontend_code": "<script>\n\timport Icon from '@iconify/svelte'\n\timport { onMount, onDestroy, tick } from 'svelte'\n\timport content from '$content'\n\timport data from '$data'\n\tconst list_params = { all: true }\n\n\tlet habits = $state([])\n\tlet completions = $state([])\n\tlet habits_ready = $state(false)\n\tlet completions_ready = $state(false)\n\tlet loading = $derived.by(() => !habits_ready || !completions_ready)\n\tlet load_error = $state(false)\n\tlet retrying = $state(false)\n\tlet disposed = false\n\tlet habits_version = 0\n\tlet completions_version = 0\n\tlet habits_failed = false\n\tlet completions_failed = false\n\tlet error = $state('')\n\tlet view = $state('week')\n\tlet pending_cells = $state([])\n\tlet pending_habits = $state([])\n\tlet archived_habit = $state(null)\n\tlet grid = $state(null)\n\n\tfunction receive_habits(items) {\n\t\tif (disposed) return\n\t\thabits_version++\n\t\thabits = items.filter(h => !h.archived).sort((a, b) => (Number(a.order) || 0) - (Number(b.order) || 0))\n\t\thabits_ready = true\n\t\thabits_failed = false\n\t\tload_error = completions_failed\n\t\tif (completions_ready) clearTimeout(load_timeout)\n\t}\n\tfunction receive_completions(items) {\n\t\tif (disposed) return\n\t\tcompletions_version++\n\t\tcompletions = items\n\t\tcompletions_ready = true\n\t\tcompletions_failed = false\n\t\tload_error = habits_failed\n\t\tif (habits_ready) clearTimeout(load_timeout)\n\t}\n\tconst load_timeout = setTimeout(() => {\n\t\tif (disposed) return\n\t\tif (!habits_ready) habits_failed = true\n\t\tif (!completions_ready) completions_failed = true\n\t\tload_error = habits_failed || completions_failed\n\t}, 12000)\n\tfunction handle_load_error(collection) {\n\t\tif (disposed) return\n\t\tif (collection === 'habits') habits_failed = true\n\t\telse completions_failed = true\n\t\tload_error = true\n\t\tclearTimeout(load_timeout)\n\t}\n\tconst unsubscribe_habits = data.habits.subscribe(receive_habits, list_params, () => handle_load_error('habits'))\n\tconst unsubscribe_completions = data.completions.subscribe(receive_completions, list_params, () => handle_load_error('completions'))\n\tonDestroy(() => { disposed = true; habits_version++; completions_version++; unsubscribe_habits(); unsubscribe_completions(); clearTimeout(load_timeout) })\n\tasync function retry_load() {\n\t\tif (retrying || disposed) return\n\t\tretrying = true\n\t\tconst versions = [habits_version, completions_version]\n\t\tconst results = await Promise.allSettled([data.habits.list(list_params), data.completions.list(list_params)])\n\t\tif (disposed) return\n\t\tif (versions[0] === habits_version) {\n\t\t\tif (results[0].status === 'fulfilled') receive_habits(results[0].value)\n\t\t\telse handle_load_error('habits')\n\t\t}\n\t\tif (versions[1] === completions_version) {\n\t\t\tif (results[1].status === 'fulfilled') receive_completions(results[1].value)\n\t\t\telse handle_load_error('completions')\n\t\t}\n\t\tretrying = false\n\t}\n\n\tfunction local_midnight() {\n\t\tconst date = new Date()\n\t\tdate.setHours(0, 0, 0, 0)\n\t\treturn date\n\t}\n\tlet today = $state(local_midnight())\n\tonMount(() => {\n\t\tconst interval = setInterval(() => {\n\t\t\tconst date = local_midnight()\n\t\t\tif (date_key(date) !== date_key(today)) today = date\n\t\t}, 60000)\n\t\treturn () => clearInterval(interval)\n\t})\n\tfunction date_key(date) {\n\t\treturn `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`\n\t}\n\tfunction get_dates(view_type) {\n\t\tconst dates = []\n\t\tfor (let i = (view_type === 'week' ? 7 : 30) - 1; i >= 0; i--) {\n\t\t\tconst date = new Date(today)\n\t\t\tdate.setDate(date.getDate() - i)\n\t\t\tdates.push(date)\n\t\t}\n\t\treturn dates\n\t}\n\tlet dates = $derived.by(() => get_dates(view))\n\t$effect(() => {\n\t\tview; dates; grid\n\t\ttick().then(() => { if (grid) grid.scrollLeft = grid.scrollWidth })\n\t})\n\tfunction is_completed(habit_id, date) {\n\t\treturn completions.some(c => c.habit_id === habit_id && c.date === date_key(date))\n\t}\n\tasync function toggle_completion(habit_id, date) {\n\t\tconst key = date_key(date)\n\t\tconst cell = `${habit_id}:${key}`\n\t\tif (pending_cells.includes(cell) || pending_habits.includes(habit_id) || key > date_key(today)) return\n\t\tpending_cells = [...pending_cells, cell]\n\t\terror = ''\n\t\tconst existing = completions.filter(c => c.habit_id === habit_id && c.date === key)\n\t\ttry {\n\t\t\tif (existing.length) {\n\t\t\t\t// Clear every matching record so legacy duplicates cannot leave the day checked.\n\t\t\t\tfor (const completion of existing) await data.completions.delete(completion.id)\n\t\t\t\tcompletions = completions.filter(c => !(c.habit_id === habit_id && c.date === key))\n\t\t\t} else {\n\t\t\t\tconst record = await data.completions.create({habit_id, date: key})\n\t\t\t\tif (!completions.some(c => c.habit_id === habit_id && c.date === key)) completions = [...completions, record]\n\t\t\t}\n\t\t} catch { error = 'Could not update this day. Try again.' }\n\t\tfinally { pending_cells = pending_cells.filter(value => value !== cell) }\n\t}\n\tfunction get_streak(habit_id) {\n\t\tconst keys = new Set(completions.filter(c => c.habit_id === habit_id).map(c => c.date))\n\t\tconst date = new Date(today)\n\t\tif (!keys.has(date_key(date))) date.setDate(date.getDate() - 1)\n\t\tlet streak = 0\n\t\twhile (keys.has(date_key(date))) { streak++; date.setDate(date.getDate() - 1) }\n\t\treturn streak\n\t}\n\tfunction get_completion_rate(habit_id) {\n\t\treturn Math.round(dates.filter(date => is_completed(habit_id, date)).length / dates.length * 100)\n\t}\n\tfunction format_day(date) { return date.toLocaleDateString('en-US', { weekday: 'short' }) }\n\tfunction format_date_short(date) { return date.getDate() }\n\tfunction is_today(date) { return date_key(date) === date_key(today) }\n\tfunction full_date(date) { return date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) }\n\n\tlet new_name = $state('')\n\tlet new_emoji = $state('')\n\tlet show_form = $state(false)\n\tlet adding = $state(false)\n\tasync function add_habit(e) {\n\t\te.preventDefault()\n\t\tif (adding) return\n\t\tif (!new_name.trim()) { error = 'Enter a habit name.'; return }\n\t\tadding = true\n\t\terror = ''\n\t\ttry {\n\t\t\tawait data.habits.create({\n\t\t\t\tname: new_name.trim(), emoji: new_emoji.trim(),\n\t\t\t\torder: Math.max(-1, ...habits.map(habit => Number(habit.order) || 0)) + 1, archived: false\n\t\t\t})\n\t\t\tnew_name = ''; new_emoji = ''; show_form = false\n\t\t} catch { error = 'Could not add the habit. Your changes are still here.' }\n\t\tfinally { adding = false }\n\t}\n\tasync function archive_habit(habit) {\n\t\tif (pending_habits.includes(habit.id) || pending_cells.some(cell => cell.startsWith(`${habit.id}:`))) return\n\t\tpending_habits = [...pending_habits, habit.id]\n\t\terror = ''\n\t\ttry { await data.habits.update(habit.id, { archived: true }); archived_habit = habit }\n\t\tcatch { error = 'Could not archive the habit. Try again.' }\n\t\tfinally { pending_habits = pending_habits.filter(id => id !== habit.id) }\n\t}\n\tasync function undo_archive() {\n\t\tconst habit = archived_habit\n\t\tif (!habit || pending_habits.includes(habit.id)) return\n\t\tpending_habits = [...pending_habits, habit.id]\n\t\terror = ''\n\t\ttry { await data.habits.update(habit.id, { archived: false }); if (archived_habit?.id === habit.id) archived_habit = null }\n\t\tcatch { error = 'Could not restore the habit. Try again.' }\n\t\tfinally { pending_habits = pending_habits.filter(id => id !== habit.id) }\n\t}\n</script>\n\n<div class=\"page\">\n\t<header class=\"header\">\n\t\t<h1>{content.title}</h1>\n\t\t<div class=\"controls\">\n\t\t\t<div class=\"view-toggle\">\n\t\t\t\t<button class:active={view === 'week'} aria-pressed={view === 'week'} onclick={() => view = 'week'}>\n\t\t\t\t\t{content.week_view}\n\t\t\t\t</button>\n\t\t\t\t<button class:active={view === 'month'} aria-pressed={view === 'month'} onclick={() => view = 'month'}>\n\t\t\t\t\t{content.month_view}\n\t\t\t\t</button>\n\t\t\t</div>\n\t\t\t<button class=\"btn-primary\" aria-expanded={show_form} disabled={adding || loading || load_error} onclick={() => { show_form = !show_form; error = '' }}>\n\t\t\t\t<Icon icon={show_form ? 'lucide:x' : 'lucide:plus'} width={16} />\n\t\t\t\t{show_form ? content.cancel : content.add_habit}\n\t\t\t</button>\n\t\t</div>\n\t</header>\n\n\t{#if error}<p class=\"message error\" role=\"alert\">{error}</p>{/if}\n\t{#if archived_habit}<p class=\"message\" role=\"status\">Archived {archived_habit.name}. <button onclick={undo_archive} disabled={pending_habits.includes(archived_habit.id)}>Undo</button></p>{/if}\n\t{#if show_form}\n\t\t<form class=\"add-form\" onsubmit={add_habit}>\n\t\t\t<input\n\t\t\t\ttype=\"text\"\n\t\t\t\tplaceholder={content.habit_placeholder} aria-label=\"Habit name\" maxlength=\"120\" disabled={adding}\n\t\t\t\tbind:value={new_name}\n\t\t\t\trequired\n\t\t\t/>\n\t\t\t<input\n\t\t\t\ttype=\"text\"\n\t\t\t\tplaceholder={content.emoji_placeholder} aria-label=\"Habit emoji (optional)\" disabled={adding}\n\t\t\t\tbind:value={new_emoji}\n\t\t\t\tclass=\"emoji-input\"\n\t\t\t\tmaxlength=\"16\"\n\t\t\t/>\n\t\t\t<button type=\"submit\" class=\"btn-primary\" disabled={adding}>\n\t\t\t\t{adding ? 'Adding…' : content.create_button}\n\t\t\t</button>\n\t\t</form>\n\t{/if}\n\n\t{#if load_error}\n\t\t<div class=\"message error\" role=\"alert\">Could not load habits. <button onclick={retry_load} disabled={retrying}>{retrying ? 'Retrying…' : 'Retry'}</button></div>\n\t{/if}\n\t{#if loading && !load_error}\n\t\t<div class=\"loading\">\n\t\t\t<Icon icon=\"lucide:loader-2\" width={20} class=\"spin\" /> <span>Loading habits…</span>\n\t\t</div>\n\t{:else if habits.length === 0 && !load_error}\n\t\t<div class=\"empty\">\n\t\t\t\t\t\t<p>{content.empty_text}</p>\n\t\t</div>\n\t{:else if habits_ready && completions_ready}\n\t\t<!-- svelte-ignore a11y_no_noninteractive_tabindex (This scroll region is focusable for keyboard scrolling.) -->\n\t\t<div class=\"habits-grid\" bind:this={grid} role=\"region\" aria-label=\"Habit completion history\" tabindex=\"0\">\n\t\t\t<div class=\"grid-content\">\n\t\t\t<div class=\"grid-header\">\n\t\t\t\t<div class=\"habit-info-header\">{content.habit_column}</div>\n\t\t\t\t<div class=\"dates-header\">\n\t\t\t\t\t{#each dates as date (date_key(date))}\n\t\t\t\t\t\t<div class=\"date-header\" class:today={is_today(date)} title={full_date(date)}>\n\t\t\t\t\t\t\t<span class=\"day-letter\">{format_day(date)}</span>\n\t\t\t\t\t\t\t<span class=\"date-num\">{format_date_short(date)}</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t{/each}\n\t\t\t\t</div>\n\t\t\t\t<div class=\"stats-header\">{content.stats_column}</div>\n\t\t\t</div>\n\n\t\t\t{#each habits as habit (habit.id)}\n\t\t\t\t{@const streak = get_streak(habit.id)}\n\t\t\t\t{@const rate = get_completion_rate(habit.id)}\n\t\t\t\t<div class=\"habit-row\">\n\t\t\t\t\t<div class=\"habit-info\">\n\t\t\t\t\t\t<span class=\"emoji\">{habit.emoji || ''}</span>\n\t\t\t\t\t\t<span class=\"name\" title={habit.name}>{habit.name}</span>\n\t\t\t\t\t\t<button class=\"archive-btn\" onclick={() => archive_habit(habit)} title=\"Archive habit\" aria-label={`Archive ${habit.name}`} disabled={pending_habits.includes(habit.id) || pending_cells.some(cell => cell.startsWith(`${habit.id}:`))}>\n\t\t\t\t\t\t\t<Icon icon=\"lucide:archive\" width={14} />\n\t\t\t\t\t\t</button>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"checkboxes\">\n\t\t\t\t\t\t{#each dates as date (date_key(date))}\n\t\t\t\t\t\t\t{@const completed = is_completed(habit.id, date)}\n\t\t\t\t\t\t\t<button \n\t\t\t\t\t\t\t\tclass=\"checkbox\"\n\t\t\t\t\t\t\t\tclass:completed\n\t\t\t\t\t\t\t\tclass:today={is_today(date)}\n\t\t\t\t\t\t\t\taria-label={`${habit.name}, ${full_date(date)}`}\n\t\t\t\t\t\t\t\taria-pressed={completed}\n\t\t\t\t\t\t\t\ttitle={`${habit.name}, ${full_date(date)}`}\n\t\t\t\t\t\t\t\tdisabled={pending_cells.includes(`${habit.id}:${date_key(date)}`) || pending_habits.includes(habit.id)}\n\t\t\t\t\t\t\t\tonclick={() => toggle_completion(habit.id, date)}\n\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t{#if completed}\n\t\t\t\t\t\t\t\t\t<Icon icon=\"lucide:check\" width={14} />\n\t\t\t\t\t\t\t\t{/if}\n\t\t\t\t\t\t\t</button>\n\t\t\t\t\t\t{/each}\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"stats\">\n\t\t\t\t\t\t{#if streak > 0}\n\t\t\t\t\t\t\t<span class=\"streak\" title=\"Current streak\" aria-label={`${streak} day streak`}>\n\t\t\t\t\t\t\t\t{streak}d\n\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t{/if}\n\t\t\t\t\t\t<span class=\"rate\" title={`Completed ${get_dates(view).length} day period`} aria-label={`${rate}% completion over the last ${get_dates(view).length} days`}>{rate}%</span>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t{/each}\n\t\t\t</div>\n\t\t</div>\n\t{/if}\n</div>\n\n<style>\n\t.page {\n\t\tmin-height: 100vh;\n\t\tbackground: var(--bg-color, #f8fafc);\n\t\tpadding: 1.5rem;\n\t\tfont-family: var(--font, system-ui, sans-serif);\n\t}\n\n\t.header {\n\t\tmax-width: 900px;\n\t\tmargin: 0 auto 1.5rem;\n\t\tdisplay: flex;\n\t\tjustify-content: space-between;\n\t\talign-items: center;\n\t\tgap: 1rem;\n\t\tflex-wrap: wrap;\n\t}\n\n\t.header h1 {\n\t\tfont-size: 1.25rem;\n\t\tfont-weight: 600;\n\t\tcolor: var(--heading-color, #0f172a);\n\t\tmargin: 0;\n\t}\n\n\t.controls {\n\t\tdisplay: flex;\n\t\tgap: 0.75rem;\n\t\talign-items: center;\n\t}\n\n\t.view-toggle {\n\t\tdisplay: flex;\n\t\tbackground: var(--card-bg, #ffffff);\n\t\tborder: 1px solid var(--border-color, #e2e8f0);\n\t\tborder-radius: var(--radius, 6px);\n\t\toverflow: hidden;\n\t}\n\n\t.view-toggle button {\n\t\tpadding: 0.5rem 0.875rem;\n\t\tbackground: transparent;\n\t\tborder: none;\n\t\tcolor: var(--text-color, #64748b);\n\t\tfont-size: 0.8125rem;\n\t\tcursor: pointer;\n\t\ttransition: background-color 150ms, color 150ms, border-color 150ms;\n\t}\n\n\t.view-toggle button.active {\n\t\tbackground: var(--bg-color, #fafafa);\n\t\tcolor: var(--heading-color, #202020);\n\t}\n\n\t.btn-primary {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tgap: 0.375rem;\n\t\tpadding: 0.5rem 0.875rem;\n\t\tbackground: var(--accent-color, #3b82f6);\n\t\tcolor: white;\n\t\tborder: none;\n\t\tborder-radius: var(--radius, 6px);\n\t\tfont-size: 0.8125rem;\n\t\tfont-weight: 600;\n\t\tcursor: pointer;\n\t\ttransition: background-color 150ms, color 150ms, border-color 150ms;\n\t}\n\n\t.btn-primary:hover {\n\t\tfilter: brightness(1.1);\n\t}\n\n\t.btn-primary:disabled {\n\t\topacity: 0.7;\n\t\tcursor: not-allowed;\n\t}\n\n\t.add-form {\n\t\tmax-width: 900px;\n\t\tmargin: 0 auto 1.5rem;\n\t\tdisplay: flex;\n\t\tgap: 0.5rem;\n\t\tbackground: var(--card-bg, #ffffff);\n\t\tborder: 1px solid var(--border-color, #e2e8f0);\n\t\tborder-radius: var(--radius, 6px);\n\t\tpadding: 0.75rem;\n\t}\n\n\t.add-form input {\n\t\tflex: 1;\n\t\tpadding: 0.5rem 0.75rem;\n\t\tborder: 1px solid var(--border-color, #e2e8f0);\n\t\tborder-radius: 4px;\n\t\tfont-size: 0.875rem;\n\t\tbackground: var(--bg-color, #f8fafc);\n\t\tcolor: var(--heading-color, #0f172a);\n\t}\n\n\t.add-form input:focus {\n\t\toutline: none;\n\t\tborder-color: var(--accent-color, #3b82f6);\n\t}\n\n\t.emoji-input {\n\t\twidth: 50px;\n\t\tflex: 0 0 50px !important;\n\t\ttext-align: center;\n\t}\n\n\t.loading, .empty {\n\t\tmax-width: 900px;\n\t\tmargin: 4rem auto;\n\t\ttext-align: center;\n\t\tcolor: var(--text-color, #64748b);\n\t}\n\n\t.empty p {\n\t\tmargin-top: 1rem;\n\t}\n\n\t.habits-grid {\n\t\tmax-width: 900px;\n\t\tmargin: 0 auto;\n\t\tbackground: var(--card-bg, #ffffff);\n\t\tborder: 1px solid var(--border-color, #e2e8f0);\n\t\tborder-radius: var(--radius, 6px);\n\t\toverflow-x: auto;\n\t}\n\n\t.grid-header {\n\t\tdisplay: flex;\n\t\tpadding: 0.75rem 1rem;\n\t\tbackground: var(--bg-color, #f8fafc);\n\t\tborder-bottom: 1px solid var(--border-color, #e2e8f0);\n\t\tgap: 0.5rem;\n\t}\n\n\t.habit-info-header {\n\t\twidth: 180px;\n\t\tflex-shrink: 0;\n\t\tfont-size: 0.75rem;\n\t\tfont-weight: 600;\n\t\tcolor: var(--text-color, #64748b);\n\t\ttext-transform: none;\n\t\tletter-spacing: 0;\n\t}\n\n\t.dates-header {\n\t\tdisplay: flex;\n\t\tgap: 4px;\n\t\tflex: 1;\n\t}\n\n\t.date-header {\n\t\twidth: 36px;\n\t\tflex-shrink: 0;\n\t\ttext-align: center;\n\t\tfont-size: 0.6875rem;\n\t\tcolor: var(--text-color, #64748b);\n\t}\n\n\t.date-header.today {\n\t\tcolor: var(--accent-color, #3b82f6);\n\t\tfont-weight: 600;\n\t}\n\n\t.day-letter {\n\t\tdisplay: block;\n\t}\n\n\t.date-num {\n\t\tdisplay: block;\n\t\tfont-weight: 500;\n\t}\n\n\t.stats-header {\n\t\twidth: 80px;\n\t\tflex-shrink: 0;\n\t\tfont-size: 0.75rem;\n\t\tfont-weight: 600;\n\t\tcolor: var(--text-color, #64748b);\n\t\ttext-transform: none;\n\t\tletter-spacing: 0;\n\t\ttext-align: right;\n\t}\n\n\t.habit-row {\n\t\tdisplay: flex;\n\t\tpadding: 0.75rem 1rem;\n\t\tborder-bottom: 1px solid var(--border-color, #e2e8f0);\n\t\tgap: 0.5rem;\n\t\talign-items: center;\n\t}\n\n\t.habit-row:last-child {\n\t\tborder-bottom: none;\n\t}\n\n\t.habit-info {\n\t\twidth: 180px;\n\t\tflex-shrink: 0;\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tgap: 0.5rem;\n\t}\n\n\t.emoji {\n\t\tfont-size: 1.125rem;\n\t}\n\n\t.name {\n\t\tfont-size: 0.875rem;\n\t\tcolor: var(--heading-color, #0f172a);\n\t\tfont-weight: 500;\n\t\tflex: 1;\n\t\twhite-space: nowrap;\n\t\toverflow: hidden;\n\t\ttext-overflow: ellipsis;\n\t}\n\n\t.archive-btn {\n\t\tbackground: none;\n\t\tborder: none;\n\t\tcolor: var(--text-color, #64748b);\n\t\tcursor: pointer;\n\t\tpadding: 0.25rem;\n\t\topacity: 0.6;\n\t\ttransition: opacity 0.2s;\n\t}\n\n\t.habit-row:hover .archive-btn {\n\t\topacity: 0.5;\n\t}\n\n\t.archive-btn:hover {\n\t\topacity: 1 !important;\n\t}\n\n\t.checkboxes {\n\t\tdisplay: flex;\n\t\tgap: 4px;\n\t\tflex: 1;\n\t}\n\n\t.checkbox {\n\t\twidth: 36px;\n\t\tflex-shrink: 0;\n\t\theight: 36px;\n\t\tborder: 1px solid var(--border-color, #e2e8f0);\n\t\tborder-radius: 4px;\n\t\tbackground: 