  "frontend_code": "<script>\n\timport Icon from '@iconify/svelte'\n\timport { onDestroy, tick } from 'svelte'\n\timport content from '$content'\n\timport data from '$data'\n\n\tlet projects = $state([])\n\tlet categories = $state([])\n\tlet loading = $state(true)\n\tlet load_errors = $state({ projects: '', categories: '' })\n\tlet retrying = $state(false)\n\tlet filter = $state('all')\n\tlet view = $state('grid')\n\tlet selected_project = $state(null)\n\tlet project_dialog = $state(null)\n\tlet failed_images = $state([])\n\tlet disposed = false\n\tconst load_revisions = { projects: 0, categories: 0 }\n\tlet opening = 0\n\tlet previous_overflow = null\n\n\tfunction unique_rows(items) {\n\t\treturn [...new Map((Array.isArray(items) ? items : []).filter(item => item && typeof item.id === 'string' && item.id).map(item => [item.id, { ...item }])).values()]\n\t}\n\n\tfunction receive_projects(items) {\n\t\tif (disposed) return\n\t\tload_revisions.projects += 1\n\t\tprojects = unique_rows(items)\n\t\tloading = false\n\t\tload_errors = { ...load_errors, projects: '' }\n\t\tif (selected_project) {\n\t\t\tconst updated = projects.find(project => project.id === selected_project.id)\n\t\t\tif (updated) selected_project = updated\n\t\t\telse close_project()\n\t\t}\n\t}\n\n\tfunction receive_categories(items) {\n\t\tif (disposed) return\n\t\tload_revisions.categories += 1\n\t\tcategories = unique_rows(items)\n\t\tload_errors = { ...load_errors, categories: '' }\n\t\tif (filter !== 'all' && !categories.some(category => category.id === filter)) filter = 'all'\n\t}\n\n\tfunction load_failed(name) {\n\t\tif (disposed) return\n\t\tload_revisions[name] += 1\n\t\tif (name === 'projects') loading = false\n\t\tload_errors = { ...load_errors, [name]: name === 'projects' ? 'Could not load projects.' : 'Could not load project categories.' }\n\t}\n\n\tconst unsubscribe_projects = data.projects.subscribe(receive_projects, { all: true }, () => load_failed('projects'))\n\tconst unsubscribe_categories = data.categories.subscribe(receive_categories, { all: true }, () => load_failed('categories'))\n\n\tasync function retry_load() {\n\t\tif (retrying || disposed) return\n\t\tretrying = true\n\t\tawait Promise.all(['projects', 'categories'].map(async name => {\n\t\t\tconst revision = load_revisions[name]\n\t\t\ttry {\n\t\t\t\tconst rows = await data[name].list({ all: true })\n\t\t\t\tif (!disposed && revision === load_revisions[name]) (name === 'projects' ? receive_projects : receive_categories)(rows)\n\t\t\t} catch { if (!disposed && revision === load_revisions[name]) load_failed(name) }\n\t\t}))\n\t\tif (!disposed) retrying = false\n\t}\n\n\tlet filtered_projects = $derived.by(() => filter === 'all' ? projects : projects.filter(project => project.category_id === filter))\n\tlet featured_projects = $derived.by(() => filter === 'all' ? projects.filter(project => project.featured === true) : [])\n\tlet current_category = $derived.by(() => categories.find(category => category.id === filter))\n\n\tfunction get_category(id) { return categories.find(category => category.id === id) }\n\n\tfunction safe_url(value, allow_relative = false) {\n\t\tif (typeof value !== 'string' || !value.trim()) return ''\n\t\tconst url = value.trim()\n\t\tif (/[\\u0000-\\u001f\\u007f]/.test(url)) return ''\n\t\tif (allow_relative && url.startsWith('/') && !url.startsWith('//') && !url.includes('\\\\')) return url\n\t\ttry {\n\t\t\tconst parsed = new URL(url)\n\t\t\treturn ['http:', 'https:'].includes(parsed.protocol) ? parsed.href : ''\n\t\t} catch { return '' }\n\t}\n\n\tfunction image_key(project) { return `${project.id}:${safe_url(project.image_url, true)}` }\n\tfunction project_image(project) { return failed_images.includes(image_key(project)) ? '' : safe_url(project.image_url, true) }\n\tfunction image_failed(project) { const key = image_key(project); if (!failed_images.includes(key)) failed_images = [...failed_images, key] }\n\tfunction project_title(project) { return String(project.title ?? '').trim() || 'Untitled project' }\n\tfunction initials(project) { return project_title(project).split(/\\s+/).map(word => word[0]).slice(0, 2).join('').toUpperCase() }\n\tfunction restore_scroll() {\n\t\tif (previous_overflow !== null) { document.body.style.overflow = previous_overflow; previous_overflow = null }\n\t}\n\n\tasync function open_project(project) {\n\t\tif (disposed) return\n\t\tselected_project = project\n\t\tconst version = ++opening\n\t\tawait tick()\n\t\tif (disposed || version !== opening || !selected_project || !project_dialog) return\n\t\tif (!project_dialog.open) {\n\t\t\tprevious_overflow = document.body.style.overflow\n\t\t\tproject_dialog.showModal()\n\t\t\tdocument.body.style.overflow = 'hidden'\n\t\t}\n\t}\n\n\tfunction close_project() {\n\t\topening += 1\n\t\tproject_dialog?.close()\n\t\tselected_project = null\n\t\trestore_scroll()\n\t}\n\n\tfunction dialog_closed() {\n\t\tif (project_dialog?.open) return\n\t\tselected_project = null\n\t\trestore_scroll()\n\t}\n\n\tfunction backdrop_click(event) {\n\t\tif (event.target !== project_dialog) return\n\t\tconst rect = project_dialog.getBoundingClientRect()\n\t\tif (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) close_project()\n\t}\n\n\tonDestroy(() => {\n\t\tdisposed = true\n\t\topening += 1\n\t\tunsubscribe_projects?.()\n\t\tunsubscribe_categories?.()\n\t\tproject_dialog?.close()\n\t\trestore_scroll()\n\t})\n</script>\n\n<main>\n\t<header class=\"header\">\n\t\t<div class=\"header-content\">\n\t\t\t<h1>{content.title}</h1>\n\t\t\t{#if content.tagline}<p class=\"tagline\">{content.tagline}</p>{/if}\n\t\t</div>\n\t</header>\n\n\t<div class=\"page-content\">\n\t\t{#if load_errors.projects || load_errors.categories}\n\t\t\t<div class=\"notice\" role=\"alert\">\n\t\t\t\t<span>{load_errors.projects || load_errors.categories}</span>\n\t\t\t\t<button class=\"text-button\" onclick={retry_load} disabled={retrying}>{retrying ? 'Retrying\u2026' : 'Retry'}</button>\n\t\t\t</div>\n\t\t{/if}\n\n\t\t{#if featured_projects.length > 0}\n\t\t\t<section class=\"featured-section\" aria-labelledby=\"featured-title\">\n\t\t\t\t<h2 id=\"featured-title\" class=\"section-title\">{content.featured_label}</h2>\n\t\t\t\t<div class=\"featured-grid\">\n\t\t\t\t\t{#each featured_projects as project (project.id)}\n\t\t\t\t\t\t{@const category = get_category(project.category_id)}\n\t\t\t\t\t\t<button class=\"project-card featured-card\" onclick={() => open_project(project)} aria-haspopup=\"dialog\">\n\t\t\t\t\t\t\t<div class=\"card-image\" class:placeholder={!project_image(project)}>\n\t\t\t\t\t\t\t\t{#if project_image(project)}<img src={project_image(project)} alt=\"\" loading=\"lazy\" onerror={() => image_failed(project)} />{:else}<span class=\"image-placeholder\" aria-hidden=\"true\">{initials(project)}</span>{/if}\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"card-content\">\n\t\t\t\t\t\t\t\t<div class=\"project-meta\"><span>{category?.name || 'Project'}</span>{#if project.year}<span>{project.year}</span>{/if}</div>\n\t\t\t\t\t\t\t\t<h3>{project_title(project)}</h3>\n\t\t\t\t\t\t\t\t{#if project.short_description}<p>{project.short_description}</p>{/if}\n\t\t\t\t\t\t\t\t<span class=\"details-label\">View case study <Icon icon=\"lucide:arrow-up-right\" width={15} /></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</button>\n\t\t\t\t\t{/each}\n\t\t\t\t</div>\n\t\t\t</section>\n\t\t{/if}\n\n\t\t<section class=\"projects-section\" aria-labelledby=\"projects-title\">\n\t\t\t<div class=\"section-header\">\n\t\t\t\t<h2 id=\"projects-title\" class=\"section-title\">{content.all_work_label}<span class=\"count\">{filtered_projects.length}</span></h2>\n\t\t\t\t<div class=\"view-toggle\" aria-label=\"Project layout\">\n\t\t\t\t\t<button class:active={view === 'grid'} onclick={() => view = 'grid'} aria-label=\"Grid view\" aria-pressed={view === 'grid'}><Icon icon=\"lucide:grid-2x2\" width={17} /></button>\n\t\t\t\t\t<button class:active={view === 'list'} onclick={() => view = 'list'} aria-label=\"List view\" aria-pressed={view === 'list'}><Icon icon=\"lucide:list\" width={17} /></button>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"filters\" aria-label=\"Project categories\">\n\t\t\t\t<button class:active={filter === 'all'} aria-pressed={filter === 'all'} onclick={() => filter = 'all'}>All</button>\n\t\t\t\t{#each categories as category (category.id)}<button class:active={filter === category.id} aria-pressed={filter === category.id} onclick={() => filter = category.id}>{category.name || 'Uncategorized'}</button>{/each}\n\t\t\t</div>\n\n\t\t\t{#if loading}\n\t\t\t\t<p class=\"empty\" role=\"status\">Loading projects\u2026</p>\n\t\t\t{:else if filtered_projects.length === 0}\n\t\t\t\t<div class=\"empty\">\n\t\t\t\t\t<p>{filter === 'all' ? content.empty_state : `No projects in ${current_category?.name || 'this category'}.`}</p>\n\t\t\t\t\t{#if filter !== 'all'}<button class=\"text-button\" onclick={() => filter = 'all'}>Show all projects</button>{/if}\n\t\t\t\t</div>\n\t\t\t{:else}\n\t\t\t\t<div class:projects-grid={view === 'grid'} class:projects-list={view === 'list'}>\n\t\t\t\t\t{#each filtered_projects as project (project.id)}\n\t\t\t\t\t\t{@const category = get_category(project.category_id)}\n\t\t\t\t\t\t<button class=\"project-card\" class:list-card={view === 'list'} onclick={() => open_project(project)} aria-haspopup=\"dialog\">\n\t\t\t\t\t\t\t<div class=\"card-image\" class:placeholder={!project_image(project)}>\n\t\t\t\t\t\t\t\t{#if project_image(project)}<img src={project_image(project)} alt=\"\" loading=\"lazy\" onerror={() => image_failed(project)} />{:else}<span class=\"image-placeholder\" aria-hidden=\"true\">{initials(project)}</span>{/if}\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"card-content\">\n\t\t\t\t\t\t\t\t<div class=\"project-meta\"><span>{category?.name || 'Project'}</span>{#if project.year}<span>{project.year}</span>{/if}</div>\n\t\t\t\t\t\t\t\t<h3>{project_title(project)}</h3>\n\t\t\t\t\t\t\t\t{#if project.short_description}<p>{project.short_description}</p>{/if}\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<span class=\"card-arrow\" aria-hidden=\"true\"><Icon icon=\"lucide:arrow-up-right\" width={18} /></span>\n\t\t\t\t\t\t</button>\n\t\t\t\t\t{/each}\n\t\t\t\t</div>\n\t\t\t{/if}\n\t\t</section>\n\t</div>\n</main>\n\n<dialog bind:this={project_dialog} class=\"project-dialog\" aria-labelledby=\"project-title\" onclose={dialog_closed} oncancel={event => { event.preventDefault(); close_project() }} onclick={backdrop_click}>\n\t{#if selected_project}\n\t\t{@const category = get_category(selected_project.category_id)}\n\t\t{@const project_url = safe_url(selected_project.link_url)}\n\t\t<article class=\"project-detail\">\n\t\t\t<div class=\"detail-top\"><span>{category?.name || 'Project'}</span><button class=\"close-button\" onclick={close_project} aria-label=\"Close project\"><Icon icon=\"lucide:x\" width={20} /></button></div>\n\t\t\t{#if project_image(selected_project)}<img class=\"detail-image\" src={project_image(selected_project)} alt=\"\" onerror={() => image_failed(selected_project)} />{/if}\n\t\t\t<div class=\"detail-body\">\n\t\t\t\t<h2 id=\"project-title\">{project_title(selected_project)}</h2>\n\t\t\t\t{#if selected_project.client || selected_project.role || selected_project.year}\n\t\t\t\t\t<dl class=\"detail-meta\">\n\t\t\t\t\t\t{#if selected_project.client}<div><dt>Client</dt><dd>{selected_project.client}</dd></div>{/if}\n\t\t\t\t\t\t{#if selected_project.role}<div><dt>Role</dt><dd>{selected_project.role}</dd></div>{/if}\n\t\t\t\t\t\t{#if selected_project.year}<div><dt>Year</dt><dd>{selected_project.year}</dd></div>{/if}\n\t\t\t\t\t</dl>\n\t\t\t\t{/if}\n\t\t\t\t{#each [['Overview', selected_project.description], ['Challenge', selected_project.challenge], ['Solution', selected_project.solution], ['Results', selected_project.results]] as [title, body] (title)}\n\t\t\t\t\t{#if body}<section class=\"detail-section\"><h3>{title}</h3><p>{body}</p></section>{/if}\n\t\t\t\t{/each}\n\t\t\t\t{#if project_url}<a class=\"project-link\" href={project_url} target=\"_blank\" rel=\"noopener noreferrer\">{content.view_project_button}<Icon icon=\"lucide:arrow-up-right\" width={17} /></a>{/if}\n\t\t\t</div>\n\t\t</article>\n\t{/if}\n</dialog>\n\n<style>\n\t:global(*) { box-sizing: border-box; }\n\t:global(body) { margin: 0; background: var(--page-background, #fafafa); color: var(--body-text, #202020); font: 15px/1.55 var(--font-family, system-ui, sans-serif); }\n\t:global(button), :global(a) { -webkit-tap-highlight-color: transparent; }\n\tbutton { font: inherit; cursor: pointer; }\n\tbutton:disabled { cursor: wait; opacity: .65; }\n\t:global(button:focus-visible), :global(a:focus-visible) { outline: 2px solid var(--accent-color, #2563eb); outline-offset: 3px; }\n\t.header { background: var(--header-background, #181818); color: #fff; padding: 2.5rem 1.5rem; }\n\t.header-content, .page-content { width: 100%; max-width: 1040px; margin: 0 auto; }\n\th1 { font-size: clamp(1.6rem, 4vw, 2rem); font-weight: 600; letter-spacing: -.025em; margin: 0; overflow-wrap: anywhere; }\n\t.tagline { margin: .5rem 0 0; max-width: 40rem; color: #d0d0d0; font-size: .95rem; overflow-wrap: anywhere; }\n\t.page-content { padding: 1.75rem 1.5rem 3rem; }\n\t.featured-section { margin-bottom: 2.25rem; }\n\t.section-title { display: flex; align-items: center; gap: .6rem; margin: 0; color: var(--heading-color, #202020); font-size: 1rem; font-weight: 600; }\n\t.featured-section .section-title { margin-bottom: 1rem; }\n\t.section-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: .8rem; }\n\t.count { color: var(--secondary-text, #737373); font-size: .8rem; font-weight: 400; }\n\t.filters, .view-toggle { display: flex; gap: .35rem; }\n\t.filters { flex-wrap: wrap; margin-bottom: 1rem; }\n\t.filters button, .view-toggle button { display: inline-flex; align-items: center; justify-content: center; min-height: 40px; background: transparent; border: 1px solid transparent; border-radius: 5px; padding: .35rem .65rem; color: var(--secondary-text, #737373); font-size: .8rem; }\n\t.filters button:hover, .view-toggle button:hover { color: var(--heading-color, #202020); background: var(--card-background, #fff); }\n\t.filters button.active, .view-toggle button.active { background: var(--card-background, #fff); border-color: var(--border-color, #e5e5e5); color: var(--heading-color, #202020); }\n\t.view-toggle button { min-width: 40px; padding: .35rem; }\n\t.featured-grid, .projects-grid { display: grid; gap: 1rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }\n\t.projects-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }\n\t.project-card { position: relative; display: block; min-width: 0; padding: 0; text-align: left; border: 1px solid var(--border-color, #e5e5e5); border-radius: var(--card-radius, 6px); background: var(--card-background, #fff); overflow: hidden; color: inherit; }\n\t.project-card:hover { border-color: var(--secondary-text, #737373); }\n\t.card-image { aspect-ratio: 16 / 10; background: var(--page-background, #fafafa); border-bottom: 1px solid var(--border-color, #e5e5e5); }\n\t.card-image.placeholder { width: 100%; aspect-ratio: auto; height: 72px; }\n\t.card-image img { width: 100%; height: 100%; object-fit: cover; display: block; }\n\t.image-placeholder { display: grid; place-items: center; width: 100%; height: 100%; color: var(--secondary-text, #737373); font-size: 1.3rem; font-weight: 500; letter-spacing: .08em; }\n\t.featured-card .image-placeholder { font-size: 1.75rem; }\n\t.card-content { padding: 1rem; min-width: 0; overflow-wrap: anywhere; }\n\t.project-meta { display: flex; justify-content: space-between; gap: .5rem; color: var(--secondary-text, #737373); font-size: .75rem; margin-bottom: .45rem; }\n\t.card-content h3 { font-size: 1rem; font-weight: 600; margin: 0; color: var(--heading-color, #202020); line-height: 1.4; }\n\t.card-content p { font-size: .825rem; margin: .45rem 0 0; color: var(--secondary-text, #737373); }\n\t.details-label { display: flex; align-items: center; gap: .3rem; font-size: .8rem; margin-top: .9rem; }\n\t.card-arrow { display: none; }\n\t.projects-list { display: flex; flex-direction: column; gap: .5rem; }\n\t.list-card { display: flex; align-items: center; gap: 1rem; padding: .75rem; }\n\t.list-card .card-image { width: 88px; height: 70px; flex-shrink: 0; border: 1px solid var(--border-color, #e5e5e5); border-radius: 4px; }\n\t.list-card .card-content { padding: 0; flex: 1; }\n\t.list-card .card-arrow { display: inline-flex; color: var(--secondary-text, #737373); }\n\t.empty { text-align: center; padding: 2.5rem 1rem; color: var(--secondary-text, #737373); border: 1px dashed var(--border-color, #e5e5e5); border-radius: var(--card-radius, 6px); font-size: .875rem; }\n\t.empty p { margin: 0 0 .5rem; }\n\t.notice { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .75rem 1rem; margin-bottom: 1.25rem; background: var(--card-background, #fff); border: 1px solid var(--border-color, #e5e5e5); border-radius: 5px; font-size: .875rem; }\n\t.text-button { background: transparent; border: 0; padding: .35rem; color: var(--primary-color, #1e293b); font-size: .875rem; text-decoration: underline; text-underline-offset: 3px; }\n\t.project-dialog { width: min(740px, calc(100% - 2rem)); max-height: calc(100dvh - 2rem); margin: auto; padding: 0; border: 1px solid var(--border-color, #e5e5e5); border-radius: var(--card-radius, 6px); background: var(--card-background, #fff); color: var(--body-text, #202020); overflow-y: auto; }\n\t.project-dialog::backdrop { background: rgb(0 0 0 / .55); }\n\t.detail-top { position: sticky; top: 0; z-index: 1; display: flex; align-items: center; justify-content: space-between; padding: .6rem .75rem .6rem 1.5rem; border-bottom: 1px solid var(--border-color, #e5e5e5); background: var(--card-background, #fff); color: var(--secondary-text, #737373); font-size: .8rem; }\n\t.close-button { display: grid; place-items: center; width: 38px; height: 38px; border: 0; border-radius: 4px; background: transparent; color: inherit; }\n\t.close-button:hover { background: var(--page-background, #fafafa); color: var(--heading-color, #202020); }\n\t.detail-image { display: block; width: 100%; max-height: 340px; object-fit: cover; }\n\t.detail-body { padding: 1.5rem; overflow-wrap: anywhere; }\n\t.detail-body h2 { margin: 0 0 1.25rem; font-size: 1.6rem; font-weight: 600; letter-spacing: -.025em; color: var(--heading-color, #202020); line-height: 1.3; }\n\t.detail-meta { display: flex; flex-wrap: wrap; gap: 1rem 2rem; margin: 0 0 1.5rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--border-color, #e5e5e5); }\n\t.detail-meta dt { color: var(--secondary-text, #737373); font-size: .75rem; margin-bottom: .2rem; }\n\t.detail-meta dd { margin: 0; font-size: .875rem; }\n\t.detail-section { margin-top: 1.25rem; }\n\t.detail-section h3 { font-size: .9rem; color: var(--heading-color, #202020); font-weight: 600; margin: 0 0 .4rem; }\n\t.detail-section p { font-size: .9rem; margin: 0; white-space: pre-wrap; }\n\t.project-link { display: inline-flex; align-items: center; gap: .4rem; margin-top: 1.5rem; padding: .65rem .9rem; border-radius: 5px; background: var(--primary-color, #1e293b); color: #fff; text-decoration: none; font-size: .875rem; }\n\t@media (max-width: 760px) { .projects-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n\t@media (max-width: 520px) {\n\t\t.header { padding: 1.75rem 1rem; }\n\t\t.page-content { padding: 1.25rem 1rem 2rem; }\n\t\t.featured-grid, .projects-grid { grid-template-columns: minmax(0, 1fr); }\n\t\t.featured-card .card-image { aspect-ratio: 16 / 8; }\n\t\t.projects-grid .card-image { aspect-ratio: 16 / 7; }\n\t\t.filters button, .view-toggle button { min-height: 40px; }\n\t\t.list-card { gap: .7rem; }\n\t\t.list-card .card-image { width: 62px; height: 62px; }\n\t\t.list-card .project-meta { flex-wrap: wrap; }\n\t\t.list-card .card-content p { display: none; }\n\t\t.detail-body { padding: 1.1rem; }\n\t\t.detail-top { padding-left: 1.1rem; }\n\t\t.detail-body h2 { font-size: 1.35rem; }\n\t}\n\t@media (prefers-reduced-motion: reduce) { :global(*), :global(*::before), :global(*::after) { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; } }\n</style>\n",
