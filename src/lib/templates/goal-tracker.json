{
	"id": "goal-tracker",
	"name": "Goals",
	"description": "Track goals, milestones, and deadlines.",
	"preview": "lucide:target",
	"tags": [
		"dashboard",
		"productivity",
		"intermediate"
	],
	"kits": [
		"dash",
		"daily"
	],
	"frontend_code": "<script>\n\timport Icon from '@iconify/svelte'\n\timport { onDestroy } from 'svelte'\n\timport content from '$content'\n\timport data from '$data'\n\n\tconst list_params = { all: true }\n\tlet disposed = false\n\tlet goals = $state([])\n\tlet milestones = $state([])\n\tlet loading = $state(true)\n\tlet load_errors = $state([])\n\tlet retrying = $state(false)\n\tlet error = $state('')\n\tlet saving = $state(false)\n\tlet pending_ids = $state([])\n\tlet loaded = { goals: false, milestones: false }\n\tlet today = $state(new Date())\n\tlet show_form = $state(false)\n\tlet dialog = $state(null)\n\tlet editing_goal = $state(null)\n\tlet expanded_goal = $state(null)\n\tlet form_name = $state('')\n\tlet form_target = $state(100)\n\tlet form_current = $state(0)\n\tlet form_unit = $state('')\n\tlet form_deadline = $state('')\n\tlet form_category = $state('personal')\n\tlet milestone_goal = $state(null)\n\tlet milestone_name = $state('')\n\tlet milestone_target = $state('')\n\n\tfunction receive(name, items) {\n\t\tif (disposed) return\n\t\tif (name === 'goals') goals = items.map(goal => ({ ...goal, name: String(goal.name ?? '').trim() || 'Untitled goal', unit: String(goal.unit ?? '') })).sort((a, b) => (Number(a.order) || 0) - (Number(b.order) || 0))\n\t\telse milestones = items\n\t\tloaded[name] = true\n\t\tload_errors = load_errors.filter(value => value !== name)\n\t\tloading = !load_errors.length && (!loaded.goals || !loaded.milestones)\n\t}\n\tfunction fail_load(name) {\n\t\tif (disposed) return\n\t\tif (!load_errors.includes(name)) load_errors = [...load_errors, name]\n\t\tloading = false\n\t}\n\tconst unsub_goals = data.goals.subscribe(items => receive('goals', items), list_params, () => fail_load('goals'))\n\tconst unsub_milestones = data.milestones.subscribe(items => receive('milestones', items), list_params, () => fail_load('milestones'))\n\tconst clock = setInterval(() => { today = new Date() }, 60000)\n\tonDestroy(() => { disposed = true; unsub_goals?.(); unsub_milestones?.(); clearInterval(clock) })\n\n\tasync function retry_load() {\n\t\tif (retrying || disposed) return\n\t\tretrying = true\n\t\tawait Promise.all(['goals', 'milestones'].map(async name => {\n\t\t\ttry { receive(name, await data[name].list(list_params)) } catch { fail_load(name) }\n\t\t}))\n\t\tif (!disposed) retrying = false\n\t}\n\n\t$effect(() => {\n\t\tif (show_form && dialog && !dialog.open) dialog.showModal()\n\t\telse if (!show_form && dialog?.open) dialog.close()\n\t})\n\n\tconst categories = [\n\t\t{ id: 'personal', name: 'Personal', color: '#2563eb', icon: 'lucide:user' },\n\t\t{ id: 'health', name: 'Health', color: '#15803d', icon: 'lucide:heart' },\n\t\t{ id: 'career', name: 'Career', color: '#7c3aed', icon: 'lucide:briefcase' },\n\t\t{ id: 'finance', name: 'Finance', color: '#b45309', icon: 'lucide:wallet' },\n\t\t{ id: 'learning', name: 'Learning', color: '#0e7490', icon: 'lucide:book-open' }\n\t]\n\tconst status_config = {\n\t\tcomplete: { label: 'Complete', color: 'var(--success-color)', icon: 'lucide:check-circle' },\n\t\ton_track: { label: 'On track', color: 'var(--text-color)', icon: 'lucide:trending-up' },\n\t\tbehind: { label: 'Behind', color: 'var(--warning-color)', icon: 'lucide:alert-triangle' },\n\t\toverdue: { label: 'Overdue', color: 'var(--danger-color)', icon: 'lucide:alert-circle' }\n\t}\n\tfunction get_category(id) { return categories.find(category => category.id === id) || categories[0] }\n\tfunction get_progress(goal) {\n\t\tconst target = Number(goal.target), current = Number(goal.current)\n\t\treturn Number.isFinite(target) && target > 0 && Number.isFinite(current) ? Math.max(0, Math.min(100, current / target * 100)) : 0\n\t}\n\tfunction day_number(value) {\n\t\tif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(value || '')) return null\n\t\tconst [year, month, day] = value.split('-').map(Number)\n\t\tconst date = new Date(0)\n\t\tdate.setUTCFullYear(year, month - 1, day)\n\t\tdate.setUTCHours(0, 0, 0, 0)\n\t\treturn date.getUTCFullYear() === year && date.getUTCMonth() === month - 1 && date.getUTCDate() === day ? date.getTime() / 86400000 : null\n\t}\n\tfunction date_key(date) {\n\t\treturn `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`\n\t}\n\tfunction days_remaining(deadline) {\n\t\tconst day = day_number(deadline)\n\t\treturn day === null ? null : day - day_number(date_key(today))\n\t}\n\tfunction get_status(goal) {\n\t\tconst progress = get_progress(goal)\n\t\tif (progress >= 100) return 'complete'\n\t\tconst remaining = days_remaining(goal.deadline)\n\t\tif (remaining === null) return 'on_track'\n\t\tif (remaining < 0) return 'overdue'\n\t\tconst start = new Date(goal.created_at)\n\t\tif (!Number.isFinite(start.getTime())) return 'on_track'\n\t\tconst start_day = day_number(date_key(start)), deadline_day = day_number(goal.deadline)\n\t\tconst total = deadline_day - start_day + 1\n\t\tconst elapsed = Math.max(0, day_number(date_key(today)) - start_day)\n\t\treturn total > 0 && progress < elapsed / total * 100 - 10 ? 'behind' : 'on_track'\n\t}\n\tfunction format_date(value) {\n\t\tconst day = day_number(value)\n\t\treturn day === null ? '' : new Date(day * 86400000).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })\n\t}\n\tfunction get_goal_milestones(id) { return milestones.filter(item => item.goal_id === id).sort((a, b) => Number(a.target) - Number(b.target)) }\n\tfunction marker_position(goal, milestone) { return get_progress({ target: goal.target, current: milestone.target }) }\n\tlet overall_progress = $derived.by(() => goals.length ? Math.round(goals.reduce((sum, goal) => sum + get_progress(goal), 0) / goals.length) : 0)\n\tlet completed_count = $derived(goals.filter(goal => get_progress(goal) >= 100).length)\n\n\tfunction reset_form() {\n\t\tform_name = ''; form_target = 100; form_current = 0; form_unit = ''; form_deadline = ''; form_category = 'personal'\n\t}\n\tfunction start_add() { if (saving) return; reset_form(); error = ''; editing_goal = null; show_form = true }\n\tfunction start_edit(goal) {\n\t\tif (saving || pending_ids.includes(goal.id)) return\n\t\tform_name = goal.name || ''; form_target = goal.target; form_current = goal.current\n\t\tform_unit = goal.unit || ''; form_deadline = goal.deadline || ''; form_category = get_category(goal.category).id\n\t\terror = ''; editing_goal = goal.id; show_form = true\n\t}\n\tfunction cancel_form() { if (saving) return; show_form = false; editing_goal = null; error = ''; reset_form() }\n\tasync function save_goal(event) {\n\t\tevent?.preventDefault()\n\t\tif (saving) return\n\t\terror = ''\n\t\tconst target = Number(form_target), current = Number(form_current)\n\t\tif (!form_name.trim()) { error = 'Enter a goal name.'; return }\n\t\tif (form_target === '' || !Number.isFinite(target) || target <= 0) { error = 'Enter a target greater than zero.'; return }\n\t\tif (form_current === '' || !Number.isFinite(current) || current < 0) { error = 'Enter a current value of zero or more.'; return }\n\t\tif (form_deadline && day_number(form_deadline) === null) { error = 'Enter a valid deadline.'; return }\n\t\tconst fields = { name: form_name.trim(), target, current, unit: form_unit.trim(), deadline: form_deadline, category: form_category }\n\t\tsaving = true\n\t\ttry {\n\t\t\tif (editing_goal) await data.goals.update(editing_goal, fields)\n\t\t\telse await data.goals.create({ ...fields, order: Math.max(-1, ...goals.map(goal => Number(goal.order) || 0)) + 1, created_at: new Date().toISOString() })\n\t\t\tsaving = false\n\t\t\tcancel_form()\n\t\t} catch { error = 'Could not save the goal. Your changes are still here.' } finally { saving = false }\n\t}\n\tasync function update_progress(goal, delta) {\n\t\tif (pending_ids.includes(goal.id) || !Number.isFinite(delta)) return\n\t\tconst current = goals.find(item => item.id === goal.id) || goal\n\t\tconst value = Math.max(0, (Number(current.current) || 0) + delta)\n\t\tif (!Number.isFinite(value)) return\n\t\tpending_ids = [...pending_ids, goal.id]; error = ''\n\t\ttry { await data.goals.update(goal.id, { current: value }) }\n\t\tcatch { error = 'Could not update progress. Try again.' }\n\t\tfinally { pending_ids = pending_ids.filter(id => id !== goal.id) }\n\t}\n\tasync function delete_goal(id) {\n\t\tif (!loaded.milestones || load_errors.includes('milestones')) { error = 'Load milestones before deleting this goal.'; return }\n\t\tif (pending_ids.includes(id) || !confirm('Delete this goal and its milestones?')) return\n\t\tpending_ids = [...pending_ids, id]; error = ''\n\t\ttry {\n\t\t\tfor (const milestone of get_goal_milestones(id)) await data.milestones.delete(milestone.id)\n\t\t\tawait data.goals.delete(id)\n\t\t\tif (expanded_goal === id) expanded_goal = null\n\t\t\tif (milestone_goal === id) milestone_goal = null\n\t\t} catch { error = 'Could not finish deleting the goal. Try again.' }\n\t\tfinally { pending_ids = pending_ids.filter(value => value !== id) }\n\t}\n\tfunction start_milestone(id) { milestone_goal = id; milestone_name = ''; milestone_target = ''; error = '' }\n\tasync function save_milestone(event, goal) {\n\t\tevent?.preventDefault()\n\t\tif (pending_ids.includes(goal.id)) return\n\t\tconst target = Number(milestone_target)\n\t\terror = ''\n\t\tif (!milestone_name.trim()) { error = 'Enter a milestone name.'; return }\n\t\tconst goal_target = Number(goal.target)\n\t\tif (milestone_target === '' || !Number.isFinite(target) || target <= 0 || !Number.isFinite(goal_target) || goal_target <= 0 || target > goal_target) { error = 'Enter a milestone target between zero and the goal target.'; return }\n\t\tpending_ids = [...pending_ids, goal.id]\n\t\ttry {\n\t\t\tawait data.milestones.create({ goal_id: goal.id, name: milestone_name.trim(), target, completed: Number(goal.current) >= target })\n\t\t\tif (milestone_goal === goal.id && Number(milestone_target) === target) milestone_goal = null\n\t\t} catch { error = 'Could not save the milestone. Your changes are still here.' }\n\t\tfinally { pending_ids = pending_ids.filter(id => id !== goal.id) }\n\t}\n\tasync function delete_milestone(milestone) {\n\t\tif (pending_ids.includes(milestone.goal_id)) return\n\t\tpending_ids = [...pending_ids, milestone.goal_id]; error = ''\n\t\ttry { await data.milestones.delete(milestone.id) }\n\t\tcatch { error = 'Could not remove the milestone. Try again.' }\n\t\tfinally { pending_ids = pending_ids.filter(id => id !== milestone.goal_id) }\n\t}\n</script>\n\n<div class=\"page\">\n\t<header class=\"header\">\n\t\t<div>\n\t\t\t<h1>{content.title}</h1>\n\t\t\t<div class=\"summary\"><span><strong>{completed_count}</strong> / {goals.length} {content.goals_completed}</span><span><strong>{overall_progress}%</strong> {content.overall_progress}</span></div>\n\t\t</div>\n\t\t<button class=\"primary\" onclick={start_add} disabled={loading || !!load_errors.length}><Icon icon=\"lucide:plus\" width={17} />{content.add_goal}</button>\n\t</header>\n\t<main>\n\t\t{#if load_errors.length}<div class=\"notice\" role=\"alert\"><span>Could not load {load_errors.join(' and ')}.</span><button onclick={retry_load} disabled={retrying}>{retrying ? 'Retrying…' : 'Retry'}</button></div>{/if}\n\t\t{#if error && !show_form}<p class=\"notice\" role=\"alert\">{error}</p>{/if}\n\t\t{#if loading}<p class=\"empty\" role=\"status\">Loading goals…</p>\n\t\t{:else if !goals.length && !load_errors.length}<div class=\"empty\"><h2>{content.empty_title}</h2><p>{content.empty_text}</p><button class=\"primary\" onclick={start_add}>{content.add_first_goal}</button></div>\n\t\t{:else}\n\t\t\t<div class=\"goals-list\">\n\t\t\t\t{#each goals as goal (goal.id)}\n\t\t\t\t\t{@const progress = get_progress(goal)}\n\t\t\t\t\t{@const status = status_config[get_status(goal)]}\n\t\t\t\t\t{@const category = get_category(goal.category)}\n\t\t\t\t\t{@const days_left = days_remaining(goal.deadline)}\n\t\t\t\t\t{@const goal_milestones = get_goal_milestones(goal.id)}\n\t\t\t\t\t{@const busy = pending_ids.includes(goal.id)}\n\t\t\t\t\t<section class=\"goal-card\" aria-label={goal.name}>\n\t\t\t\t\t\t<button class=\"goal-header\" aria-expanded={expanded_goal === goal.id} aria-controls={`goal-${goal.id}`} onclick={() => expanded_goal = expanded_goal === goal.id ? null : goal.id}>\n\t\t\t\t\t\t\t<span class=\"goal-icon\" style:color={category.color}><Icon icon={category.icon} width={20} /></span>\n\t\t\t\t\t\t\t<span class=\"goal-info\"><strong>{goal.name}</strong><span class=\"category\">{category.name}</span></span>\n\t\t\t\t\t\t\t<span class=\"goal-status\" style:color={status.color}><Icon icon={status.icon} width={15} /><span>{status.label}</span></span>\n\t\t\t\t\t\t\t<Icon icon={expanded_goal === goal.id ? 'lucide:chevron-up' : 'lucide:chevron-down'} width={16} />\n\t\t\t\t\t\t</button>\n\t\t\t\t\t\t<div class=\"progress-section\">\n\t\t\t\t\t\t\t<div class=\"progress-bar\" role=\"progressbar\" aria-label={`${goal.name} progress`} aria-valuemin={0} aria-valuemax={100} aria-valuenow={Math.round(progress)}>\n\t\t\t\t\t\t\t\t<div class=\"progress-fill\" style:width={`${progress}%`} style:background={category.color}></div>\n\t\t\t\t\t\t\t\t{#each goal_milestones as milestone (milestone.id)}<div class=\"milestone-marker\" class:reached={Number(goal.current) >= Number(milestone.target)} style:left={`${marker_position(goal, milestone)}%`} title={`${milestone.name}: ${milestone.target} ${goal.unit || ''}`}></div>{/each}\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"progress-details\"><span><strong>{goal.current}</strong> / {goal.target} {goal.unit || ''}</span><strong>{Math.round(progress)}%</strong></div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div id={`goal-${goal.id}`} hidden={expanded_goal !== goal.id} class=\"goal-expanded\">\n\t\t\t\t\t\t\t<div class=\"quick-update\"><span>{content.quick_update}</span><div class=\"update-buttons\">{#each [-1, 1, 5, 10] as delta}<button disabled={busy || (delta < 0 && Number(goal.current) <= 0)} aria-label={`${delta > 0 ? 'Increase' : 'Decrease'} ${goal.name} by ${Math.abs(delta)}`} onclick={() => update_progress(goal, delta)}>{delta > 0 ? '+' : ''}{delta}</button>{/each}</div></div>\n\t\t\t\t\t\t\t{#if days_left !== null}<p class=\"deadline\"><Icon icon=\"lucide:calendar\" width={15} /><span>{days_left > 0 ? `${days_left} ${content.days_remaining}` : days_left === 0 ? content.due_today : `${Math.abs(days_left)} ${content.days_overdue}`} · {format_date(goal.deadline)}</span></p>{/if}\n\t\t\t\t\t\t\t<div class=\"milestones\"><div class=\"section-heading\"><h2>{content.milestones}</h2><button class=\"text-button\" disabled={busy} onclick={() => start_milestone(goal.id)}>Add milestone</button></div>\n\t\t\t\t\t\t\t\t{#each goal_milestones as milestone (milestone.id)}<div class=\"milestone-item\" class:reached={Number(goal.current) >= Number(milestone.target)}><Icon icon={Number(goal.current) >= Number(milestone.target) ? 'lucide:check-circle' : 'lucide:circle'} width={16} /><span class=\"milestone-name\">{milestone.name}</span><span>{milestone.target} {goal.unit || ''}</span><button class=\"icon-button\" aria-label={`Remove milestone ${milestone.name}`} disabled={busy} onclick={() => delete_milestone(milestone)}><Icon icon=\"lucide:x\" width={16} /></button></div>{/each}\n\t\t\t\t\t\t\t\t{#if milestone_goal === goal.id}<form class=\"milestone-form\" onsubmit={event => save_milestone(event, goal)}><label>Milestone name<input bind:value={milestone_name} required disabled={busy} /></label><label>Target<input type=\"number\" min=\"0.000001\" step=\"any\" max={goal.target} bind:value={milestone_target} required disabled={busy} /></label><div class=\"form-actions\"><button type=\"button\" disabled={busy} onclick={() => milestone_goal = null}>{content.cancel}</button><button class=\"primary\" disabled={busy}>{busy ? 'Saving…' : 'Add milestone'}</button></div></form>{:else if !goal_milestones.length}<p class=\"muted\">No milestones yet.</p>{/if}\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"goal-actions\"><button disabled={busy} onclick={() => start_edit(goal)}><Icon icon=\"lucide:pencil\" width={14} />{content.edit}</button><button class=\"danger\" disabled={busy || load_errors.includes('milestones')} onclick={() => delete_goal(goal.id)}><Icon icon=\"lucide:trash-2\" width={14} />{content.delete}</button></div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</section>\n\t\t\t\t{/each}\n\t\t\t</div>\n\t\t{/if}\n\t</main>\n</div>\n\n<dialog bind:this={dialog} oncancel={event => { if (saving) event.preventDefault(); else cancel_form() }} onclose={cancel_form} onclick={event => { if (event.target === dialog) cancel_form() }} aria-labelledby=\"goal-form-title\">\n\t<form onsubmit={save_goal}>\n\t\t<h2 id=\"goal-form-title\">{editing_goal ? content.edit_goal : content.new_goal}</h2>\n\t\t{#if error}<p class=\"notice\" role=\"alert\">{error}</p>{/if}\n\t\t<fieldset disabled={saving}>\n\t\t\t<label for=\"goal-name\">{content.goal_name}<input id=\"goal-name\" bind:value={form_name} placeholder=\"Read 24 books\" required /></label>\n\t\t\t<div class=\"form-row\"><label for=\"goal-target\">{content.target_value}<input id=\"goal-target\" type=\"number\" min=\"0.000001\" step=\"any\" bind:value={form_target} required /></label><label for=\"goal-current\">{content.current_value}<input id=\"goal-current\" type=\"number\" min=\"0\" step=\"any\" bind:value={form_current} required /></label><label for=\"goal-unit\">{content.unit_label}<input id=\"goal-unit\" bind:value={form_unit} placeholder=\"books, miles…\" /></label></div>\n\t\t\t<div class=\"form-row\"><label for=\"goal-deadline\">{content.deadline_label}<input id=\"goal-deadline\" type=\"date\" bind:value={form_deadline} /></label><label for=\"goal-category\">{content.category_label}<select id=\"goal-category\" bind:value={form_category}>{#each categories as category}<option value={category.id}>{category.name}</option>{/each}</select></label></div>\n\t\t</fieldset>\n\t\t<div class=\"form-actions\"><button type=\"button\" onclick={cancel_form} disabled={saving}>{content.cancel}</button><button class=\"primary\" disabled={saving}>{saving ? 'Saving…' : content.save}</button></div>\n\t</form>\n</dialog>\n\n<style>\n\t:global(body) { margin: 0; background: var(--bg-color); }\n\t:global(*) { box-sizing: border-box; }\n\t.page { min-height: 100vh; color: var(--text-color); background: var(--bg-color); font-family: var(--font); font-size: 14px; }\n\tbutton, input, select { font: inherit; }\n\tbutton { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 38px; padding: 8px 12px; border: 1px solid var(--border-color); border-radius: var(--radius); background: transparent; color: var(--heading-color); cursor: pointer; }\n\tbutton:hover:not(:disabled) { background: color-mix(in srgb, var(--heading-color) 5%, transparent); }\n\tbutton:disabled { opacity: .5; cursor: default; }\n\tbutton.primary { background: var(--accent-color); border-color: var(--accent-color); color: white; }\n\tbutton.primary:hover:not(:disabled) { filter: brightness(1.1); }\n\t.header { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 24px; border-bottom: 1px solid var(--border-color); }\n\t.header > div { min-width: 0; }\n\th1 { overflow-wrap: anywhere; margin: 0; color: var(--heading-color); font-size: 22px; font-weight: 600; letter-spacing: -.4px; }\n\t.summary { display: flex; flex-wrap: wrap; gap: 6px 20px; margin-top: 8px; font-size: 13px; }\n\tstrong { color: var(--heading-color); font-weight: 600; }\n\tmain { max-width: 920px; margin: auto; padding: 24px; }\n\t.notice { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin: 0 0 16px; padding: 12px; border: 1px solid var(--border-color); border-radius: var(--radius); color: var(--heading-color); font-size: 14px; }\n\t.empty { padding: 56px 12px; text-align: center; }\n\t.empty h2 { font-size: 18px; color: var(--heading-color); margin: 0 0 8px; }\n\t.empty p { margin: 0 0 20px; line-height: 1.6; }\n\t.goals-list { display: grid; gap: 12px; }\n\t.goal-card { border: 1px solid var(--border-color); border-radius: var(--radius); background: var(--card-bg); padding: 16px; min-width: 0; }\n\t.goal-header { display: flex; width: 100%; justify-content: initial; gap: 12px; border: 0; padding: 0; text-align: left; }\n\t.goal-header:hover:not(:disabled) { background: transparent; }\n\t.goal-icon { display: flex; align-items: center; flex: 0 0 24px; }\n\t.goal-info { flex: 1; min-width: 0; }\n\t.goal-info strong { display: block; font-size: 15px; overflow-wrap: anywhere; }\n\t.category { display: block; margin-top: 3px; font-size: 12px; color: var(--text-color); }\n\t.goal-status { display: flex; align-items: center; gap: 5px; font-size: 12px; white-space: nowrap; }\n\t.progress-section { margin: 14px 0 0; }\n\t.progress-bar { height: 6px; background: var(--bg-color); position: relative; border-radius: 3px; }\n\t.progress-fill { height: 100%; border-radius: inherit; }\n\t.milestone-marker { position: absolute; width: 3px; height: 10px; top: -2px; background: var(--border-color); transform: translateX(-50%); border-radius: 2px; }\n\t.milestone-marker.reached { background: var(--heading-color); }\n\t.progress-details { display: flex; justify-content: space-between; gap: 12px; margin-top: 9px; font-size: 12px; }\n\t.goal-expanded { margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border-color); }\n\t.goal-expanded[hidden] { display: none; }\n\t.quick-update, .update-buttons, .goal-actions, .deadline, .section-heading, .milestone-item, .form-actions { display: flex; align-items: center; gap: 8px; }\n\t.quick-update { flex-wrap: wrap; justify-content: space-between; }\n\t.update-buttons button { min-width: 42px; padding: 8px; }\n\t.deadline { line-height: 1.5; font-size: 12px; margin: 16px 0; }\n\t.section-heading { justify-content: space-between; margin-top: 16px; gap: 8px; }\n\t.section-heading h2 { margin: 0; font-size: 13px; font-weight: 600; color: var(--heading-color); }\n\t.text-button { border: 0; padding: 6px; font-size: 12px; }\n\t.milestone-item { padding: 5px 0; font-size: 12px; }\n\t.milestone-name { flex: 1; min-width: 0; overflow-wrap: anywhere; }\n\t.milestone-item.reached { color: var(--success-color); }\n\t.icon-button { padding: 6px; min-width: 36px; min-height: 36px; border: 0; }\n\t.muted { font-size: 12px; margin: 8px 0; }\n\t.milestone-form { margin-top: 8px; padding-top: 8px; border-top: 1px solid var(--border-color); display: grid; gap: 12px; grid-template-columns: 2fr 1fr; }\n\t.milestone-form .form-actions { grid-column: 1 / -1; margin: 0; }\n\t.goal-actions { margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--border-color); }\n\t.danger { color: var(--danger-color); margin-left: auto; }\n\tdialog { width: min(540px, calc(100% - 32px)); max-height: calc(100dvh - 32px); border: 1px solid var(--border-color); border-radius: var(--radius); background: var(--card-bg); color: var(--heading-color); font-family: var(--font); padding: 24px; }\n\tdialog::backdrop { background: rgb(0 0 0 / .35); }\n\tdialog h2 { font-size: 18px; margin: 0 0 20px; }\n\tfieldset { border: 0; margin: 0; padding: 0; min-width: 0; display: grid; gap: 16px; }\n\tlabel { display: flex; flex-direction: column; gap: 7px; font-size: 13px; color: var(--heading-color); min-width: 0; }\n\tinput, select { min-width: 0; width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: var(--radius); color: var(--heading-color); background: var(--bg-color); }\n\t.form-row { display: flex; gap: 12px; }\n\t.form-row label { flex: 1; }\n\t.form-actions { justify-content: flex-end; margin-top: 24px; }\n\t:global(button:focus-visible), :global(input:focus-visible), :global(select:focus-visible) { outline: 2px solid var(--accent-color); outline-offset: 3px; }\n\t@media (max-width: 600px) {\n\t\t.header { padding: 18px 16px; align-items: flex-start; }\n\t\t.header > button { flex-shrink: 0; }\n\t\t.summary { flex-direction: column; font-size: 12px; }\n\t\tmain { padding: 16px; }\n\t\t.goal-card { padding: 14px; }\n\t\t.goal-header { gap: 8px; }\n\t\t.goal-status { font-size: 11px; }\n\t\t.goal-status :global(svg) { display: none; }\n\t\t.goal-icon { flex-basis: 20px; }\n\t\tdialog { padding: 20px; }\n\t\t.form-row { flex-wrap: wrap; }\n\t\t.form-row label { flex-basis: calc(50% - 12px); }\n\t\tinput, select { font-size: 16px; }\n\t}\n\t@media (prefers-reduced-motion: reduce) { :global(*), :global(*::before), :global(*::after) { animation: none !important; transition: none !important; } }\n</style>\n",
