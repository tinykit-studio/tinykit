{
	"id": "recipes",
	"name": "Recipes",
	"description": "Keep recipes, ingredients, and instructions.",
	"preview": "lucide:chef-hat",
	"tags": [
		"personal",
		"intermediate",
		"data"
	],
	"kits": [
		"collections",
		"daily",
		"food"
	],
	"frontend_code": "<script>\n  import Icon from '@iconify/svelte'\n  import { onMount, onDestroy } from 'svelte'\n  import { proxy, asset } from '$tinykit'\n  import content from '$content'\n  import data from '$data'\n\n  const list_params = { all: true }\n  let recipes = $state([])\n  let loading = $state(true)\n  let load_error = $state('')\n  let retrying_load = $state(false)\n  let action_error = $state('')\n  let selected_id = $state(null)\n  let search = $state('')\n  let filter_category = $state('')\n  let view = $state('list')\n  let editing_recipe = $state(null)\n  let saving = $state(false)\n  let deleting = $state(false)\n  let deleting_recipe = $state(null)\n  let confirm_delete = $state(false)\n  let form_error = $state('')\n  let import_error = $state('')\n  let fetch_url = $state('')\n  let is_fetching = $state(false)\n  let disposed = false\n  let mounted = false\n  let active_path = ''\n  let import_generation = 0\n\n  function blank_form() { return { title: '', source_url: '', description: '', image: null, prep_time: '', servings: '', category: '', ingredients: '', instructions: '' } }\n  let form = $state(blank_form())\n\n  function receive_recipes(items) {\n    if (disposed) return\n    recipes = [...new Map(items.filter(item => item?.id).map(item => [item.id, item])).values()]\n    loading = false\n    load_error = ''\n    if (mounted) parse_hash()\n  }\n  const unsubscribe = data.recipes.subscribe(receive_recipes, list_params, () => {\n    if (disposed) return\n    loading = false\n    load_error = 'Could not load your recipes. Try again.'\n  })\n  async function retry_load() {\n    if (retrying_load || disposed) return\n    retrying_load = true\n    try { receive_recipes(await data.recipes.list(list_params)) }\n    catch { if (!disposed) load_error = 'Could not load your recipes. Try again.' }\n    finally { if (!disposed) retrying_load = false }\n  }\n  function invalidate_import() { import_generation += 1; is_fetching = false }\n  function populate_form(recipe) {\n    form = { ...blank_form(), ...Object.fromEntries(['title', 'source_url', 'description', 'prep_time', 'category', 'ingredients', 'instructions'].map(key => [key, String(recipe[key] || '')])), servings: recipe.servings == null ? '' : String(recipe.servings) }\n  }\n  function parse_hash() {\n    const path = window.location.hash.slice(1) || '/'\n    const parts = path.split('/').filter(Boolean)\n    let id = null\n    try { id = parts[1] ? decodeURIComponent(parts[1]) : null } catch {}\n    if (path === active_path && !(view === 'missing' && id && recipes.some(recipe => recipe.id === id))) return\n    if (parts[0] === 'edit' && id && loading) return\n    invalidate_import()\n    action_error = ''; form_error = ''; import_error = ''; fetch_url = ''; confirm_delete = false\n    active_path = path\n    if (parts[0] === 'recipe' && id) {\n      selected_id = id; editing_recipe = null; view = 'detail'\n    } else if (parts[0] === 'new') {\n      selected_id = null; editing_recipe = null; form = blank_form(); view = 'form'\n    } else if (parts[0] === 'edit' && id) {\n      const recipe = recipes.find(item => item.id === id)\n      selected_id = id; editing_recipe = recipe || null\n      if (recipe) { populate_form(recipe); view = 'form' } else view = 'missing'\n    } else {\n      selected_id = null; editing_recipe = null; view = 'list'\n    }\n  }\n  function navigate_to(path) { window.location.hash = path; parse_hash() }\n  onMount(() => {\n    mounted = true\n    const handle_hash = () => parse_hash()\n    window.addEventListener('hashchange', handle_hash)\n    parse_hash()\n    return () => { mounted = false; window.removeEventListener('hashchange', handle_hash) }\n  })\n  onDestroy(() => { disposed = true; mounted = false; invalidate_import(); if (typeof unsubscribe === 'function') unsubscribe() })\n\n  let selected_recipe = $derived.by(() => recipes.find(recipe => recipe.id === selected_id) || (deleting_recipe?.id === selected_id ? deleting_recipe : null))\n  let categories = $derived.by(() => [...new Set(recipes.map(recipe => String(recipe.category || '').trim()).filter(Boolean))].sort())\n  let filtered_recipes = $derived.by(() => {\n    const query = search.trim().toLocaleLowerCase()\n    return recipes.filter(recipe => (!query || [recipe.title, recipe.ingredients, recipe.description].some(value => String(value || '').toLocaleLowerCase().includes(query))) && (!filter_category || String(recipe.category || '').trim() === filter_category))\n  })\n  function parse_list(value) { return String(value || '').split(/\\r?\\n/).map(line => line.trim()).filter(Boolean) }\n  function http_url(value) {\n    if (!String(value || '').trim()) return ''\n    try { const url = new URL(String(value).trim()); return ['http:', 'https:'].includes(url.protocol) ? url.href : null }\n    catch { return null }\n  }\n  function find_recipe(value) {\n    if (Array.isArray(value)) { for (const item of value) { const recipe = find_recipe(item); if (recipe) return recipe } }\n    else if (value && typeof value === 'object') {\n      const types = Array.isArray(value['@type']) ? value['@type'] : [value['@type']]\n      if (types.includes('Recipe')) return value\n      if (value['@graph']) return find_recipe(value['@graph'])\n    }\n    return null\n  }\n  function yield_servings(value) {\n    const match = String(Array.isArray(value) ? value[0] || '' : value || '').match(/\\d+(?:\\.\\d+)?/)\n    const number = match ? Number(match[0]) : 0\n    return Number.isInteger(number) && number > 0 ? String(number) : ''\n  }\n  function instruction_lines(value, clean) {\n    if (Array.isArray(value)) return value.flatMap(item => instruction_lines(item, clean))\n    if (typeof value === 'string') return [clean(value)]\n    if (value && typeof value === 'object') {\n      if (value.itemListElement) return instruction_lines(value.itemListElement, clean)\n      if (value.text) return [clean(value.text)]\n    }\n    return []\n  }\n  async function fetch_recipe() {\n    if (is_fetching || saving || disposed) return\n    import_error = ''\n    const url = http_url(fetch_url)\n    if (!url) { import_error = 'Enter an http or https recipe URL.'; return }\n    const generation = ++import_generation\n    const previous = { ...form }\n    is_fetching = true\n    try {\n      const response = await proxy(url)\n      if (response.ok === false) throw Error('Import failed')\n      const html = await response.text()\n      if (disposed || generation !== import_generation || http_url(fetch_url) !== url) return\n      const doc = new DOMParser().parseFromString(html, 'text/html')\n      let recipe_data = null\n      for (const script of doc.querySelectorAll('script[type=\"application/ld+json\"]')) {\n        try { recipe_data = find_recipe(JSON.parse(script.textContent)); if (recipe_data) break } catch {}\n      }\n      if (!recipe_data) { import_error = 'No recipe was found on this page. You can enter it below.'; return }\n      const clean = value => {\n        const parsed = new DOMParser().parseFromString(String(value || ''), 'text/html')\n        return (parsed.body.textContent || '').trim()\n      }\n      const time = recipe_data.totalTime || recipe_data.prepTime || ''\n      const imported = {\n        title: clean(recipe_data.name), source_url: url, description: clean(recipe_data.description),\n        ingredients: Array.isArray(recipe_data.recipeIngredient) ? recipe_data.recipeIngredient.map(clean).join('\\n') : '',\n        instructions: instruction_lines(recipe_data.recipeInstructions, clean).filter(Boolean).join('\\n'),\n        prep_time: String(time).replace(/^PT/, '').replace(/(\\d+)H/g, '$1 hr ').replace(/(\\d+)M/g, '$1 min ').replace(/(\\d+)S/g, '$1 sec ').trim(),\n        servings: yield_servings(recipe_data.recipeYield)\n      }\n      // Keep any fields typed while the request was running.\n      form = { ...form, ...Object.fromEntries(Object.entries(imported).filter(([key]) => form[key] === previous[key])) }\n    } catch { if (!disposed && generation === import_generation) import_error = 'Could not import this recipe. Check the URL or enter it below.' }\n    finally { if (!disposed && generation === import_generation) is_fetching = false }\n  }\n  function back_to_list() { if (!saving && !deleting) navigate_to('/') }\n  function view_recipe(id) { navigate_to(`/recipe/${encodeURIComponent(id)}`) }\n  function start_new_recipe() { navigate_to('/new') }\n  function start_edit_recipe() { if (selected_recipe && !deleting) navigate_to(`/edit/${encodeURIComponent(selected_recipe.id)}`) }\n  async function save_recipe(event) {\n    event?.preventDefault()\n    if (saving || disposed) return\n    form_error = ''\n    if (!form.title.trim()) { form_error = 'Enter a recipe title.'; return }\n    const source_url = http_url(form.source_url)\n    if (source_url === null) { form_error = 'Use an http or https source URL.'; return }\n    const raw_servings = String(form.servings ?? '').trim()\n    const servings = raw_servings ? Number(raw_servings) : null\n    if (servings !== null && (!Number.isSafeInteger(servings) || servings < 1)) { form_error = 'Servings must be a whole number greater than zero.'; return }\n    if (form.image && (!form.image.type?.startsWith('image/') || form.image.size > 10 * 1024 * 1024)) { form_error = 'Choose an image smaller than 10 MB.'; return }\n    invalidate_import()\n    saving = true\n    const path = active_path\n    const id = editing_recipe?.id\n    const fields = {\n      title: form.title.trim(), source_url, description: form.description.trim(), prep_time: form.prep_time.trim(),\n      servings, category: form.category.trim(), ingredients: form.ingredients.trim(), instructions: form.instructions.trim()\n    }\n    if (form.image) fields.image = form.image\n    try {\n      if (id) await data.recipes.update(id, fields)\n      else await data.recipes.create(fields)\n      if (!disposed && path === active_path) navigate_to('/')\n    } catch { if (!disposed && path === active_path) form_error = 'Could not save this recipe. Your changes are still here.' }\n    finally { if (!disposed) saving = false }\n  }\n  async function delete_recipe() {\n    if (!selected_recipe || deleting || disposed) return\n    const id = selected_recipe.id\n    deleting_recipe = selected_recipe\n    deleting = true\n    action_error = ''\n    try {\n      await data.recipes.delete(id)\n      if (!disposed && selected_id === id) navigate_to('/')\n    } catch { if (!disposed) action_error = 'Could not delete this recipe. Try again.' }\n    finally { if (!disposed) { deleting = false; deleting_recipe = null } }\n  }\n</script>\n\n<div class=\"page\">\n  {#if load_error}<div class=\"notice\" role=\"alert\"><span>{load_error}</span><button onclick={retry_load} disabled={retrying_load}>{retrying_load ? 'Retrying…' : 'Retry'}</button></div>{/if}\n  {#if action_error}<div class=\"notice\" role=\"alert\"><span>{action_error}</span><button onclick={() => action_error = ''}>Dismiss</button></div>{/if}\n  {#if view === 'form'}\n    <div class=\"form-view\">\n      <button class=\"back-btn\" onclick={back_to_list} disabled={saving}><Icon icon=\"lucide:arrow-left\" width={16} />Cancel</button>\n      <h1>{editing_recipe ? 'Edit recipe' : 'New recipe'}</h1>\n      {#if !editing_recipe}\n        <div class=\"import-section\"><label class=\"sr-only\" for=\"import-url\">Recipe URL to import</label><input id=\"import-url\" type=\"url\" placeholder=\"Recipe URL (optional)\" bind:value={fetch_url} disabled={saving} oninput={invalidate_import} onkeydown={(event) => { if (event.key === 'Enter') { event.preventDefault(); fetch_recipe() } }} /><button onclick={fetch_recipe} disabled={saving || is_fetching || !fetch_url.trim()}>{is_fetching ? 'Importing…' : 'Import'}</button></div>\n        {#if import_error}<p class=\"error-text\" role=\"alert\">{import_error}</p>{/if}\n      {/if}\n      <form onsubmit={save_recipe}>\n        <fieldset disabled={saving}>\n          <label>Title<input required bind:value={form.title} placeholder=\"Recipe name\" /></label>\n          <label>Source URL<input type=\"url\" bind:value={form.source_url} placeholder=\"https://example.com/recipe\" /></label>\n          <label>Description<textarea bind:value={form.description} rows=\"2\" placeholder=\"A short description (optional)\"></textarea></label>\n          <div class=\"form-row\"><label>Category<input bind:value={form.category} placeholder=\"Breakfast, dinner…\" /></label><label>Prep time<input bind:value={form.prep_time} placeholder=\"30 min\" /></label><label>Servings<input type=\"number\" min=\"1\" step=\"1\" bind:value={form.servings} placeholder=\"4\" /></label></div>\n          <label>Photo<input type=\"file\" accept=\"image/*\" onchange={(event) => form.image = event.currentTarget.files?.[0] || null} /></label>\n          {#if editing_recipe?.image && !form.image}<p class=\"hint\">The current photo will be kept.</p>{/if}\n          <label>{content.ingredients_title}<textarea bind:value={form.ingredients} rows=\"6\" placeholder=\"One ingredient per line\"></textarea></label>\n          <label>{content.instructions_title}<textarea bind:value={form.instructions} rows=\"6\" placeholder=\"One step per line\"></textarea></label>\n        </fieldset>\n        {#if form_error}<p class=\"error-text\" role=\"alert\">{form_error}</p>{/if}\n        <div class=\"form-actions\"><button class=\"primary\" disabled={saving}>{saving ? 'Saving…' : editing_recipe ? 'Save changes' : 'Add recipe'}</button><button type=\"button\" onclick={back_to_list} disabled={saving}>Cancel</button></div>\n      </form>\n    </div>\n  {:else if view === 'detail' && selected_recipe}\n    <div class=\"detail\">\n      <div class=\"detail-header\"><button class=\"back-btn\" disabled={deleting} onclick={back_to_list}><Icon icon=\"lucide:arrow-left\" width={16} />{content.back_button}</button><div class=\"detail-actions\"><button onclick={start_edit_recipe} disabled={deleting}><Icon icon=\"lucide:pencil\" width={15} />Edit</button><button class=\"danger\" disabled={deleting} onclick={() => confirm_delete = !confirm_delete}><Icon icon=\"lucide:trash-2\" width={15} />Delete</button></div></div>\n      {#if confirm_delete}<div class=\"delete-confirm\"><span>Delete this recipe?</span><button class=\"danger\" disabled={deleting} onclick={delete_recipe}>{deleting ? 'Deleting…' : 'Delete recipe'}</button><button disabled={deleting} onclick={() => confirm_delete = false}>Cancel</button></div>{/if}\n      {#if selected_recipe.image}<img class=\"hero-image\" src={asset(selected_recipe.image)} alt={selected_recipe.title || 'Recipe photo'} />{/if}\n      <h1>{selected_recipe.title || 'Untitled recipe'}</h1>\n      <div class=\"meta\">{#if selected_recipe.prep_time}<span><Icon icon=\"lucide:clock\" width={15} />{selected_recipe.prep_time}</span>{/if}{#if selected_recipe.servings}<span><Icon icon=\"lucide:users\" width={15} />{selected_recipe.servings} {content.servings_label}</span>{/if}{#if selected_recipe.category}<span>{selected_recipe.category}</span>{/if}{#if http_url(selected_recipe.source_url)}<a href={http_url(selected_recipe.source_url)} target=\"_blank\" rel=\"noopener noreferrer\"><Icon icon=\"lucide:external-link\" width={14} />Original recipe</a>{/if}</div>\n      {#if selected_recipe.description}<p class=\"description\">{selected_recipe.description}</p>{/if}\n      <section><h2>{content.ingredients_title}</h2>{#if parse_list(selected_recipe.ingredients).length}<ul class=\"ingredients\">{#each parse_list(selected_recipe.ingredients) as ingredient, i (i)}<li>{ingredient}</li>{/each}</ul>{:else}<p class=\"hint\">No ingredients added.</p>{/if}</section>\n      <section><h2>{content.instructions_title}</h2>{#if parse_list(selected_recipe.instructions).length}<ol class=\"instructions\">{#each parse_list(selected_recipe.instructions) as step, i (i)}<li>{step}</li>{/each}</ol>{:else}<p class=\"hint\">No instructions added.</p>{/if}</section>\n    </div>\n  {:else if (view === 'missing' || view === 'detail') && !loading && !load_error}\n    <div class=\"empty\"><p>This recipe is no longer available.</p><button onclick={back_to_list}>{content.back_button}</button></div>\n  {:else if view === 'detail' || view === 'missing'}\n    {#if loading}<p class=\"empty\" role=\"status\">Loading recipe…</p>{/if}\n  {:else}\n    <header><div><h1>{content.app_title}</h1><p class=\"hint\">{recipes.length} {recipes.length === 1 ? 'recipe' : 'recipes'}</p></div><button class=\"primary\" onclick={start_new_recipe}><Icon icon=\"lucide:plus\" width={16} />Add recipe</button></header>\n    <label class=\"search-box\"><Icon icon=\"lucide:search\" width={16} /><input type=\"search\" aria-label=\"Search recipes\" bind:value={search} placeholder={content.search_placeholder} /></label>\n    {#if categories.length}\n      <div class=\"categories\" role=\"group\" aria-label=\"Recipe category\"><button class:active={!filter_category} aria-pressed={!filter_category} onclick={() => filter_category = ''}>All</button>{#each categories as category (category)}<button class:active={filter_category === category} aria-pressed={filter_category === category} onclick={() => filter_category = category}>{category}</button>{/each}</div>\n    {/if}\n    {#if loading}<p class=\"empty\" role=\"status\">Loading recipes…</p>\n    {:else if !filtered_recipes.length && !load_error}\n      <div class=\"empty\"><p>{search.trim() || filter_category ? content.no_results : content.empty_state}</p>{#if search.trim() || filter_category}<button onclick={() => { search = ''; filter_category = '' }}>Clear filters</button>{:else}<button onclick={start_new_recipe}>Add recipe</button>{/if}</div>\n    {:else}\n      <div class=\"recipe-list\">{#each filtered_recipes as recipe (recipe.id)}<button class=\"recipe-row\" onclick={() => view_recipe(recipe.id)}><span class=\"recipe-photo\">{#if recipe.image}<img src={asset(recipe.image)} alt=\"\" loading=\"lazy\" />{:else}<Icon icon=\"lucide:utensils\" width={20} />{/if}</span><span class=\"recipe-info\"><strong>{recipe.title || 'Untitled recipe'}</strong>{#if recipe.description}<span class=\"recipe-description\">{recipe.description}</span>{/if}<span class=\"meta\">{#if recipe.prep_time}<span>{recipe.prep_time}</span>{/if}{#if recipe.servings}<span>{recipe.servings} {content.servings_label}</span>{/if}{#if recipe.category}<span>{recipe.category}</span>{/if}</span></span><Icon icon=\"lucide:chevron-right\" width={16} /></button>{/each}</div>\n    {/if}\n  {/if}\n</div>\n\n<style>\n  :global(*) { box-sizing: border-box; }\n  .page { min-height: 100vh; padding: 1.75rem 1.25rem 3rem; background: var(--page-background, #fafafa); color: var(--body-text-color, #404040); font-family: var(--body-font, system-ui, sans-serif); font-size: .875rem; }\n  header, .search-box, .categories, .recipe-list, .notice, .empty { max-width: 860px; margin-left: auto; margin-right: auto; }\n  header, .detail-header, .detail-actions, .form-actions, .import-section, .delete-confirm, .notice { display: flex; align-items: center; gap: .625rem; }\n  header, .detail-header { justify-content: space-between; }\n  header { margin-bottom: 1.25rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border-color, #e5e5e5); background: var(--header-background, #fff); }\n  h1 { min-width: 0; font-size: 1.375rem; font-weight: 650; letter-spacing: -.025em; line-height: 1.3; margin: 0; color: var(--heading-text-color, #202020); overflow-wrap: anywhere; }\n  h2 { margin: 1.75rem 0 .75rem; font-size: .9375rem; font-weight: 600; color: var(--heading-text-color, #202020); }\n  .hint { color: var(--secondary-text-color, #737373); font-size: .8125rem; margin: .375rem 0 0; }\n  button, input, textarea { font: inherit; }\n  button { display: inline-flex; align-items: center; justify-content: center; gap: .375rem; min-height: 36px; padding: .375rem .625rem; background: var(--card-background, #fff); border: 1px solid var(--border-color, #e5e5e5); border-radius: 6px; color: inherit; cursor: pointer; }\n  button:hover:not(:disabled) { border-color: var(--secondary-text-color, #737373); }\n  button:disabled { opacity: .55; cursor: default; }\n  .primary { background: var(--accent-color, #92400e); border-color: transparent; color: #fff; white-space: nowrap; }\n  .primary:hover:not(:disabled) { filter: brightness(.94); border-color: transparent; }\n  input, textarea { width: 100%; min-width: 0; padding: .625rem .75rem; border: 1px solid var(--border-color, #e5e5e5); border-radius: 6px; color: inherit; background: var(--input-background, #fff); }\n  textarea { resize: vertical; line-height: 1.5; }\n  .search-box { display: flex; align-items: center; gap: .625rem; padding: 0 .75rem; border: 1px solid var(--border-color, #e5e5e5); border-radius: 6px; background: var(--input-background, #fff); color: var(--secondary-text-color, #737373); }\n  .search-box input { border: 0; background: none; padding: .625rem 0; }\n  .categories { display: flex; flex-wrap: wrap; gap: .375rem; margin-top: .75rem; margin-bottom: .875rem; }\n  .categories button { font-size: .8125rem; }\n  .categories .active { color: var(--accent-color, #92400e); border-color: var(--accent-color, #92400e); background: var(--cat-badge-bg, #f5f5f5); }\n  .recipe-list { overflow: hidden; margin-top: 1rem; border: 1px solid var(--border-color, #e5e5e5); border-radius: var(--card-radius, 6px); background: var(--card-background, #fff); }\n  .recipe-row { display: flex; width: 100%; padding: 1rem; gap: .875rem; text-align: left; border: none; border-radius: 0; border-bottom: 1px solid var(--border-color, #e5e5e5); }\n  .recipe-row:last-child { border-bottom: none; }\n  .recipe-row:hover:not(:disabled) { background: var(--page-background, #fafafa); border-color: var(--border-color, #e5e5e5); }\n  .recipe-photo { display: flex; align-items: center; justify-content: center; width: 52px; height: 52px; flex: none; border-radius: 4px; background: var(--image-placeholder, #f5f5f5); color: var(--secondary-text-color, #737373); overflow: hidden; }\n  .recipe-photo img { width: 100%; height: 100%; object-fit: cover; }\n  .recipe-info { display: flex; flex: 1; flex-direction: column; min-width: 0; gap: .25rem; }\n  .recipe-info strong { font-size: .9375rem; font-weight: 600; color: var(--heading-text-color, #202020); overflow-wrap: anywhere; }\n  .recipe-description { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: .8125rem; color: var(--secondary-text-color, #737373); line-height: 1.5; }\n  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: .375rem 1rem; color: var(--secondary-text-color, #737373); font-size: .8125rem; }\n  .meta span, .meta a { display: inline-flex; align-items: center; gap: .375rem; }\n  .meta a { color: var(--accent-color, #92400e); text-decoration: none; }\n  .meta a:hover { text-decoration: underline; }\n  .detail, .form-view { max-width: 700px; margin: 0 auto; }\n  .detail-header { margin-bottom: 1.25rem; }\n  .back-btn { background: none; border-color: transparent; padding-left: 0; }\n  .detail h1 { font-size: 1.75rem; margin: 1rem 0 .75rem; }\n  .hero-image { display: block; width: 100%; max-height: 340px; object-fit: cover; border-radius: var(--card-radius, 6px); margin-bottom: 1.25rem; }\n  .description { line-height: 1.65; margin: 1rem 0 0; white-space: pre-wrap; overflow-wrap: anywhere; }\n  .ingredients { padding: 0; margin: 0; list-style: none; }\n  .ingredients li { padding: .625rem 0; border-bottom: 1px solid var(--border-color, #e5e5e5); line-height: 1.5; overflow-wrap: anywhere; }\n  .instructions { margin: 0; padding-left: 1.25rem; }\n  .instructions li { padding: .375rem 0 .625rem .25rem; line-height: 1.65; overflow-wrap: anywhere; }\n  .form-view > .back-btn { margin-bottom: .75rem; }\n  .form-view h1 { margin-bottom: 1.25rem; }\n  .import-section { margin-bottom: 1rem; }\n  .import-section input { flex: 1; }\n  .import-section button { min-height: 40px; }\n  fieldset { min-width: 0; border: 0; margin: 0; padding: 0; }\n  label { display: flex; flex-direction: column; gap: .375rem; margin-bottom: 1rem; font-size: .8125rem; font-weight: 500; }\n  .search-box { flex-direction: row; font-weight: 400; margin-bottom: 0; }\n  .form-row { display: grid; grid-template-columns: 1fr 1fr 100px; gap: .75rem; }\n  .form-actions { margin-top: 1rem; }\n  .notice { justify-content: space-between; flex-wrap: wrap; padding: .625rem .75rem; margin-bottom: 1rem; border: 1px solid #fecaca; border-radius: 6px; color: #991b1b; background: #fff7f7; font-size: .8125rem; }\n  .error-text { color: #b91c1c; font-size: .8125rem; line-height: 1.5; }\n  .danger { color: #b91c1c; }\n  .delete-confirm { flex-wrap: wrap; padding: .75rem; background: var(--card-background, #fff); border: 1px solid var(--border-color, #e5e5e5); border-radius: 6px; margin-bottom: 1rem; font-size: .8125rem; }\n  .empty { text-align: center; padding: 2rem 1rem; color: var(--secondary-text-color, #737373); }\n  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }\n  :global(button:focus-visible), :global(a:focus-visible), :global(input:focus-visible), :global(textarea:focus-visible) { outline: 2px solid var(--accent-color, #92400e); outline-offset: 2px; }\n  @media (max-width: 580px) {\n    .page { padding: 1.25rem .875rem 2rem; }\n    h1 { min-width: 0; font-size: 1.25rem; }\n    header { gap: .75rem; }\n    input, textarea { font-size: 16px; }\n    .recipe-row { padding: .875rem .75rem; gap: .75rem; }\n    .recipe-photo { width: 42px; height: 42px; }\n    .recipe-description { -webkit-line-clamp: 1; }\n    .form-row { grid-template-columns: 1fr 1fr; }\n    .form-row label:first-child { grid-column: 1 / -1; }\n    .detail h1 { font-size: 1.5rem; }\n    .detail-header { gap: .5rem; }\n    .detail-actions { gap: .375rem; }\n    button { min-height: 40px; }\n  }\n  @media (prefers-reduced-motion: reduce) { :global(*) { scroll-behavior: auto !important; } }\n</style>\n",
