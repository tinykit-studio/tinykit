{
  "id": "waitlist",
  "name": "Waitlist",
  "description": "Collect email signups.",
  "preview": "lucide:mail-plus",
  "tags": [
    "launch",
    "marketing",
    "beginner"
  ],
  "kits": [
    "launch",
    "feedback"
  ],
  "frontend_code": "<script>\n  import { onDestroy, tick } from 'svelte'\n  import Icon from '@iconify/svelte'\n  import content from '$content'\n  import data from '$data'\n\n  const list_params = { page: 1, perPage: 100 }\n  let email = $state('')\n  let loading = $state(false)\n  let submitted = $state(false)\n  let error = $state('')\n  let signups = $state([])\n  let loading_signups = $state(true)\n  let retrying_load = $state(false)\n  let load_error = $state('')\n  let email_input = $state(null)\n  let success_heading = $state(null)\n  let disposed = false\n  let load_revision = 0\n\n  function receive_signups(items) {\n    if (disposed) return\n    load_revision += 1\n    signups = [...new Map((Array.isArray(items) ? items : []).filter(item => item && typeof item.id === 'string' && item.id).map(item => [item.id, { ...item }])).values()]\n    loading_signups = false\n    load_error = ''\n  }\n  function failed_load() {\n    if (disposed) return\n    load_revision += 1\n    loading_signups = false\n    load_error = 'Could not load the signup form. Please try again.'\n  }\n  const unsubscribe = data.signups.subscribe(receive_signups, list_params, failed_load)\n  onDestroy(() => { disposed = true; unsubscribe() })\n  let signup_count = $derived.by(() => signups.length)\n\n  async function retry_load() {\n    if (disposed || retrying_load || loading) return\n    retrying_load = true\n    const revision = load_revision\n    try { const rows = await data.signups.list(list_params); if (!disposed && revision === load_revision) receive_signups(rows) }\n    catch { if (!disposed && revision === load_revision) failed_load() }\n    finally { if (!disposed) retrying_load = false }\n  }\n\n  function normalize_email(value) { return String(value || '').trim().toLowerCase() }\n\n  async function handle_submit(event) {\n    event?.preventDefault()\n    if (disposed || loading || loading_signups || load_error) return\n    const value = normalize_email(email)\n    if (value.length > 254 || !/^[^\\s@]+@[^\\s@.]+(?:\\.[^\\s@.]+)+$/.test(value)) {\n      error = content.error_invalid_email\n      return\n    }\n    loading = true\n    error = ''\n    try {\n      if (signups.some(signup => normalize_email(signup.email) === value)) { error = content.error_duplicate; return }\n      if (disposed) return\n      await data.signups.create({ email: value, created_at: new Date().toISOString() }, { unique: ['email'] })\n      if (disposed) return\n      if (normalize_email(email) === value) {\n        submitted = true\n        email = ''\n        await tick()\n        if (!disposed) success_heading?.focus()\n      }\n    } catch (err) {\n      if (!disposed) error = err?.status === 409 ? content.error_duplicate : content.error_generic\n    } finally {\n      if (!disposed) loading = false\n    }\n  }\n\n  async function return_to_signup() {\n    if (disposed) return\n    submitted = false\n    error = ''\n    await tick()\n    if (!disposed) email_input?.focus()\n  }\n  function social_url(value) {\n    const raw = String(value || '').trim()\n    if (/[\\u0000-\\u001f\\u007f]/.test(raw)) return ''\n    try { const url = new URL(raw); return ['https:', 'http:'].includes(url.protocol) ? url.href : '' }\n    catch { return '' }\n  }\n</script>\n\n<main class=\"page\">\n  <section class=\"container\" aria-labelledby=\"waitlist-title\">\n    {#if submitted}\n      <div class=\"success-state\" role=\"status\">\n        <span class=\"success-icon\"><Icon icon=\"lucide:check\" width={22} /></span>\n        <h1 id=\"waitlist-title\" bind:this={success_heading} tabindex=\"-1\">{content.thank_you_title}</h1>\n        <p>{content.thank_you_message}</p>\n        <button type=\"button\" class=\"btn-secondary\" onclick={return_to_signup}>{content.back_button}</button>\n      </div>\n    {:else}\n      {#if content.badge_text}<p class=\"badge\">{content.badge_text}</p>{/if}\n      <h1 id=\"waitlist-title\">{content.headline}</h1>\n      {#if content.subheadline}<p class=\"subhead\">{content.subheadline}</p>{/if}\n      <form class=\"signup-form\" onsubmit={handle_submit} aria-busy={loading}>\n        <label for=\"waitlist-email\">{content.email_label}</label>\n        <div class=\"input-group\">\n          <input id=\"waitlist-email\" bind:this={email_input} type=\"email\" name=\"email\" autocomplete=\"email\" inputmode=\"email\" placeholder={content.email_placeholder} bind:value={email} maxlength=\"254\" required disabled={loading} aria-invalid={Boolean(error)} aria-describedby={error ? 'signup-error' : undefined} oninput={() => error = ''} />\n          <button type=\"submit\" class=\"btn-primary\" disabled={loading || loading_signups || Boolean(load_error)}>{loading ? 'Joining…' : content.button_text}</button>\n        </div>\n        {#if error}<p id=\"signup-error\" class=\"error\" role=\"alert\">{error}</p>{/if}\n      </form>\n      {#if loading_signups}<p class=\"status\" role=\"status\">Loading signup form…</p>{/if}\n      {#if load_error}\n        <div class=\"load-error\" role=\"alert\"><p>{load_error}</p><button type=\"button\" class=\"text-button\" disabled={retrying_load} onclick={retry_load}>{retrying_load ? 'Retrying…' : 'Try again'}</button></div>\n      {:else if !loading_signups && signup_count > 0}\n        <p class=\"count\"><Icon icon=\"lucide:users\" width={16} /><span>{signup_count}{signup_count >= list_params.perPage ? '+' : ''} {signup_count === 1 ? content.count_singular : content.count_plural}</span></p>\n      {/if}\n      {#if social_url(content.twitter_url) || social_url(content.github_url) || social_url(content.discord_url)}\n        <nav class=\"socials\" aria-label=\"Social links\">\n          {#if social_url(content.twitter_url)}<a href={social_url(content.twitter_url)} target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Twitter\"><Icon icon=\"lucide:twitter\" width={20} /></a>{/if}\n          {#if social_url(content.github_url)}<a href={social_url(content.github_url)} target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"GitHub\"><Icon icon=\"lucide:github\" width={20} /></a>{/if}\n          {#if social_url(content.discord_url)}<a href={social_url(content.discord_url)} target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Discord\"><Icon icon=\"simple-icons:discord\" width={20} /></a>{/if}\n        </nav>\n      {/if}\n    {/if}\n  </section>\n</main>\n\n<style>\n  :global(*) { box-sizing: border-box; }\n  .page { min-height: 100vh; min-height: 100dvh; padding: 80px 24px; display: grid; place-items: center; background: var(--bg-color, #111); color: var(--heading-color, #f5f5f5); font-family: var(--font, system-ui, sans-serif); }\n  .container { width: 100%; max-width: 480px; min-width: 0; }\n  .badge { color: var(--text-color, #a3a3a3); margin: 0 0 20px; font-size: .8rem; font-weight: 500; }\n  h1 { margin: 0; font-size: clamp(1.75rem, 5vw, 2.25rem); line-height: 1.2; font-weight: 650; letter-spacing: -.035em; overflow-wrap: anywhere; }\n  h1:focus { outline: none; }\n  .subhead, .success-state p { margin: 16px 0 28px; color: var(--text-color, #a3a3a3); font-size: 1rem; line-height: 1.65; overflow-wrap: anywhere; }\n  .signup-form { margin: 0; }\n  label { display: block; font-size: .8rem; font-weight: 500; margin-bottom: 8px; }\n  .input-group { display: flex; gap: 8px; }\n  input { width: 100%; min-width: 0; flex: 1; padding: 12px; border: 1px solid var(--border-color, #303030); border-radius: var(--radius, 6px); background: var(--input-bg, #181818); color: var(--heading-color, #f5f5f5); font: inherit; font-size: 16px; }\n  input::placeholder { color: var(--text-color, #a3a3a3); }\n  button { min-height: 44px; padding: 10px 16px; border-radius: var(--radius, 6px); font: inherit; font-size: .875rem; font-weight: 500; cursor: pointer; }\n  .btn-primary { flex-shrink: 0; border: 1px solid var(--accent-color, #2563eb); background: var(--accent-color, #2563eb); color: white; }\n  .btn-secondary { border: 1px solid var(--border-color, #303030); background: var(--input-bg, #181818); color: var(--heading-color, #f5f5f5); }\n  button:hover:not(:disabled) { filter: brightness(1.1); }\n  button:disabled { opacity: .55; cursor: default; }\n  .error, .load-error { color: #fca5a5; font-size: .85rem; line-height: 1.5; }\n  .error { margin: 10px 0 0; }\n  .load-error { margin-top: 16px; }\n  .load-error p { margin: 0; }\n  .text-button { background: none; border: 0; color: inherit; padding: 6px 0; text-decoration: underline; text-underline-offset: 3px; }\n  .count, .status { margin: 18px 0 0; color: var(--text-color, #a3a3a3); font-size: .8rem; line-height: 1.5; }\n  .count { display: flex; align-items: center; gap: 7px; }\n  .socials { display: flex; gap: 8px; margin-top: 28px; }\n  .socials a { width: 40px; height: 40px; display: grid; place-items: center; color: var(--text-color, #a3a3a3); border: 1px solid var(--border-color, #303030); border-radius: var(--radius, 6px); }\n  .socials a:hover { color: var(--heading-color, #f5f5f5); }\n  .success-icon { display: inline-grid; place-items: center; width: 38px; height: 38px; border: 1px solid var(--border-color, #303030); border-radius: var(--radius, 6px); color: var(--heading-color, #f5f5f5); margin-bottom: 24px; }\n  :global(button:focus-visible), :global(a:focus-visible), :global(input:focus-visible) { outline: 2px solid var(--accent-color, #2563eb); outline-offset: 3px; }\n  @media (max-width: 480px) { .page { padding: 48px 20px; } .input-group { flex-direction: column; } .btn-primary { width: 100%; min-height: 46px; } }\n  @media (prefers-reduced-motion: reduce) { :global(*), :global(*::before), :global(*::after) { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; } }\n</style>\n",
