{
  "id": "linktree",
  "name": "Links",
  "description": "A page for your links and social profiles.",
  "preview": "lucide:link",
  "tags": [
    "personal",
    "beginner",
    "social"
  ],
  "kits": [
    "personal-site"
  ],
  "frontend_code": "<script>\n\timport { onDestroy } from 'svelte'\n\timport Icon from '@iconify/svelte'\n\timport content from '$content'\n\timport data from '$data'\n\n\tlet links = $state([])\n\tlet loading = $state(true)\n\tlet load_error = $state('')\n\tlet retrying_load = $state(false)\n\tlet failed_avatar_url = $state('')\n\tlet disposed = false\n\tlet load_revision = 0\n\n\tfunction safe_url(value, contact = false) {\n\t\tconst raw = String(value ?? '').trim()\n\t\tif (!raw || /[\\u0000-\\u001f\\u007f]/.test(raw)) return ''\n\t\ttry {\n\t\t\tconst url = new URL(raw)\n\t\t\tif (['https:', 'http:'].includes(url.protocol)) return url.href\n\t\t\tif (contact && ['mailto:', 'tel:'].includes(url.protocol) && url.pathname.trim()) return url.href\n\t\t} catch {}\n\t\treturn ''\n\t}\n\n\tfunction avatar_url(value) {\n\t\tconst raw = String(value ?? '').trim()\n\t\treturn raw.startsWith('/') && !raw.startsWith('//') && !/[\\\\\\u0000-\\u001f\\u007f]/.test(raw) ? raw : safe_url(raw)\n\t}\n\n\tfunction email_link(value) {\n\t\tconst address = String(value ?? '').trim()\n\t\treturn /^[^\\s@?&#]+@[^\\s@?&#]+$/.test(address) ? `mailto:${address}` : ''\n\t}\n\n\tfunction initials(value) {\n\t\treturn String(value ?? '').replace(/^@/, '').trim().split(/\\s+/).filter(Boolean).slice(0, 2).map(part => part[0]).join('').toUpperCase() || 'A'\n\t}\n\n\tfunction receive_links(items) {\n\t\tif (disposed) return\n\t\tload_revision += 1\n\t\tlinks = [...new Map((Array.isArray(items) ? items : []).filter(item => item?.id).map(item => [item.id, { ...item }])).values()]\n\t\tloading = false\n\t\tload_error = ''\n\t}\n\n\tfunction fail_links() {\n\t\tif (disposed) return\n\t\tload_revision += 1\n\t\tloading = false\n\t\tload_error = 'Could not load links. Please try again.'\n\t}\n\n\tconst unsubscribe = data.links.subscribe(receive_links, { all: true }, fail_links)\n\n\tasync function retry_load() {\n\t\tif (retrying_load || disposed) return\n\t\tretrying_load = true\n\t\tconst revision = load_revision\n\t\ttry {\n\t\t\tconst items = await data.links.list({ all: true })\n\t\t\tif (!disposed && revision === load_revision) receive_links(items)\n\t\t} catch {\n\t\t\tif (!disposed && revision === load_revision) fail_links()\n\t\t} finally {\n\t\t\tif (!disposed) retrying_load = false\n\t\t}\n\t}\n\n\tfunction order_value(value) {\n\t\tif (value === null || value === undefined || String(value).trim() === '') return Infinity\n\t\tconst number = Number(value)\n\t\treturn Number.isFinite(number) ? number : Infinity\n\t}\n\n\tlet visible_links = $derived.by(() => links.map(link => {\n\t\tconst href = safe_url(link.url, true)\n\t\tconst url = href ? new URL(href) : null\n\t\treturn { ...link, href, external: url && ['https:', 'http:'].includes(url.protocol), label: String(link.title ?? '').trim() || url?.hostname || url?.pathname || 'Link' }\n\t}).filter(link => link.href).sort((a, b) => order_value(a.order) - order_value(b.order)))\n\n\tlet socials = $derived.by(() => [\n\t\t{ name: 'Twitter', icon: 'lucide:twitter', href: safe_url(content.twitter_url) },\n\t\t{ name: 'GitHub', icon: 'lucide:github', href: safe_url(content.github_url) },\n\t\t{ name: 'Instagram', icon: 'lucide:instagram', href: safe_url(content.instagram_url) },\n\t\t{ name: 'YouTube', icon: 'lucide:youtube', href: safe_url(content.youtube_url) },\n\t\t{ name: 'Email', icon: 'lucide:mail', href: email_link(content.email) }\n\t].filter(social => social.href))\n\n\tonDestroy(() => { disposed = true; unsubscribe() })\n</script>\n\n<main class=\"page\">\n\t<div class=\"container\">\n\t\t<header class=\"profile\">\n\t\t\t{#if avatar_url(content.avatar_url) && failed_avatar_url !== avatar_url(content.avatar_url)}\n\t\t\t\t<img class=\"avatar\" src={avatar_url(content.avatar_url)} alt=\"\" width=\"72\" height=\"72\" onerror={() => failed_avatar_url = avatar_url(content.avatar_url)} />\n\t\t\t{:else}\n\t\t\t\t<span class=\"avatar initials\" aria-hidden=\"true\">{initials(content.display_name)}</span>\n\t\t\t{/if}\n\t\t\t<h1>{content.display_name}</h1>\n\t\t\t{#if content.bio}<p class=\"bio\">{content.bio}</p>{/if}\n\t\t</header>\n\n\t\t<nav class=\"links\" aria-label=\"Links\" aria-busy={loading || retrying_load}>\n\t\t\t{#if load_error}\n\t\t\t\t<div class=\"load-error\" role=\"alert\">\n\t\t\t\t\t<p>{load_error}</p>\n\t\t\t\t\t<button type=\"button\" onclick={retry_load} disabled={retrying_load}>{retrying_load ? 'Retrying…' : 'Retry'}</button>\n\t\t\t\t</div>\n\t\t\t{/if}\n\t\t\t{#if loading && !visible_links.length}\n\t\t\t\t<p class=\"status\" role=\"status\">Loading links…</p>\n\t\t\t{:else if !visible_links.length && !load_error}\n\t\t\t\t<p class=\"status\">No links published yet.</p>\n\t\t\t{:else}\n\t\t\t\t{#each visible_links as link (link.id)}\n\t\t\t\t\t<a href={link.href} target={link.external ? '_blank' : undefined} rel=\"noopener noreferrer\" class=\"link-button\">\n\t\t\t\t\t\t{#if link.icon}<Icon icon={link.icon} width={18} />{/if}\n\t\t\t\t\t\t<span>{link.label}</span>\n\t\t\t\t\t\t<Icon icon={link.external ? 'lucide:arrow-up-right' : 'lucide:arrow-right'} width={16} />\n\t\t\t\t\t</a>\n\t\t\t\t{/each}\n\t\t\t{/if}\n\t\t</nav>\n\n\t\t{#if socials.length}\n\t\t\t<nav class=\"socials\" aria-label=\"Profiles and contact\">\n\t\t\t\t{#each socials as social (social.name)}\n\t\t\t\t\t<a href={social.href} target={social.name === 'Email' ? undefined : '_blank'} rel=\"noopener noreferrer\" aria-label={social.name}>\n\t\t\t\t\t\t<Icon icon={social.icon} width={20} />\n\t\t\t\t\t</a>\n\t\t\t\t{/each}\n\t\t\t</nav>\n\t\t{/if}\n\t</div>\n</main>\n\n<style>\n\t.page, .page :global(*) { box-sizing: border-box; }\n\t.page { min-height: 100vh; padding: 3rem 1.25rem; background: var(--page-background, #fafafa); font-family: var(--body-font, system-ui, sans-serif); overflow-wrap: anywhere; }\n\t.container { width: 100%; max-width: 440px; margin: 0 auto; }\n\t.profile { text-align: center; margin-bottom: 1.75rem; }\n\t.avatar { display: block; width: 72px; height: 72px; border-radius: 50%; object-fit: cover; margin: 0 auto 1rem; border: 1px solid color-mix(in srgb, var(--button-text-color, #202020) 14%, transparent); }\n\t.initials { display: grid; place-items: center; background: var(--button-background, #fff); color: var(--bio-color, #666); font-size: 1.25rem; font-weight: 500; }\n\th1 { color: var(--name-color, #202020); font-size: 1.5rem; font-weight: 650; letter-spacing: -0.035em; margin: 0; line-height: 1.25; }\n\t.bio { color: var(--bio-color, #666); font-size: 0.875rem; margin: 0.625rem auto 0; max-width: 34ch; line-height: 1.6; white-space: pre-line; }\n\t.links { display: flex; flex-direction: column; gap: 0.625rem; }\n\t.link-button { display: flex; align-items: center; gap: 0.75rem; min-height: 52px; padding: 0.875rem 1rem; background: var(--button-background, #fff); color: var(--button-text-color, #202020); border: 1px solid color-mix(in srgb, var(--button-text-color, #202020) 14%, transparent); border-radius: var(--button-radius, 5px); text-decoration: none; font-size: 0.875rem; font-weight: 500; line-height: 1.4; }\n\t.link-button span { flex: 1; min-width: 0; }\n\t.link-button :global(svg) { flex-shrink: 0; }\n\t.link-button:hover { border-color: color-mix(in srgb, var(--button-text-color, #202020) 40%, transparent); background: color-mix(in srgb, var(--button-background, #fff) 96%, var(--button-text-color, #202020)); }\n\t.socials { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.25rem; margin-top: 1.25rem; }\n\t.socials a { display: flex; align-items: center; justify-content: center; width: 44px; min-height: 44px; color: var(--social-icon-color, #666); border-radius: var(--button-radius, 5px); }\n\t.socials a:hover { color: var(--name-color, #202020); background: color-mix(in srgb, var(--social-icon-color, #666) 8%, transparent); }\n\t.status { text-align: center; color: var(--bio-color, #666); font-size: 0.875rem; margin: 0; padding: 1rem 0; }\n\t.load-error { color: #b91c1c; font-size: 0.875rem; padding: 0.25rem 0 0.75rem; }\n\t.load-error p { margin: 0 0 0.625rem; }\n\tbutton { min-height: 40px; padding: 0.5rem 0.875rem; background: var(--button-background, #fff); color: var(--button-text-color, #202020); border: 1px solid color-mix(in srgb, var(--button-text-color, #202020) 20%, transparent); border-radius: var(--button-radius, 5px); font: inherit; font-size: 0.8125rem; cursor: pointer; }\n\tbutton:disabled { opacity: 0.65; cursor: wait; }\n\t:global(button:focus-visible), :global(a:focus-visible) { outline: 2px solid var(--name-color, #202020); outline-offset: 3px; }\n\t@media (max-width: 500px) { .page { padding-top: 2rem; } }\n\t@media (prefers-reduced-motion: reduce) { .page :global(*) { animation: none !important; transition: none !important; } }\n</style>\n",
