{
	"id": "invoice",
	"name": "Invoice",
	"description": "Create and print an itemized invoice.",
	"preview": "lucide:file-text",
	"tags": [
		"finance",
		"business",
		"intermediate",
		"data"
	],
	"kits": [
		"business",
		"freelance"
	],
	"frontend_code": "<script>\n  import { onDestroy } from 'svelte'\n  import content from '$content'\n  import data from '$data'\n\n  function date_key(date = new Date()) {\n    return [date.getFullYear(), String(date.getMonth() + 1).padStart(2, '0'), String(date.getDate()).padStart(2, '0')].join('-')\n  }\n  const list_params = { all: true }\n  let disposed = false\n  let retrying_load = $state(false)\n  let printing = $state(false)\n  const load_failures = new Map()\n  const due = new Date()\n  due.setDate(due.getDate() + 7)\n  let invoice = $state({\n    company_name: '', invoice_number: '', date: date_key(), due_date: date_key(due),\n    from_email: '', from_address: '', to_name: '', to_email: '', to_address: '',\n    currency: '$', tax_rate: 0, notes: ''\n  })\n  let items = $state([])\n  let invoice_loaded = $state(false)\n  let items_loaded = $state(false)\n  let load_error = $state('')\n  let save_error = $state('')\n  let item_error = $state('')\n  let validation_error = $state('')\n  let header_saving = $state(false)\n  let header_dirty = false\n  let adding = $state(false)\n  let deleting = $state([])\n  let dirty_count = $state(0)\n  let invoice_record_id = null\n  let header_pending = null\n  let header_write = null\n  let header_timeout = null\n  const item_drafts = new Map()\n  const item_timers = new Map()\n  const item_writes = new Map()\n\n  function receive_invoice(records) {\n    if (disposed) return\n    load_failures.delete('invoice'); load_error = [...load_failures.values()].join(' ')\n    if (!invoice_loaded || (!header_dirty && !header_saving)) {\n      if (records[0]) {\n        invoice_record_id = records[0].id\n        invoice = { ...invoice, ...Object.fromEntries(Object.keys(invoice).map(key => [key, records[0][key] ?? invoice[key]])) }\n      }\n      invoice_loaded = true\n    }\n  }\n  function receive_items(records) {\n    if (disposed) return\n    load_failures.delete('items'); load_error = [...load_failures.values()].join(' ')\n    items = records.map(record => ({\n      ...record, description: record.description ?? '', quantity: record.quantity ?? 1, price: record.price ?? 0,\n      ...(item_drafts.get(record.id) || {})\n    }))\n    items_loaded = true\n  }\n  function fail_load(name, message) {\n    if (disposed) return\n    load_failures.set(name, message); load_error = [...load_failures.values()].join(' ')\n  }\n  const unsubscribe_invoice = data.invoice.subscribe(receive_invoice, list_params, () => fail_load('invoice', 'Could not load the invoice.'))\n  const unsubscribe_items = data.items.subscribe(receive_items, list_params, () => fail_load('items', 'Could not load invoice items.'))\n\n  async function retry_load() {\n    if (retrying_load || disposed) return\n    retrying_load = true\n    await Promise.all([\n      ['invoice', receive_invoice, 'Could not load the invoice.'],\n      ['items', receive_items, 'Could not load invoice items.']\n    ].map(async ([name, receive, message]) => {\n      try { receive(await data[name].list(list_params)) } catch { fail_load(name, message) }\n    }))\n    if (!disposed) retrying_load = false\n  }\n\n  function minor_units(value) {\n    const raw = String(value ?? '')\n    if (!/^\\d+(?:\\.\\d{1,2})?$/.test(raw)) return null\n    const [whole, fraction = ''] = raw.split('.')\n    const cents = Number(whole) * 100 + Number(fraction.padEnd(2, '0'))\n    return Number.isSafeInteger(cents) ? cents : null\n  }\n  function quantity_units(value) {\n    const raw = String(value ?? '')\n    if (!/^\\d+(?:\\.\\d{1,4})?$/.test(raw)) return null\n    const units = Math.round(Number(raw) * 10000)\n    return Number.isSafeInteger(units) ? units : null\n  }\n  function line_cents(item) {\n    const price = minor_units(item.price), quantity = quantity_units(item.quantity)\n    if (price === null || quantity === null || !Number.isSafeInteger(price * quantity)) return null\n    return Math.round(price * quantity / 10000)\n  }\n  function totals(rows = items, rate = invoice.tax_rate) {\n    const amounts = rows.map(line_cents)\n    const tax_units = quantity_units(rate)\n    if (amounts.some(value => value === null) || tax_units === null || tax_units > 1000000) return null\n    const subtotal = amounts.reduce((sum, value) => sum + value, 0)\n    if (!Number.isSafeInteger(subtotal)) return null\n    const tax = Number((BigInt(subtotal) * BigInt(tax_units) + 500000n) / 1000000n)\n    return Number.isSafeInteger(subtotal + tax) ? { subtotal, tax, total: subtotal + tax } : null\n  }\n  let summary = $derived.by(() => totals())\n  function money(cents) { return cents === null || cents === undefined ? '—' : invoice.currency + (cents / 100).toFixed(2) }\n  function valid_date(value) {\n    if (!value) return true\n    const date = new Date(value + 'T12:00:00')\n    return /^\\d{4}-\\d{2}-\\d{2}$/.test(value) && !Number.isNaN(date.getTime()) && date_key(date) === value\n  }\n  function valid_header() {\n    const rate = invoice.tax_rate\n    const units = quantity_units(rate)\n    if (units === null || units > 1000000) {\n      validation_error = 'Enter a tax rate from 0 to 100, with up to 4 decimal places.'\n      return false\n    }\n    if (!valid_date(invoice.date) || !valid_date(invoice.due_date) || (invoice.date && invoice.due_date && invoice.due_date < invoice.date)) {\n      validation_error = 'Use valid dates, with the due date on or after the invoice date.'\n      return false\n    }\n    validation_error = ''\n    return true\n  }\n  function field_value(event) {\n    const node = event.currentTarget\n    return node.type === 'number' ? (node.value === '' ? undefined : node.valueAsNumber) : node.value\n  }\n  function change_invoice(key, event) {\n    invoice[key] = field_value(event)\n    save_invoice()\n  }\n  function change_item(item, key, event) {\n    item[key] = field_value(event)\n    save_item(item)\n  }\n  function save_invoice() {\n    if (!invoice_loaded) return\n    header_dirty = true\n    dirty_count = item_drafts.size + 1\n    clearTimeout(header_timeout)\n    if (!valid_header()) { header_pending = null; return }\n    header_pending = { ...invoice, tax_rate: Number(invoice.tax_rate) }\n    header_timeout = setTimeout(() => { header_timeout = null; void flush_invoice() }, 450)\n  }\n  async function flush_invoice() {\n    clearTimeout(header_timeout)\n    header_timeout = null\n    if (header_write) return header_write\n    if (!header_pending) return true\n    header_saving = true\n    save_error = ''\n    header_write = (async () => {\n      while (header_pending) {\n        const snapshot = header_pending\n        header_pending = null\n        try {\n          if (invoice_record_id) await data.invoice.update(invoice_record_id, snapshot)\n          else {\n            const created = await data.invoice.create(snapshot)\n            invoice_record_id = created.id\n          }\n        } catch {\n          if (!header_pending) header_pending = snapshot\n          save_error = 'Invoice changes could not be saved. Your edits are still here.'\n          return false\n        }\n      }\n      if (!validation_error) header_dirty = false\n      return true\n    })()\n    try { return await header_write }\n    finally { header_write = null; header_saving = false; dirty_count = item_drafts.size + (header_dirty ? 1 : 0) }\n  }\n  function save_item(item) {\n    item_drafts.set(item.id, { description: item.description, quantity: item.quantity, price: item.price })\n    dirty_count = item_drafts.size + (header_dirty ? 1 : 0)\n    clearTimeout(item_timers.get(item.id))\n    if (line_cents(item) === null) {\n      item_error = 'Use a non-negative price with up to 2 decimal places and a quantity with up to 4.'\n      return\n    }\n    item_error = ''\n    item_timers.set(item.id, setTimeout(() => { item_timers.delete(item.id); void flush_item(item.id) }, 450))\n  }\n  async function flush_item(id) {\n    clearTimeout(item_timers.get(id))\n    item_timers.delete(id)\n    if (item_writes.has(id)) return item_writes.get(id)\n    const write = (async () => {\n      while (item_drafts.has(id)) {\n        const snapshot = item_drafts.get(id)\n        if (line_cents(snapshot) === null) return false\n        try {\n          await data.items.update(id, { ...snapshot, quantity: Number(snapshot.quantity), price: Number(snapshot.price) })\n          if (item_drafts.get(id) === snapshot) item_drafts.delete(id)\n        } catch {\n          item_error = 'Item changes could not be saved. Your edits are still here.'\n          return false\n        }\n      }\n      return true\n    })()\n    item_writes.set(id, write)\n    try { return await write }\n    finally { item_writes.delete(id); dirty_count = item_drafts.size + (header_dirty ? 1 : 0) }\n  }\n  async function retry_saves() {\n    item_error = ''\n    if (!valid_header()) return false\n    const saved = await Promise.all([flush_invoice(), ...Array.from(item_drafts.keys(), flush_item)])\n    if (saved.some(value => !value)) {\n      if (!item_error && Array.from(item_drafts.values()).some(item => line_cents(item) === null)) item_error = 'Correct the highlighted item amounts before saving.'\n      return false\n    }\n    return true\n  }\n  async function add_item() {\n    if (adding || !items_loaded) return\n    adding = true\n    item_error = ''\n    try { await data.items.create({ description: '', quantity: 1, price: 0 }) }\n    catch { item_error = 'Could not add the item. Try again.' }\n    finally { adding = false }\n  }\n  async function remove_item(id) {\n    if (deleting.includes(id)) return\n    deleting = [...deleting, id]\n    clearTimeout(item_timers.get(id))\n    item_timers.delete(id)\n    try {\n      if (item_writes.has(id)) await item_writes.get(id)\n      await data.items.delete(id)\n      item_drafts.delete(id)\n      items = items.filter(item => item.id !== id)\n      item_error = ''\n    } catch { item_error = 'Could not remove the item. Try again.' }\n    finally { deleting = deleting.filter(value => value !== id); dirty_count = item_drafts.size + (header_dirty ? 1 : 0) }\n  }\n  function autogrow_action(node) {\n    const resize = () => { node.style.height = 'auto'; node.style.height = node.scrollHeight + 'px' }\n    resize()\n    node.addEventListener('input', resize)\n    return { update: resize, destroy() { node.removeEventListener('input', resize) } }\n  }\n  async function print_invoice() {\n    if (printing || disposed || !invoice_loaded || !items_loaded || adding || deleting.length) return\n    if (!valid_header() || !summary) {\n      validation_error ||= 'Correct item amounts before printing.'\n      return\n    }\n    printing = true\n    try {\n      save_invoice()\n      if (await retry_saves() && !disposed && valid_header() && totals() && !dirty_count) window.print()\n    } finally { if (!disposed) printing = false }\n  }\n\n  onDestroy(() => {\n    disposed = true\n    unsubscribe_invoice?.()\n    unsubscribe_items?.()\n    clearTimeout(header_timeout)\n    for (const timeout of item_timers.values()) clearTimeout(timeout)\n    item_timers.clear()\n    void flush_invoice()\n    for (const id of item_drafts.keys()) void flush_item(id)\n  })\n</script>\n\n<main>\n  <div class=\"toolbar no-print\">\n    <h1>Invoice</h1>\n    <span class=\"save-status\" role=\"status\">{header_saving ? 'Saving…' : dirty_count ? 'Unsaved changes' : invoice_loaded && items_loaded ? 'All changes saved' : load_error ? 'Not loaded' : 'Loading…'}</span>\n    <button class=\"btn-print\" onclick={print_invoice} disabled={!invoice_loaded || !items_loaded || adding || deleting.length > 0 || printing}>{printing ? 'Preparing…' : content.print_button}</button>\n  </div>\n  {#if load_error}\n    <div class=\"notice no-print\" role=\"alert\">{load_error} <button onclick={retry_load} disabled={retrying_load}>{retrying_load ? 'Retrying…' : 'Retry'}</button></div>\n  {/if}\n  {#if validation_error || save_error || item_error}\n    <div class=\"notice no-print\" role=\"alert\">\n      <span>{validation_error || save_error || item_error}</span>\n      {#if !validation_error && dirty_count}<button onclick={retry_saves} disabled={header_saving}>Retry save</button>{/if}\n    </div>\n  {/if}\n  <fieldset class=\"invoice-container\" disabled={!invoice_loaded || !items_loaded || printing}>\n    <legend class=\"sr-only\">Invoice details</legend>\n    <div class=\"title-section\">\n      <input type=\"text\" class=\"company-input\" bind:value={invoice.company_name} placeholder=\"Company name\" oninput={event => change_invoice('company_name', event)} aria-label=\"Company name\" />\n      <div class=\"invoice-meta\">\n        <label for=\"invoice-number\">{content.invoice_number_label}</label>\n        <input id=\"invoice-number\" type=\"text\" aria-label={content.invoice_number_label || 'Invoice number'} bind:value={invoice.invoice_number} oninput={event => change_invoice('invoice_number', event)} />\n        <label for=\"invoice-date\">{content.date_label}</label>\n        <input id=\"invoice-date\" type=\"date\" bind:value={invoice.date} onchange={event => change_invoice('date', event)} />\n        <label for=\"due-date\">{content.due_date_label}</label>\n        <input id=\"due-date\" type=\"date\" bind:value={invoice.due_date} min={invoice.date || undefined} onchange={event => change_invoice('due_date', event)} />\n        <label for=\"currency\">Currency</label>\n        <select id=\"currency\" bind:value={invoice.currency} onchange={event => change_invoice('currency', event)}>\n          <option value=\"$\">USD ($)</option><option value=\"€\">EUR (€)</option><option value=\"£\">GBP (£)</option>\n          <option value=\"CA$\">CAD (CA$)</option><option value=\"A$\">AUD (A$)</option>\n          {#if !['$', '€', '£', 'CA$', 'A$'].includes(invoice.currency)}<option value={invoice.currency}>{invoice.currency}</option>{/if}\n        </select>\n      </div>\n    </div>\n    <div class=\"contact-grid\">\n      <section>\n        <h2>{content.from_label}</h2>\n        <input type=\"email\" bind:value={invoice.from_email} placeholder=\"Email\" oninput={event => change_invoice('from_email', event)} aria-label=\"From email\" />\n        <textarea bind:value={invoice.from_address} placeholder=\"Address\" rows=\"3\" oninput={event => change_invoice('from_address', event)} use:autogrow_action={invoice.from_address} aria-label=\"From address\"></textarea>\n      </section>\n      <section>\n        <h2>{content.bill_to_label}</h2>\n        <input type=\"text\" bind:value={invoice.to_name} placeholder=\"Client name\" oninput={event => change_invoice('to_name', event)} aria-label=\"Client name\" />\n        <input type=\"email\" bind:value={invoice.to_email} placeholder=\"Email\" oninput={event => change_invoice('to_email', event)} aria-label=\"Client email\" />\n        <textarea bind:value={invoice.to_address} placeholder=\"Address\" rows=\"3\" oninput={event => change_invoice('to_address', event)} use:autogrow_action={invoice.to_address} aria-label=\"Client address\"></textarea>\n      </section>\n    </div>\n    <div class=\"items-table\">\n      <div class=\"table-header\" aria-hidden=\"true\">\n        <span>{content.description_label}</span><span>{content.quantity_label}</span><span>{content.price_label}</span><span>{content.total_label}</span><span></span>\n      </div>\n      {#each items as item, index (item.id)}\n        <div class=\"table-row\" class:invalid={line_cents(item) === null}>\n          <label class=\"col-desc\">\n            <span class=\"mobile-label\">{content.description_label}</span>\n            <input type=\"text\" bind:value={item.description} disabled={deleting.includes(item.id)} placeholder=\"Item description\" oninput={event => change_item(item, 'description', event)} aria-label={'Item ' + (index + 1) + ' description'} />\n          </label>\n          <label class=\"col-qty\">\n            <span class=\"mobile-label\">{content.quantity_label}</span>\n            <input type=\"number\" min=\"0\" step=\"0.0001\" bind:value={item.quantity} disabled={deleting.includes(item.id)} oninput={event => change_item(item, 'quantity', event)} aria-label={'Item ' + (index + 1) + ' quantity'} aria-invalid={quantity_units(item.quantity) === null} />\n          </label>\n          <label class=\"col-price\">\n            <span class=\"mobile-label\">{content.price_label}</span>\n            <input type=\"number\" min=\"0\" step=\"0.01\" bind:value={item.price} disabled={deleting.includes(item.id)} oninput={event => change_item(item, 'price', event)} aria-label={'Item ' + (index + 1) + ' price'} aria-invalid={minor_units(item.price) === null} />\n          </label>\n          <div class=\"col-total\"><span class=\"mobile-label\">{content.total_label}</span>{money(line_cents(item))}</div>\n          <button class=\"remove no-print\" onclick={() => remove_item(item.id)} disabled={deleting.includes(item.id)} aria-label={'Remove item ' + (index + 1)} title=\"Remove item\">×</button>\n        </div>\n      {:else}\n        <p class=\"empty no-print\">{items_loaded ? 'No items yet. Add your first item below.' : load_error ? 'Invoice items could not be loaded.' : 'Loading invoice…'}</p>\n      {/each}\n    </div>\n    <button class=\"add-item no-print\" onclick={add_item} disabled={adding}>{adding ? 'Adding…' : content.add_item_button}</button>\n    <div class=\"invoice-bottom\">\n      <section class=\"notes-section\">\n        <h2>{content.notes_label}</h2>\n        <textarea bind:value={invoice.notes} rows=\"3\" use:autogrow_action={invoice.notes} placeholder=\"Payment terms or notes\" oninput={event => change_invoice('notes', event)} aria-label=\"Notes\"></textarea>\n      </section>\n      <div class=\"summary-section\">\n        <div class=\"summary-row\"><span>{content.subtotal_label}</span><span>{money(summary?.subtotal)}</span></div>\n        <div class=\"summary-row\">\n          <label for=\"tax-rate\">{content.tax_rate_label}</label>\n          <input id=\"tax-rate\" class=\"tax-input\" type=\"number\" bind:value={invoice.tax_rate} min=\"0\" max=\"100\" step=\"0.0001\" oninput={event => change_invoice('tax_rate', event)} />\n        </div>\n        <div class=\"summary-row\"><span>{content.tax_label}</span><span>{money(summary?.tax)}</span></div>\n        <div class=\"summary-row total\"><span>{content.grand_total_label}</span><span>{money(summary?.total)}</span></div>\n      </div>\n    </div>\n  </fieldset>\n</main>\n\n<style>\n  :global(*) { box-sizing: border-box; }\n  :global(body) { margin: 0; font-family: var(--body-font, system-ui, sans-serif); background: var(--page-background, #fafafa); color: var(--body-text-color, #202020); font-size: 14px; }\n  main { max-width: 920px; margin: 0 auto; padding: 24px; }\n  .toolbar { display: flex; align-items: center; gap: 16px; margin-bottom: 20px; }\n  h1 { min-width: 0; overflow-wrap: anywhere; font-size: 21px; line-height: 1.3; margin: 0; font-weight: 600; }\n  .save-status { margin-left: auto; font-size: 12px; color: var(--label-color, #737373); }\n  .invoice-container { min-width: 0; margin: 0; padding: 32px; border: 1px solid var(--border-color, #e5e5e5); border-radius: var(--card-radius, 6px); background: var(--card-background, #fff); }\n  input, textarea, select, button { font: inherit; color: inherit; }\n  input, textarea, select { min-width: 0; width: 100%; padding: 8px; border: 1px solid transparent; border-radius: 4px; background: transparent; }\n  input:hover, textarea:hover, select:hover { background: var(--input-hover-background, #f5f5f5); border-color: var(--border-color, #e5e5e5); }\n  input:focus, textarea:focus, select:focus { outline: 2px solid var(--accent-color, #2563eb); outline-offset: 1px; }\n  textarea { resize: vertical; overflow: hidden; }\n  button { min-height: 36px; padding: 7px 12px; border: 1px solid var(--border-color, #e5e5e5); border-radius: 5px; background: var(--card-background, #fff); cursor: pointer; }\n  button:hover { background: var(--input-hover-background, #f5f5f5); }\n  button:disabled { opacity: .55; cursor: default; }\n  .btn-print { background: var(--button-primary-background, #202020); color: var(--button-primary-text, #fff); border-color: transparent; font-size: 13px; white-space: nowrap; }\n  .btn-print:hover { background: var(--button-primary-hover, #404040); }\n  .title-section { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 24px; align-items: start; margin-bottom: 28px; }\n  .company-input { font-size: 25px; font-weight: 600; }\n  .invoice-meta { display: grid; grid-template-columns: auto 152px; align-items: center; gap: 3px 12px; }\n  .invoice-meta label { color: var(--label-color, #737373); font-size: 12px; }\n  .invoice-meta input, .invoice-meta select { text-align: right; }\n  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-bottom: 30px; }\n  .contact-grid section { min-width: 0; }\n  h2 { font-size: 12px; font-weight: 600; color: var(--label-color, #737373); margin: 0 0 8px; }\n  .table-header, .table-row { display: grid; grid-template-columns: minmax(0, 1fr) 80px 110px 100px 32px; gap: 8px; align-items: center; padding: 8px 0; }\n  .table-header { background: var(--table-header-background, #fafafa); color: var(--label-color, #737373); font-size: 12px; border-bottom: 1px solid var(--border-color, #e5e5e5); }\n  .table-row { border-bottom: 1px solid var(--border-color, #e5e5e5); }\n  .table-row label { min-width: 0; }\n  .col-total { text-align: right; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }\n  .remove { padding: 0; font-size: 22px; width: 32px; border-color: transparent; color: var(--danger-color, #c2413a); }\n  .remove:hover { background: var(--danger-background, #fee2e2); }\n  .invalid { border-color: var(--danger-color, #c2413a); }\n  .mobile-label { display: none; }\n  .empty { padding: 24px 0; color: var(--label-color, #737373); }\n  .add-item { margin-top: 12px; background: var(--button-secondary-background, #f5f5f5); }\n  .add-item:hover { background: var(--button-secondary-hover, #ededed); }\n  .invoice-bottom { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 32px; margin-top: 32px; }\n  .notes-section { min-width: 0; }\n  .summary-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--border-color, #e5e5e5); font-variant-numeric: tabular-nums; }\n  .summary-row.total { font-size: 19px; font-weight: 600; border-bottom: 0; }\n  .tax-input { width: 78px; text-align: right; }\n  .notice { display: flex; align-items: center; justify-content: space-between; gap: 12px; background: var(--card-background, #fff); padding: 12px; border: 1px solid var(--danger-color, #c2413a); border-radius: 5px; margin-bottom: 16px; font-size: 13px; }\n  .notice button { white-space: nowrap; }\n  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }\n  :global(button:focus-visible) { outline: 2px solid var(--accent-color, #2563eb); outline-offset: 2px; }\n  @media (max-width: 640px) {\n    main { padding: 16px; }\n    .toolbar { flex-wrap: wrap; gap: 10px; }\n    .save-status { font-size: 11px; }\n    .btn-print { width: 100%; }\n    .invoice-container { padding: 18px; }\n    .title-section, .contact-grid, .invoice-bottom { grid-template-columns: minmax(0, 1fr); gap: 22px; }\n    .invoice-meta { grid-template-columns: minmax(0, 1fr) minmax(0, 160px); }\n    .company-input { font-size: 23px; }\n    input, textarea, select { font-size: 16px; }\n    .table-header { display: none; }\n    .table-row { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 32px; gap: 8px; padding: 14px 0; }\n    .col-desc { grid-column: 1 / 3; grid-row: 1; }\n    .remove { grid-column: 3; grid-row: 1; }\n    .col-qty { grid-column: 1; grid-row: 2; }\n    .col-price { grid-column: 2 / 4; grid-row: 2; }\n    .col-total { grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: center; }\n    .mobile-label { display: block; font-size: 11px; color: var(--label-color, #737373); padding: 0 8px 3px; }\n    .invoice-bottom { margin-top: 26px; }\n    .notice { align-items: flex-start; flex-direction: column; }\n  }\n  @media print {\n    :global(body) { background: white; color: #111; font-size: 11pt; }\n    main { padding: 0; max-width: 100%; }\n    .no-print { display: none !important; }\n    .invoice-container { border: 0; padding: 0; }\n    input, textarea, select { border: 0 !important; background: transparent !important; padding: 4px 0; outline: 0 !important; appearance: none; }\n    input::placeholder, textarea::placeholder { color: transparent; }\n    .table-header, .table-row { grid-template-columns: minmax(0, 1fr) 70px 90px 90px; }\n    .summary-section, .table-row { break-inside: avoid; }\n  }\n  @media (prefers-reduced-motion: reduce) { :global(*) { transition: none !important; animation: none !important; } }\n</style>\n",
