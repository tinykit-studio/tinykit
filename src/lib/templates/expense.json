{
  "id": "expense",
  "name": "Expenses",
  "description": "Record income and expenses.",
  "preview": "lucide:wallet",
  "tags": [
    "finance",
    "intermediate",
    "data"
  ],
  "kits": [
    "business",
    "freelance"
  ],
  "frontend_code": "<script>\n  import { onDestroy } from 'svelte'\n  import Icon from '@iconify/svelte'\n  import content from '$content'\n  import data from '$data'\n\tconst list_params = { all: true }\n\n  let transactions = $state([])\n  let new_text = $state('')\n  let new_amount = $state('')\n  let loading = $state(true)\n  let load_error = $state('')\n  let retrying = $state(false)\n  let disposed = false\n  let load_version = 0\n  let saving = $state(false)\n  let deleting_id = $state(null)\n  let confirm_delete = $state(null)\n  let form_error = $state('')\n  let history_error = $state('')\n\n  function transaction_date(value) {\n    if (/^\\d{4}-\\d{2}-\\d{2}$/.test(value || '')) {\n      const [year, month, day] = value.split('-').map(Number)\n      if (year < 1) return null\n      const date = new Date(0)\n      date.setFullYear(year, month - 1, day)\n      date.setHours(0, 0, 0, 0)\n      return date.getFullYear() === year && date.getMonth() === month - 1 && date.getDate() === day ? date : null\n    }\n    const date = new Date(value || '')\n    return Number.isFinite(date.getTime()) ? date : null\n  }\n  function date_value(value) { return transaction_date(value)?.getTime() ?? null }\n\n  function sort_transactions(items) {\n    return [...items].sort((a, b) => (date_value(b.created) ?? -Infinity) - (date_value(a.created) ?? -Infinity))\n  }\n\n  function receive_items(items) {\n    if (disposed) return\n    load_version++\n    transactions = sort_transactions(items)\n    loading = false\n    load_error = ''\n  }\n\n  function load_failed() {\n    if (disposed) return\n    loading = false\n    load_error = 'Transactions could not be loaded.'\n  }\n\n  const unsubscribe = data.transactions.subscribe(receive_items, list_params, load_failed)\n\n  async function retry_load() {\n    if (retrying || disposed) return\n    retrying = true\n    const version = ++load_version\n    try {\n      const items = await data.transactions.list(list_params)\n      if (!disposed && version === load_version) receive_items(items)\n    } catch {\n      if (!disposed && version === load_version) load_failed()\n    } finally {\n      if (!disposed) retrying = false\n    }\n  }\n  onDestroy(() => { disposed = true; load_version++; unsubscribe() })\n\n  function amount_cents(value) {\n    const amount = Number(value)\n    if (!Number.isFinite(amount)) return 0\n    const cents = Math.sign(amount) * Math.round((Math.abs(amount) + Number.EPSILON) * 100)\n    return Number.isSafeInteger(cents) ? cents : 0\n  }\n\n  function parse_amount(value) {\n    const match = String(value).trim().match(/^([+-]?)(?:(\\d+)(?:\\.(\\d{1,2}))?|\\.(\\d{1,2}))$/)\n    if (!match) return null\n    const cents = (Number(match[2] || 0) * 100 + Number((match[3] || match[4] || '').padEnd(2, '0'))) * (match[1] === '-' ? -1 : 1)\n    return Number.isSafeInteger(cents) && cents !== 0 && amount_cents(cents / 100) === cents ? cents : null\n  }\n\n  let balance = $derived.by(() => transactions.reduce((total, transaction) => total + amount_cents(transaction.amount), 0) / 100)\n  let income = $derived.by(() => transactions.reduce((total, transaction) => total + Math.max(0, amount_cents(transaction.amount)), 0) / 100)\n  let expense = $derived.by(() => transactions.reduce((total, transaction) => total + Math.max(0, -amount_cents(transaction.amount)), 0) / 100)\n\n  async function add_transaction() {\n    if (saving) return\n    form_error = ''\n    const text = new_text.trim()\n    const cents = parse_amount(new_amount)\n    if (!text) { form_error = 'Enter a description.'; return }\n    if (cents === null) { form_error = 'Enter a non-zero amount with up to two decimal places. Use a minus sign for expenses.'; return }\n    saving = true\n    try {\n      await data.transactions.create({ text, amount: cents / 100, created: new Date().toISOString() })\n      new_text = ''\n      new_amount = ''\n    } catch {\n      form_error = 'Transaction could not be saved. Your entry is still here; try again.'\n    } finally {\n      saving = false\n    }\n  }\n\n  async function delete_transaction(id) {\n    if (deleting_id !== null) return\n    const original = transactions.find(transaction => transaction.id === id)\n    if (!original) return\n    deleting_id = id\n    history_error = ''\n    try {\n      await data.transactions.delete(id)\n      confirm_delete = null\n    } catch {\n      // Keep the entry visible even if a data adapter updates optimistically.\n      if (!transactions.some(transaction => transaction.id === id)) transactions = sort_transactions([...transactions, original])\n      history_error = 'Transaction could not be deleted. Try again.'\n    } finally {\n      deleting_id = null\n    }\n  }\n\n  function format_currency(amount) {\n    const value = Number(amount)\n    return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(Number.isFinite(value) ? value : 0)\n  }\n\n  function format_date(value) {\n    if (date_value(value) === null) return ''\n    return transaction_date(value).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })\n  }\n\n  function export_date(value) {\n    if (date_value(value) === null) return ''\n    const date = transaction_date(value)\n    return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`\n  }\n\n  function csv_cell(value, protect_formula = false) {\n    let text = String(value ?? '')\n    if (protect_formula && /^[\\s]*[=+\\-@]/.test(text)) text = \"'\" + text\n    return '\"' + text.replace(/\"/g, '\"\"') + '\"'\n  }\n\n  function export_csv() {\n    return ['Date,Description,Amount', ...transactions.map(transaction => [\n      csv_cell(export_date(transaction.created)),\n      csv_cell(transaction.text, true),\n      (amount_cents(transaction.amount) / 100).toFixed(2)\n    ].join(','))].join('\\r\\n')\n  }\n\n  function download_csv() {\n    const url = URL.createObjectURL(new Blob([export_csv()], { type: 'text/csv;charset=utf-8' }))\n    const anchor = document.createElement('a')\n    anchor.href = url\n    anchor.download = 'expenses.csv'\n    anchor.click()\n    setTimeout(() => URL.revokeObjectURL(url), 0)\n  }\n</script>\n\n<main class=\"page\">\n  <div class=\"container\">\n    <h1>{content.app_title}</h1>\n    <section class=\"summary\" aria-label=\"Transaction totals\">\n      <div class=\"balance\"><span>{content.balance_label}</span><strong>{format_currency(balance)}</strong></div>\n      <div><span>{content.income_label}</span><strong>{format_currency(income)}</strong></div>\n      <div><span>{content.expense_label}</span><strong>{format_currency(expense)}</strong></div>\n    </section>\n\n    <form onsubmit={event => { event.preventDefault(); void add_transaction() }} novalidate aria-labelledby=\"add-title\">\n      <h2 id=\"add-title\">{content.add_transaction_title}</h2>\n      <label for=\"description\">Description</label>\n      <input id=\"description\" type=\"text\" bind:value={new_text} placeholder={content.description_placeholder} disabled={saving} maxlength=\"240\" autocomplete=\"off\" aria-describedby={form_error ? 'entry-error' : undefined} />\n      <div class=\"amount-row\">\n        <div><label for=\"amount\">Amount (USD)</label><input id=\"amount\" type=\"text\" inputmode=\"decimal\" bind:value={new_amount} placeholder={content.amount_placeholder} disabled={saving} aria-describedby={form_error ? 'amount-hint entry-error' : 'amount-hint'} /></div>\n        <button class=\"primary\" type=\"submit\" disabled={saving}>{saving ? 'Saving…' : content.add_button}</button>\n      </div>\n      <p id=\"amount-hint\" class=\"hint\">Negative for expenses, positive for income.</p>\n      {#if form_error}<p class=\"error\" id=\"entry-error\" role=\"alert\">{form_error}</p>{/if}\n    </form>\n\n    <section class=\"history\" aria-labelledby=\"history-title\">\n      <div class=\"history-header\"><h2 id=\"history-title\">{content.history_title}</h2>{#if transactions.length > 0}<button class=\"download\" onclick={download_csv} aria-label=\"Export transactions as CSV\"><Icon icon=\"lucide:download\" width={15} /> Export</button>{/if}</div>\n      {#if history_error}<p class=\"error\" role=\"alert\">{history_error}</p>{/if}\n      {#if load_error}<div class=\"load-error\" role=\"alert\"><p>{load_error}</p><button onclick={retry_load} disabled={retrying}>{retrying ? 'Retrying…' : 'Retry loading'}</button></div>{/if}\n      {#if loading && !transactions.length}<p class=\"empty\" role=\"status\">{content.loading_message}</p>\n      {:else if transactions.length === 0 && !load_error}<p class=\"empty\">{content.empty_state}</p>\n      {:else}\n        <ul>\n          {#each transactions as transaction (transaction.id)}\n            <li>\n              <div class=\"transaction\">\n                <div class=\"description\"><span>{transaction.text}</span>{#if format_date(transaction.created)}<time datetime={transaction.created}>{format_date(transaction.created)}</time>{/if}</div>\n                <span class=\"amount\" class:income={transaction.amount > 0}>{transaction.amount > 0 ? '+' : ''}{format_currency(transaction.amount)}</span>\n                <button class=\"delete\" onclick={() => { confirm_delete = confirm_delete === transaction.id ? null : transaction.id }} aria-label={`Delete ${transaction.text}`} aria-expanded={confirm_delete === transaction.id} disabled={deleting_id !== null}><Icon icon=\"lucide:trash-2\" width={15} /></button>\n              </div>\n              {#if confirm_delete === transaction.id}\n                <div class=\"confirm\"><span>Delete this transaction?</span><button onclick={() => { confirm_delete = null }} disabled={deleting_id !== null}>Cancel</button><button class=\"danger\" onclick={() => delete_transaction(transaction.id)} disabled={deleting_id !== null}>{deleting_id === transaction.id ? 'Deleting…' : 'Delete'}</button></div>\n              {/if}\n            </li>\n          {/each}\n        </ul>\n      {/if}\n    </section>\n  </div>\n</main>\n\n<style>\n  :global(*) { box-sizing: border-box; }\n  .page { min-height: 100vh; padding: 2rem 1.25rem; background: var(--page-background, #fafafa); color: var(--body-text-color, #202020); font-family: var(--body-font, system-ui, sans-serif); }\n  .container { max-width: 560px; margin: 0 auto; }\n  h1 { font-size: 1.25rem; font-weight: 600; letter-spacing: -.025em; margin: 0 0 1.5rem; color: var(--heading-text-color, #202020); }\n  h2 { margin: 0; font-size: .9375rem; font-weight: 600; color: var(--heading-text-color, #202020); }\n  .summary { display: grid; grid-template-columns: 1.25fr 1fr 1fr; gap: 1rem; border-bottom: 1px solid var(--border-color, #e5e5e5); padding-bottom: 1.5rem; margin-bottom: 1.5rem; }\n  .summary > div { min-width: 0; display: flex; flex-direction: column; gap: .4rem; }\n  .summary span { color: var(--secondary-text-color, #737373); font-size: .8125rem; }\n  .summary strong { font-size: 1.125rem; font-weight: 500; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }\n  .balance strong { font-weight: 600; }\n  form { padding: 1.25rem; background: var(--card-background, #fff); border: 1px solid var(--border-color, #e5e5e5); border-radius: var(--card-radius, 6px); }\n  form h2 { margin-bottom: 1rem; }\n  label { display: block; margin: 0 0 .4rem; font-size: .8125rem; }\n  input { width: 100%; min-height: 40px; border: 1px solid var(--border-color, #e5e5e5); border-radius: 5px; background: transparent; color: inherit; font: inherit; font-size: .9375rem; padding: .55rem .7rem; }\n  input::placeholder { color: var(--secondary-text-color, #737373); }\n  .amount-row { display: flex; gap: .75rem; align-items: end; margin-top: .875rem; }\n  .amount-row > div { flex: 1; min-width: 0; }\n  button { display: inline-flex; align-items: center; justify-content: center; gap: .4rem; min-height: 36px; padding: .45rem .7rem; border: 1px solid var(--border-color, #e5e5e5); border-radius: var(--button-radius, 5px); background: var(--card-background, #fff); color: inherit; cursor: pointer; font: inherit; font-size: .8125rem; white-space: nowrap; }\n  button.primary { min-height: 40px; background: var(--button-background, #262626); border-color: var(--button-background, #262626); color: #fff; }\n  button:hover { opacity: .8; }\n  button:disabled { opacity: .55; cursor: wait; }\n  .hint { margin: .65rem 0 0; color: var(--secondary-text-color, #737373); font-size: .75rem; line-height: 1.5; }\n  .error, .load-error { margin: .75rem 0 0; font-size: .8125rem; line-height: 1.5; color: var(--negative-color, #b91c1c); }\n  .load-error p { margin: 0 0 .5rem; }\n  .history { margin-top: 1.75rem; }\n  .history-header { display: flex; justify-content: space-between; gap: .75rem; align-items: center; padding-bottom: .625rem; border-bottom: 1px solid var(--border-color, #e5e5e5); }\n  .download { border-color: transparent; padding: .35rem .1rem .35rem .5rem; color: var(--secondary-text-color, #737373); }\n  ul { margin: 0; padding: 0; list-style: none; }\n  li { border-bottom: 1px solid var(--border-color, #e5e5e5); }\n  .transaction { display: flex; gap: .75rem; align-items: center; padding: .875rem 0; }\n  .description { flex: 1; min-width: 0; display: grid; gap: .25rem; font-size: .875rem; overflow-wrap: anywhere; }\n  time { font-size: .75rem; color: var(--secondary-text-color, #737373); }\n  .amount { font-variant-numeric: tabular-nums; font-size: .875rem; white-space: nowrap; }\n  .amount.income { color: var(--positive-color, #047857); }\n  .delete { width: 36px; padding: .5rem; flex-shrink: 0; border-color: transparent; color: var(--secondary-text-color, #737373); }\n  .confirm { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; padding: 0 0 .875rem; font-size: .8125rem; }\n  .confirm > span { flex: 1; }\n  button.danger { color: var(--negative-color, #b91c1c); }\n  .empty { margin: 0; padding: 1.25rem 0; color: var(--secondary-text-color, #737373); font-size: .875rem; }\n  button:focus-visible, input:focus-visible { outline: 2px solid var(--button-background, #262626); outline-offset: 3px; }\n  @media (max-width: 400px) { .page { padding: 1.25rem .875rem; } .summary { gap: .65rem; } .summary strong { font-size: 1rem; } form { padding: 1rem; } .amount-row { flex-direction: column; align-items: stretch; } .transaction { gap: .45rem; } .confirm > span { flex-basis: 100%; } }\n</style>\n",
