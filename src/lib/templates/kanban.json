{
  "id": "kanban",
  "name": "Tasks",
  "description": "Organize tasks across three columns.",
  "preview": "lucide:columns-3",
  "tags": [
    "productivity",
    "intermediate",
    "data"
  ],
  "kits": [
    "business",
    "daily",
    "team"
  ],
  "frontend_code": "<script>\n\timport Icon from '@iconify/svelte'\n\timport { onDestroy } from 'svelte'\n\timport content from '$content'\n\timport data from '$data'\n\tconst list_params = { all: true }\n\n\tlet cards = $state([])\n\tlet loading = $state(true)\n\tlet retrying = $state(false)\n\tlet disposed = false\n\tlet load_version = 0\n\tlet load_error = $state(false)\n\tlet error = $state('')\n\tlet saving = $state(false)\n\tlet pending_ids = $state([])\n\tlet dragging_id = $state(null)\n\tlet drag_over_column = $state(null)\n\tlet adding_to_column = $state(null)\n\tlet editing_card = $state(null)\n\tlet expanded_card = $state(null)\n\tlet form_title = $state('')\n\tlet form_description = $state('')\n\tlet form_priority = $state('medium')\n\tlet form_label = $state('')\n\tlet form_due_date = $state('')\n\n\tconst columns = [\n\t\t{ id: 'todo', name: content.column_1_name || 'To Do', icon: 'lucide:circle' },\n\t\t{ id: 'progress', name: content.column_2_name || 'In Progress', icon: 'lucide:circle-dot' },\n\t\t{ id: 'done', name: content.column_3_name || 'Done', icon: 'lucide:check-circle' }\n\t]\n\tconst labels = [\n\t\t{ id: 'feature', name: 'Feature' }, { id: 'bug', name: 'Bug' },\n\t\t{ id: 'docs', name: 'Docs' }, { id: 'design', name: 'Design' }, { id: 'research', name: 'Research' }\n\t]\n\tconst priorities = [\n\t\t{ id: 'low', name: 'Low', icon: 'lucide:arrow-down' },\n\t\t{ id: 'medium', name: 'Medium', icon: 'lucide:minus' },\n\t\t{ id: 'high', name: 'High', icon: 'lucide:arrow-up' }\n\t]\n\n\tconst load_timeout = setTimeout(() => { if (loading && !disposed) { loading = false; load_error = true } }, 12000)\n\tfunction receive_cards(items) {\n\t\tif (disposed) return\n\t\tload_version++\n\t\tcards = items\n\t\tloading = false\n\t\tload_error = false\n\t\tclearTimeout(load_timeout)\n\t}\n\tfunction load_failed() {\n\t\tif (disposed) return\n\t\tloading = false\n\t\tload_error = true\n\t\tclearTimeout(load_timeout)\n\t}\n\tconst unsubscribe = data.cards.subscribe(receive_cards, list_params, load_failed)\n\tonDestroy(() => { disposed = true; load_version++; unsubscribe(); clearTimeout(load_timeout) })\n\tasync function retry_load() {\n\t\tif (retrying || disposed) return\n\t\tretrying = true\n\t\tconst version = ++load_version\n\t\ttry {\n\t\t\tconst items = await data.cards.list(list_params)\n\t\t\tif (!disposed && version === load_version) receive_cards(items)\n\t\t} catch { if (!disposed && version === load_version) load_failed() }\n\t\tfinally { if (!disposed) retrying = false }\n\t}\n\n\tfunction get_column_cards(column_id) {\n\t\treturn cards.filter(c => (columns.some(column => column.id === c.column) ? c.column : 'todo') === column_id)\n\t\t\t.sort((a, b) => (Number(a.order) || 0) - (Number(b.order) || 0))\n\t}\n\tfunction next_order(column_id) {\n\t\treturn Math.max(-1, ...get_column_cards(column_id).map(card => Number(card.order) || 0)) + 1\n\t}\n\tfunction get_label(label_id) { return labels.find(l => l.id === label_id) }\n\tfunction get_priority(priority_id) { return priorities.find(p => p.id === priority_id) || priorities[1] }\n\tfunction local_date_key(date) {\n\t\treturn `${String(date.getFullYear()).padStart(4, '0')}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`\n\t}\n\tfunction parse_due_date(value) {\n\t\tif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(value || '')) return null\n\t\tconst [year, month, day] = value.split('-').map(Number)\n\t\tif (year < 1) return null\n\t\tconst date = new Date(0)\n\t\tdate.setFullYear(year, month - 1, day)\n\t\tdate.setHours(0, 0, 0, 0)\n\t\treturn local_date_key(date) === value ? date : null\n\t}\n\tfunction is_overdue(value) {\n\t\treturn !!parse_due_date(value) && value < local_date_key(new Date())\n\t}\n\tfunction format_date(value) {\n\t\tconst date = parse_due_date(value)\n\t\tif (!date) return ''\n\t\tconst today = new Date()\n\t\tconst tomorrow = new Date(today)\n\t\ttomorrow.setDate(tomorrow.getDate() + 1)\n\t\tif (value === local_date_key(today)) return 'Today'\n\t\tif (value === local_date_key(tomorrow)) return 'Tomorrow'\n\t\treturn date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })\n\t}\n\tfunction handle_drag_start(e, card) {\n\t\tif (pending_ids.includes(card.id)) { e.preventDefault(); return }\n\t\tdragging_id = card.id\n\t\te.dataTransfer.effectAllowed = 'move'\n\t\te.dataTransfer.setData('text/plain', card.id)\n\t}\n\tfunction handle_drag_over(e, column_id) {\n\t\tif (!dragging_id) return\n\t\te.preventDefault()\n\t\tdrag_over_column = column_id\n\t}\n\tfunction handle_drag_leave() { drag_over_column = null }\n\tfunction handle_drag_end() { dragging_id = null; drag_over_column = null }\n\tasync function handle_drop(e, column_id) {\n\t\te.preventDefault()\n\t\tconst id = dragging_id\n\t\thandle_drag_end()\n\t\tif (id) await move_card(id, column_id)\n\t}\n\tasync function move_card(id, column_id) {\n\t\tconst card = cards.find(card => card.id === id)\n\t\tif (!card || pending_ids.includes(id) || card.column === column_id || !columns.some(column => column.id === column_id)) return\n\t\tpending_ids = [...pending_ids, id]\n\t\terror = ''\n\t\ttry { await data.cards.update(id, { column: column_id, order: next_order(column_id) }) }\n\t\tcatch { error = 'Could not move the task. Try again.' }\n\t\tfinally { pending_ids = pending_ids.filter(value => value !== id) }\n\t}\n\tfunction reset_form() {\n\t\tform_title = ''; form_description = ''; form_priority = 'medium'; form_label = ''; form_due_date = ''\n\t}\n\tfunction start_adding(column_id) {\n\t\tif (saving) return\n\t\treset_form(); error = ''; adding_to_column = column_id; editing_card = null\n\t}\n\tfunction start_editing(card) {\n\t\tif (saving || pending_ids.includes(card.id)) return\n\t\tform_title = card.title || ''; form_description = card.description || ''\n\t\tform_priority = card.priority || 'medium'; form_label = card.label || ''; form_due_date = card.due_date || ''\n\t\terror = ''; editing_card = card.id; adding_to_column = null; expanded_card = null\n\t}\n\tfunction cancel_form() {\n\t\tif (saving) return\n\t\tadding_to_column = null; editing_card = null; error = ''; reset_form()\n\t}\n\tasync function save_card(column_id) {\n\t\tif (saving) return\n\t\tif (!form_title.trim()) { error = 'Enter a task title.'; return }\n\t\tif (form_due_date && !parse_due_date(form_due_date)) { error = 'Enter a valid due date.'; return }\n\t\tsaving = true\n\t\terror = ''\n\t\tconst fields = {\n\t\t\ttitle: form_title.trim(), description: form_description.trim(), priority: form_priority,\n\t\t\tlabel: form_label, due_date: form_due_date\n\t\t}\n\t\ttry {\n\t\t\tif (editing_card) await data.cards.update(editing_card, fields)\n\t\t\telse await data.cards.create({ ...fields, column: column_id, order: next_order(column_id) })\n\t\t\tediting_card = null; adding_to_column = null; reset_form()\n\t\t} catch { error = 'Could not save the task. Your changes are still here.' }\n\t\tfinally { saving = false }\n\t}\n\tasync function delete_card(id) {\n\t\tif (pending_ids.includes(id)) return\n\t\tpending_ids = [...pending_ids, id]\n\t\terror = ''\n\t\ttry { await data.cards.delete(id); if (expanded_card === id) expanded_card = null }\n\t\tcatch { error = 'Could not delete the task. Try again.' }\n\t\tfinally { pending_ids = pending_ids.filter(value => value !== id) }\n\t}\n\tfunction toggle_expand(id) { expanded_card = expanded_card === id ? null : id }\n\tfunction handle_keydown(e, column_id) {\n\t\tif (e.key === 'Enter' && !e.shiftKey && !e.isComposing) { e.preventDefault(); save_card(column_id) }\n\t\tif (e.key === 'Escape') cancel_form()\n\t}\n</script>\n\n<div class=\"page\">\n\t<header class=\"header\">\n\t\t<div class=\"header-content\">\n\t\t\t<h1>{content.board_title}</h1>\n\t\t\t<p class=\"subtitle\">{cards.length} {cards.length === 1 ? 'task' : 'tasks'}</p>\n\t\t</div>\n\t</header>\n\n\t{#if error}<p class=\"error\" role=\"alert\">{error}</p>{/if}\n\t{#if load_error}<div class=\"load-error\" role=\"alert\">Could not load tasks. <button onclick={retry_load} disabled={retrying}>{retrying ? 'Retrying…' : 'Retry'}</button></div>{/if}\n\t<div class=\"board\">\n\t\t{#each columns as column (column.id)}\n\t\t\t<div \n\t\t\t\tclass=\"column\"\n\t\t\t\trole=\"region\" aria-label={column.name}\n\t\t\t\tclass:drag-over={drag_over_column === column.id}\n\t\t\t\tondragover={(e) => handle_drag_over(e, column.id)}\n\t\t\t\tondragleave={handle_drag_leave}\n\t\t\t\tondrop={(e) => handle_drop(e, column.id)}\n\t\t\t>\n\t\t\t\t<div class=\"column-header\">\n\t\t\t\t\t<div class=\"column-title\">\n\t\t\t\t\t\t<Icon icon={column.icon} width={16} />\n\t\t\t\t\t\t<h2>{column.name}</h2>\n\t\t\t\t\t</div>\n\t\t\t\t\t<span class=\"count\">{get_column_cards(column.id).length}</span>\n\t\t\t\t</div>\n\n\t\t\t\t<div class=\"cards\">\n\t\t\t\t\t{#if loading}\n\t\t\t\t\t\t<div class=\"loading\">\n\t\t\t\t\t\t\t<Icon icon=\"lucide:loader-2\" width={20} class=\"spin\" />\n\t\t\t\t\t\t\t<span>Loading tasks…</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t{:else}\n\t\t\t\t\t\t{#each get_column_cards(column.id) as card (card.id)}\n\t\t\t\t\t\t\t{#if editing_card === card.id}\n\t\t\t\t\t\t\t\t<div class=\"card-form\">\n\t\t\t\t\t\t\t\t\t<input\n\t\t\t\t\t\t\t\t\t\ttype=\"text\"\n\t\t\t\t\t\t\t\t\t\tbind:value={form_title}\n\t\t\t\t\t\t\t\t\t\tplaceholder=\"Task title\"\n\t\t\t\t\t\t\t\t\t\taria-label=\"Task title\" disabled={saving} maxlength=\"200\"\n\t\t\t\t\t\t\t\t\t\tonkeydown={(e) => handle_keydown(e, card.column)}\n\t\t\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t\t\t\t<textarea\n\t\t\t\t\t\t\t\t\t\tbind:value={form_description}\n\t\t\t\t\t\t\t\t\t\tplaceholder=\"Description\" aria-label=\"Description\" disabled={saving}\n\t\t\t\t\t\t\t\t\t\trows=\"2\"\n\t\t\t\t\t\t\t\t\t></textarea>\n\t\t\t\t\t\t\t\t\t<div class=\"form-row\">\n\t\t\t\t\t\t\t\t\t\t<select bind:value={form_priority} aria-label=\"Priority\" disabled={saving}>\n\t\t\t\t\t\t\t\t\t\t\t{#each priorities as p}\n\t\t\t\t\t\t\t\t\t\t\t\t<option value={p.id}>{p.name}</option>\n\t\t\t\t\t\t\t\t\t\t\t{/each}\n\t\t\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t\t\t\t<select bind:value={form_label} aria-label=\"Label\" disabled={saving}>\n\t\t\t\t\t\t\t\t\t\t\t<option value=\"\">No label</option>\n\t\t\t\t\t\t\t\t\t\t\t{#each labels as l}\n\t\t\t\t\t\t\t\t\t\t\t\t<option value={l.id}>{l.name}</option>\n\t\t\t\t\t\t\t\t\t\t\t{/each}\n\t\t\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<input type=\"date\" bind:value={form_due_date} aria-label=\"Due date\" disabled={saving} />\n\t\t\t\t\t\t\t\t\t<div class=\"form-actions\">\n\t\t\t\t\t\t\t\t\t\t<button class=\"save-btn\" disabled={saving} onclick={() => save_card(card.column)}>{saving ? 'Saving…' : 'Save'}</button>\n\t\t\t\t\t\t\t\t\t\t<button class=\"cancel-btn\" disabled={saving} onclick={cancel_form}>Cancel</button>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t{:else}\n\t\t\t\t\t\t\t\t<div\n\t\t\t\t\t\t\t\t\tclass=\"card\" role=\"group\" aria-label={card.title}\n\t\t\t\t\t\t\t\t\tclass:dragging={dragging_id === card.id}\n\t\t\t\t\t\t\t\t\tclass:expanded={expanded_card === card.id}\n\t\t\t\t\t\t\t\t\tdraggable=\"true\"\n\t\t\t\t\t\t\t\t\tondragstart={(e) => handle_drag_start(e, card)}\n\t\t\t\t\t\t\t\t\tondragend={handle_drag_end}\n\t\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t\t{#if card.label}\n\t\t\t\t\t\t\t\t\t\t{@const label = get_label(card.label)}\n\t\t\t\t\t\t\t\t\t\t{#if label}\n\t\t\t\t\t\t\t\t\t\t\t<span class=\"card-label\" >{label.name}</span>\n\t\t\t\t\t\t\t\t\t\t{/if}\n\t\t\t\t\t\t\t\t\t{/if}\n\t\t\t\t\t\t\t\t\t<div class=\"card-main\">\n\t\t\t\t\t\t\t\t\t\t<button class=\"card-title\" aria-expanded={expanded_card === card.id} onclick={() => toggle_expand(card.id)}>{card.title}</button>\n\t\t\t\t\t\t\t\t\t\t<div class=\"card-actions\">\n\t\t\t\t\t\t\t\t\t\t\t<button class=\"action-btn\" onclick={() => start_editing(card)} title=\"Edit task\" aria-label={`Edit ${card.title}`} disabled={pending_ids.includes(card.id)}>\n\t\t\t\t\t\t\t\t\t\t\t\t<Icon icon=\"lucide:pencil\" width={14} />\n\t\t\t\t\t\t\t\t\t\t\t</button>\n\t\t\t\t\t\t\t\t\t\t\t<button class=\"action-btn delete\" onclick={() => delete_card(card.id)} title=\"Delete task\" aria-label={`Delete ${card.title}`} disabled={pending_ids.includes(card.id)}>\n\t\t\t\t\t\t\t\t\t\t\t\t<Icon icon=\"lucide:trash-2\" width={14} />\n\t\t\t\t\t\t\t\t\t\t\t</button>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t{#if card.description && expanded_card === card.id}\n\t\t\t\t\t\t\t\t\t\t<p class=\"card-description\">{card.description}</p>\n\t\t\t\t\t\t\t\t\t{/if}\n\t\t\t\t\t\t\t\t\t<div class=\"card-meta\">\n\t\t\t\t\t\t\t\t\t\t<span class=\"priority\"  title=\"{get_priority(card.priority).name} priority\" aria-label=\"{get_priority(card.priority).name} priority\">\n\t\t\t\t\t\t\t\t\t\t\t<Icon icon={get_priority(card.priority).icon} width={14} />\n\t\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t\t{#if card.due_date}\n\t\t\t\t\t\t\t\t\t\t\t<span class=\"due-date\" class:overdue={column.id !== 'done' && is_overdue(card.due_date)}>\n\t\t\t\t\t\t\t\t\t\t\t\t<Icon icon=\"lucide:calendar\" width={12} />\n\t\t\t\t\t\t\t\t\t\t\t\t{format_date(card.due_date)}\n\t\t\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t\t{/if}\n\t\t\t\t\t\t\t\t\t\t{#if card.description}\n\t\t\t\t\t\t\t\t\t\t\t<span class=\"has-description\" title=\"Has description\">\n\t\t\t\t\t\t\t\t\t\t\t\t<Icon icon=\"lucide:align-left\" width={12} />\n\t\t\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t\t{/if}\n\t\t\t\t\t\t\t\t\t\t<select class=\"move-select\" aria-label={`Move ${card.title} to column`} value={column.id} disabled={pending_ids.includes(card.id)} onchange={async (e) => { const select = e.currentTarget; await move_card(card.id, select.value); select.value = cards.find(item => item.id === card.id)?.column || column.id }}>\n\t\t\t\t\t\t\t\t\t\t\t{#each columns as destination}<option value={destination.id}>{destination.name}</option>{/each}\n\t\t\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t{/if}\n\t\t\t\t\t\t{:else}\n\t\t\t\t\t\t\t{#if !adding_to_column && !load_error}\n\t\t\t\t\t\t\t\t<div class=\"empty-column\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<span>No tasks yet</span>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t{/if}\n\t\t\t\t\t\t{/each}\n\t\t\t\t\t{/if}\n\n\t\t\t\t\t{#if adding_to_column === column.id}\n\t\t\t\t\t\t<div class=\"card-form\">\n\t\t\t\t\t\t\t<input\n\t\t\t\t\t\t\t\ttype=\"text\"\n\t\t\t\t\t\t\t\tbind:value={form_title}\n\t\t\t\t\t\t\t\tplaceholder=\"Task title\"\n\t\t\t\t\t\t\t\t\t\taria-label=\"Task title\" disabled={saving} maxlength=\"200\"\n\t\t\t\t\t\t\t\tonkeydown={(e) => handle_keydown(e, column.id)}\n\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t\t<textarea\n\t\t\t\t\t\t\t\tbind:value={form_description}\n\t\t\t\t\t\t\t\tplaceholder=\"Description\" aria-label=\"Description\" disabled={saving}\n\t\t\t\t\t\t\t\trows=\"2\"\n\t\t\t\t\t\t\t></textarea>\n\t\t\t\t\t\t\t<div class=\"form-row\">\n\t\t\t\t\t\t\t\t<select bind:value={form_priority} aria-label=\"Priority\" disabled={saving}>\n\t\t\t\t\t\t\t\t\t{#each priorities as p}\n\t\t\t\t\t\t\t\t\t\t<option value={p.id}>{p.name}</option>\n\t\t\t\t\t\t\t\t\t{/each}\n\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t\t<select bind:value={form_label} aria-label=\"Label\" disabled={saving}>\n\t\t\t\t\t\t\t\t\t<option value=\"\">No label</option>\n\t\t\t\t\t\t\t\t\t{#each labels as l}\n\t\t\t\t\t\t\t\t\t\t<option value={l.id}>{l.name}</option>\n\t\t\t\t\t\t\t\t\t{/each}\n\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<input type=\"date\" bind:value={form_due_date} aria-label=\"Due date\" disabled={saving} />\n\t\t\t\t\t\t\t<div class=\"form-actions\">\n\t\t\t\t\t\t\t\t<button class=\"save-btn\" disabled={saving} onclick={() => save_card(column.id)}>{saving ? 'Saving…' : content.add_button}</button>\n\t\t\t\t\t\t\t\t<button class=\"cancel-btn\" disabled={saving} onclick={cancel_form}>Cancel</button>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t{:else}\n\t\t\t\t\t\t<button class=\"add-card-btn\" disabled={saving || loading || load_error} onclick={() => start_adding(column.id)}>\n\t\t\t\t\t\t\t<Icon icon=\"lucide:plus\" width={16} />\n\t\t\t\t\t\t\t{content.add_card_text}\n\t\t\t\t\t\t</button>\n\t\t\t\t\t{/if}\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t{/each}\n\t</div>\n\t\n</div>\n\n<style>\n\t.page {\n\t\tmin-height: 100vh;\n\t\tbackground: var(--page-background, #f1f5f9);\n\t\tfont-family: var(--body-font, system-ui, sans-serif);\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\t}\n\n\t.header {\n\t\tpadding: 1.25rem 1.5rem;\n\t\tbackground: var(--header-background, #ffffff);\n\t\tborder-bottom: 1px solid var(--border-color, #e2e8f0);\n\t}\n\n\t.header-content {\n\t\tdisplay: flex;\n\t\talign-items: baseline;\n\t\tgap: 1rem;\n\t}\n\n\t.header h1 {\n\t\tmargin: 0;\n\t\tfont-size: 1.25rem;\n\t\tfont-weight: 600;\n\t\tcolor: var(--heading-text-color, #1e293b);\n\t}\n\n\t.subtitle {\n\t\tmargin: 0;\n\t\tfont-size: 0.875rem;\n\t\tcolor: var(--secondary-text-color, #64748b);\n\t}\n\n\t.board {\n\t\tdisplay: flex;\n\t\tgap: 1rem;\n\t\tpadding: 1.25rem 1.5rem;\n\t\tflex: 1;\n\t\toverflow-x: auto;\n\t}\n\n\t.column {\n\t\tflex: 1;\n\t\tmin-width: 250px;\n\t\tbackground: var(--column-background, #ffffff);\n\t\tborder-radius: var(--column-radius, 12px);\n\t\tpadding: 1rem;\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\t\tmin-height: 180px;\n\t\tmax-height: calc(100vh - 130px);\n\t\tborder: 1px solid var(--border-color, #e2e8f0);\n\t\ttransition: background-color 150ms, color 150ms, border-color 150ms;\n\t}\n\n\t.column.drag-over {\n\t\tbackground: var(--drag-over-background, #f8fafc);\n\t\tborder-color: var(--accent-color, #3b82f6);\n\t\tborder-style: dashed;\n\t}\n\n\t.column-header {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tjustify-content: space-between;\n\t\tmargin-bottom: 1rem;\n\t\tpadding-bottom: 0.75rem;\n\t\tborder-bottom: 1px solid var(--border-color, #e2e8f0);\n\t}\n\n\t.column-title {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tgap: 8px;\n\t\tcolor: var(--heading-text-color, #1e293b);\n\t}\n\n\t.column-header h2 {\n\t\tmargin: 0;\n\t\tfont-size: 0.875rem;\n\t\tfont-weight: 600;\n\t\ttext-transform: none;\n\t\tletter-spacing: 0;\n\t}\n\n\t.count {\n\t\tbackground: var(--count-background, #f1f5f9);\n\t\tcolor: var(--secondary-text-color, #64748b);\n\t\tfont-size: 0.75rem;\n\t\tfont-weight: 600;\n\t\tpadding: 2px 8px;\n\t\tborder-radius: 6px;\n\t}\n\n\t.cards {\n\t\tflex: 1;\n\t\toverflow-y: auto;\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\t\tgap: 10px;\n\t}\n\n\t.card {\n\t\tbackground: var(--card-background, #ffffff);\n\t\tborder: 1px solid var(--card-border, #e2e8f0);\n\t\tborder-radius: var(--card-radius, 8px);\n\t\tpadding: 12px;\n\t\tcursor: grab;\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\t\tgap: 8px;\n\t\ttransition: background-color 150ms, color 150ms, border-color 150ms;\n\t}\n\n\t.card:hover {\n\t\tborder-color: var(--card-hover-border, #cbd5e1);\n\t}\n\n\t.card.dragging {\n\t\topacity: 0.5;\n\t\tcursor: grabbing;\n\t\t\n\t}\n\n\t.card.expanded {\n\t\tborder-color: var(--accent-color, #3b82f6);\n\t}\n\n\t.card-label {\n\t\tpadding: 2px 8px;\n\t\tborder-radius: 4px;\n\t\tfont-size: 0.7rem;\n\t\tfont-weight: 600;\n\t\tcolor: var(--secondary-text-color, #737373);\n\t\tbackground: var(--page-background, #fafafa);\n\t\talign-self: flex-start;\n\t\ttext-transform: none;\n\t\tletter-spacing: 0;\n\t}\n\n\t.card-main {\n\t\tdisplay: flex;\n\t\tjustify-content: space-between;\n\t\talign-items: flex-start;\n\t\tgap: 8px;\n\t}\n\n\t.card-title {\n\t\tcolor: var(--body-text-color, #334155);\n\t\tbackground: none; border: 0; padding: 0; text-align: left; font-family: inherit;\n\t\tfont-size: 0.9rem;\n\t\tfont-weight: 500;\n\t\tline-height: 1.4;\n\t\tword-break: break-word;\n\t\tcursor: pointer;\n\t}\n\n\t.card-description {\n\t\tmargin: 0;\n\t\tcolor: var(--secondary-text-color, #64748b);\n\t\tfont-size: 0.8rem;\n\t\tline-height: 1.5;\n\t\tpadding: 8px;\n\t\tbackground: var(--page-background, #f8fafc);\n\t\tborder-radius: 6px;\n\t}\n\n\t.card-actions {\n\t\tdisplay: flex;\n\t\tgap: 4px;\n\t\topacity: 0.7;\n\t\ttransition: opacity 0.15s;\n\t}\n\n\t.card:hover .card-actions {\n\t\topacity: 1;\n\t}\n\n\t.action-btn {\n\t\tbackground: none;\n\t\tborder: none;\n\t\tcolor: var(--secondary-text-color, #94a3b8);\n\t\tcursor: pointer;\n\t\tpadding: 4px;\n\t\tborder-radius: 4px;\n\t\ttransition: background-color 150ms, color 150ms, border-color 150ms;\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tjustify-content: center;\n\t}\n\n\t.action-btn:hover {\n\t\tbackground: var(--page-background, #f1f5f9);\n\t\tcolor: var(--body-text-color, #334155);\n\t}\n\n\t.action-btn.delete:hover {\n\t\tcolor: var(--danger-color, #ef4444);\n\t\tbackground: #fef2f2;\n\t}\n\n\t.card-meta {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tgap: 8px;\n\t\tflex-wrap: wrap;\n\t\tfont-size: 0.75rem;\n\t}\n\n\t.priority {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t}\n\n\t.due-date {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tgap: 4px;\n\t\tcolor: var(--secondary-text-color, #64748b);\n\t\tbackground: var(--page-background, #f8fafc);\n\t\tpadding: 2px 6px;\n\t\tborder-radius: 4px;\n\t}\n\n\t.due-date.overdue {\n\t\tcolor: var(--danger-color, #ef4444);\n\t\tbackground: #fef2f2;\n\t}\n\n\t.has-description {\n\t\tcolor: var(--secondary-text-color, #94a3b8);\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t}\n\n\t.empty-column {\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\t\talign-items: center;\n\t\tgap: 8px;\n\t\tpadding: 2rem 1rem;\n\t\tcolor: var(--secondary-text-color, #94a3b8);\n\t\tfont-size: 0.875rem;\n\t}\n\n\t.add-card-btn {\n\t\tbackground: none;\n\t\tborder: 1px dashed var(--border-color, #e2e8f0);\n\t\tcolor: var(--secondary-text-color, #64748b);\n\t\tcursor: pointer;\n\t\tpadding: 12px;\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tjustify-content: center;\n\t\tgap: 6px;\n\t\tfont-size: 0.875rem;\n\t\tborder-radius: var(--card-radius, 8px);\n\t\ttransition: background-color 150ms, color 150ms, border-color 150ms;\n\t\twidth: 100%;\n\t\tmargin-top: 8px;\n\t}\n\n\t.add-card-btn:hover {\n\t\tbackground: var(--hover-background, #f8fafc);\n\t\tborder-color: var(--secondary-text-color, #94a3b8);\n\t\tcolor: var(--body-text-color, #334155);\n\t}\n\n\t.card-form {\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\t\tgap: 8px;\n\t\tbackground: var(--card-background, #ffffff);\n\t\tborder: 1px solid var(--accent-color, #3b82f6);\n\t\tborder-radius: var(--card-radius, 8px);\n\t\tpadding: 12px;\n\t}\n\n\t.card-form input[type=\"text\"],\n\t.card-form textarea {\n\t\tpadding: 10px 12px;\n\t\tborder: 1px solid var(--border-color, #e2e8f0);\n\t\tborder-radius: 6px;\n\t\tfont-size: 0.9rem;\n\t\tcolor: var(--body-text-color, #334155);\n\t\tbackground: var(--input-background, #ffffff);\n\t\tfont-family: inherit;\n\t\tresize: none;\n\t}\n\n\t.card-form input:focus,\n\t.card-form textarea:focus,\n\t.card-form select:focus {\n\t\toutline: none;\n\t\tborder-color: var(--accent-color, #3b82f6);\n\t\tbox-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);\n\t}\n\n\t.card-form input::placeholder,\n\t.card-form textarea::placeholder {\n\t\tcolor: var(--placeholder-color, #94a3b8);\n\t}\n\n\t.form-row {\n\t\tdisplay: flex;\n\t\tgap: 8px;\n\t}\n\n\t.card-form select,\n\t.card-form input[type=\"date\"] {\n\t\tpadding: 8px 10px;\n\t\tborder: 1px solid var(--border-color, #e2e8f0);\n\t\tborder-radius: 6px;\n\t\tfont-size: 0.8rem;\n\t\tcolor: var(--body-text-color, #334155);\n\t\tbackground: var(--input-background, #ffffff);\n\t\tflex: 1;\n\t}\n\n\t.form-actions {\n\t\tdisplay: flex;\n\t\tgap: 8px;\n\t\tmargin-top: 4px;\n\t}\n\n\t.save-btn {\n\t\tpadding: 8px 16px;\n\t\tbackground: var(--accent-color, #3b82f6);\n\t\tcolor: #ffffff;\n\t\tborder: none;\n\t\tborder-radius: 6px;\n\t\tfont-weight: 500;\n\t\tfont-size: 0.875rem;\n\t\tcursor: pointer;\n\t\ttransition: background-color 150ms, color 150ms, border-color 150ms;\n\t}\n\n\t.save-btn:hover {\n\t\tfilter: brightness(1.1);\n\t}\n\n\t.cancel-btn {\n\t\tpadding: 8px 16px;\n\t\tbackground: none;\n\t\tborder: 1px solid var(--border-color, #e2e8f0);\n\t\tcolor: var(--secondary-text-color, #64748b);\n\t\tborder-radius: 6px;\n\t\tfont-size: 0.875rem;\n\t\tcursor: pointer;\n\t\ttransition: background-color 150ms, color 150ms, border-color 150ms;\n\t}\n\n\t.cancel-btn:hover {\n\t\tbackground: var(--page-background, #f8fafc);\n\t\tcolor: var(--body-text-color, #334155);\n\t}\n\n\t.loading {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tjustify-content: center;\n\t\tgap: 8px;\n\t\tcolor: var(--secondary-text-color, #64748b);\n\t\tfont-size: 0.875rem;\n\t\tpadding: 2rem 1rem;\n\t}\n\n\t:global(.spin) {\n\t\tanimation: spin 1s linear infinite;\n\t}\n\n\t@keyframes spin {\n\t\tfrom { transform: rotate(0deg); }\n\t\tto { transform: rotate(360deg); }\n\t}\n\n\n  :global(button:focus-visible), :global(a:focus-visible), :global(input:focus-visible), :global(textarea:focus-visible), :global(select:focus-visible) {\n    outline: 2px solid var(--accent-color, #2563eb);\n    outline-offset: 2px;\n  }\n  @media (prefers-reduced-motion: reduce) {\n    :global(*), :global(*::before), :global(*::after) {\n      animation-duration: 0.01ms !important;\n      animation-iteration-count: 1 !important;\n      transition-duration: 0.01ms !important;\n    }\n  }\n\n\t.error, .load-error { margin: 1rem 1.5rem 0; color: var(--danger-color, #b91c1c); font-size: 0.875rem; }\n\t.load-error button { margin-left: 0.5rem; cursor: pointer; }\n\t.move-select { margin-left: auto; min-height: 30px; max-width: 130px; border: 1px solid var(--border-color, #e5e5e5); border-radius: 4px; background: var(--card-background, #fff); color: var(--secondary-text-color, #737373); font: inherit; }\n\tbutton:disabled, select:disabled { opacity: 0.5; cursor: wait; }\n\t.card-form input, .card-form textarea, .card-form select { min-width: 0; box-sizing: border-box; }\n\t.card-form textarea { resize: vertical; }\n\t@media (max-width: 700px) {\n\t\t.header { padding: 1rem; }\n\t\t.board { display: flex; flex-direction: column; padding: 1rem; }\n\t\t.column { width: auto; min-width: 0; max-height: none; }\n\t\t.action-btn { padding: 8px; }\n\t\t.card-title { padding: 4px 0; }\n\t}\n\n\t.action-btn { min-width: 32px; min-height: 32px; }\n\t.card-actions { opacity: 1; }\n\t.load-error button { min-height: 36px; padding: 6px 12px; border: 1px solid var(--border-color, #e5e5e5); border-radius: 4px; background: var(--card-background, #fff); color: var(--body-text-color, #202020); font: inherit; }\n\t@media (max-width: 700px) { .action-btn, .move-select, .save-btn, .cancel-btn { min-height: 36px; } .action-btn { min-width: 36px; } .card-form input, .card-form textarea, .card-form select { font-size: 16px; } }\n</style>",
