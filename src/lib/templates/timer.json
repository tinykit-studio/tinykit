{
  "id": "timer",
  "name": "Focus timer",
  "description": "Run focus and break sessions.",
  "preview": "lucide:timer",
  "tags": [
    "productivity",
    "intermediate",
    "data"
  ],
  "kits": [
    "business",
    "daily"
  ],
  "frontend_code": "<script>\n  import { onDestroy } from 'svelte'\n  import content from '$content'\n  import data from '$data'\n  import Icon from '@iconify/svelte'\n\tconst list_params = { all: true }\n\n  const WORK_TIME = 25 * 60\n  const BREAK_TIME = 5 * 60\n  let time_left = $state(WORK_TIME)\n  let remaining_ms = WORK_TIME * 1000\n  let deadline = 0\n  let interval = null\n  let is_running = $state(false)\n  let is_work = $state(true)\n  let task_name = $state('')\n  let sessions = $state([])\n  let loading = $state(true)\n  let load_error = $state('')\n  let retrying = $state(false)\n  let disposed = false\n  let load_version = 0\n  let pending_sessions = $state([])\n  let saving = $state(false)\n  let save_error = $state('')\n  let status = $state('')\n  let notification_error = $state('')\n  const notification_available = typeof window !== 'undefined' && typeof window.Notification === 'function'\n  let notification_permission = $state(notification_available ? window.Notification.permission : 'unavailable')\n  let current_day = $state(new Date().toDateString())\n  // Update today's history while the timer is idle, including after midnight.\n  const day_interval = typeof document !== 'undefined' ? setInterval(() => { if (!disposed) current_day = new Date().toDateString() }, 60000) : null\n  function session_seconds(value) {\n    const seconds = Number(value)\n    return Number.isFinite(seconds) && seconds >= 0 ? seconds : 0\n  }\n\n  function receive_items(items) {\n    if (disposed) return\n    load_version++\n    sessions = items\n    loading = false\n    load_error = ''\n  }\n\n  function load_failed() {\n    if (disposed) return\n    loading = false\n    load_error = 'Session history could not be loaded.'\n  }\n\n  const unsubscribe = data.sessions.subscribe(receive_items, list_params, load_failed)\n\n  async function retry_load() {\n    if (retrying || disposed) return\n    retrying = true\n    const version = ++load_version\n    try {\n      const items = await data.sessions.list(list_params)\n      if (!disposed && version === load_version) receive_items(items)\n    } catch {\n      if (!disposed && version === load_version) load_failed()\n    } finally {\n      if (!disposed) retrying = false\n    }\n  }\n\n  let today_sessions = $derived.by(() => sessions\n    .filter(session => new Date(session.completed_at).toDateString() === current_day)\n    .sort((a, b) => new Date(b.completed_at) - new Date(a.completed_at)))\n  let total_work_minutes = $derived.by(() => Math.floor(today_sessions\n    .filter(session => session.type === 'work')\n    .reduce((total, session) => total + session_seconds(session.duration), 0) / 60))\n  let progress = $derived.by(() => Math.max(0, Math.min(100, (1 - time_left / (is_work ? WORK_TIME : BREAK_TIME)) * 100)))\n\n  async function request_notification_permission() {\n    if (!notification_available) return\n    notification_error = ''\n    try {\n      notification_permission = await window.Notification.requestPermission()\n    } catch {\n      notification_error = 'Notifications are unavailable in this browser.'\n    }\n  }\n\n  function send_notification(title, body) {\n    if (!notification_available || window.Notification.permission !== 'granted') return\n    try { new window.Notification(title, { body }) } catch { /* The on-screen status remains available. */ }\n  }\n\n  async function save_pending_sessions() {\n    if (saving || pending_sessions.length === 0) return\n    saving = true\n    save_error = ''\n    try {\n      while (pending_sessions.length > 0) {\n        const session = pending_sessions[0]\n        await data.sessions.create(session)\n        pending_sessions = pending_sessions.slice(1)\n      }\n    } catch {\n      save_error = 'Session history could not be saved. Keep this app open and retry.'\n    } finally {\n      saving = false\n    }\n  }\n\n  async function complete_timer() {\n    if (!is_running) return\n    clearInterval(interval)\n    interval = null\n    is_running = false\n    const completed_work = is_work\n    pending_sessions = [...pending_sessions, {\n      task_name: completed_work ? task_name.trim() || 'Focus session' : 'Break',\n      type: completed_work ? 'work' : 'break',\n      duration: completed_work ? WORK_TIME : BREAK_TIME,\n      completed_at: new Date(deadline || Date.now()).toISOString()\n    }]\n    status = completed_work ? content.work_complete_title : content.break_complete_title\n    send_notification(status, completed_work ? content.work_complete_body : content.break_complete_body)\n    is_work = !completed_work\n    remaining_ms = (is_work ? WORK_TIME : BREAK_TIME) * 1000\n    time_left = remaining_ms / 1000\n    current_day = new Date().toDateString()\n    await save_pending_sessions()\n  }\n\n  function tick() {\n    if (!is_running) return\n    current_day = new Date().toDateString()\n    remaining_ms = Math.max(0, deadline - Date.now())\n    time_left = Math.ceil(remaining_ms / 1000)\n    if (remaining_ms === 0) void complete_timer()\n  }\n\n  function toggle_timer() {\n    if (is_running) {\n      tick()\n      if (!is_running) return\n      clearInterval(interval)\n      interval = null\n      is_running = false\n    } else {\n      status = ''\n      current_day = new Date().toDateString()\n      is_running = true\n      deadline = Date.now() + remaining_ms\n      interval = setInterval(tick, 250)\n    }\n  }\n\n  function reset_timer() {\n    clearInterval(interval)\n    interval = null\n    is_running = false\n    remaining_ms = (is_work ? WORK_TIME : BREAK_TIME) * 1000\n    time_left = remaining_ms / 1000\n    status = ''\n  }\n\n  function format_time(seconds) {\n    const value = Math.max(0, Math.ceil(seconds))\n    return `${Math.floor(value / 60).toString().padStart(2, '0')}:${(value % 60).toString().padStart(2, '0')}`\n  }\n\n  function format_history_time(value) {\n    return new Date(value).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })\n  }\n\n  onDestroy(() => { disposed = true; load_version++; clearInterval(interval); clearInterval(day_interval); unsubscribe() })\n</script>\n\n<main class=\"page\">\n  <div class=\"main-column\">\n    <h1>Focus timer</h1>\n    <section class=\"timer\" aria-label=\"Session timer\">\n      <label for=\"task-name\">Working on</label>\n      <input id=\"task-name\" type=\"text\" bind:value={task_name} disabled={is_running} placeholder=\"Name your task (optional)\" maxlength=\"200\" />\n      <p class=\"mode\">{is_work ? content.work_label : content.break_label}</p>\n      <div class=\"time\" role=\"timer\" aria-label={`${format_time(time_left)} remaining`}>{format_time(time_left)}</div>\n      <div class=\"track\" aria-hidden=\"true\"><div style:width={`${progress}%`}></div></div>\n      <div class=\"controls\">\n        <button class=\"primary\" onclick={toggle_timer}>{is_running ? content.pause_button : content.start_button}</button>\n        <button onclick={reset_timer}>{content.reset_button}</button>\n      </div>\n      <p class=\"status\" role=\"status\">{status || (is_running ? 'Session in progress' : time_left < (is_work ? WORK_TIME : BREAK_TIME) ? 'Paused' : 'Ready when you are')}</p>\n      {#if notification_available && notification_permission === 'default'}\n        <button class=\"notification\" onclick={request_notification_permission}><Icon icon=\"lucide:bell\" width={14} /> Enable notifications</button>\n      {:else if notification_permission === 'granted'}\n        <span class=\"notification-note\">Notifications enabled</span>\n      {/if}\n      {#if notification_error}<p class=\"error\" role=\"alert\">{notification_error}</p>{/if}\n    </section>\n    <section class=\"history\" aria-labelledby=\"history-title\">\n      <div class=\"history-header\"><h2 id=\"history-title\">{content.history_title}</h2><span>{total_work_minutes}m {content.focused_label}</span></div>\n      {#if save_error}\n        <div class=\"save-error\" role=\"alert\"><p>{save_error}</p><button onclick={save_pending_sessions} disabled={saving}>{saving ? 'Saving…' : 'Retry save'}</button></div>\n      {:else if saving}<p class=\"muted\" role=\"status\">Saving session…</p>{/if}\n      {#if load_error}<div class=\"load-error\" role=\"alert\"><p>{load_error}</p><button onclick={retry_load} disabled={retrying}>{retrying ? 'Retrying…' : 'Retry loading'}</button></div>{/if}\n      {#if loading && !sessions.length}<p class=\"empty\">{content.loading_message}</p>\n      {:else if today_sessions.length === 0 && !load_error}<p class=\"empty\">{content.no_sessions}</p>\n      {:else}\n        <ul>\n          {#each today_sessions as session (session.id)}\n            <li><Icon icon={session.type === 'work' ? 'lucide:check' : 'lucide:coffee'} width={16} /><div class=\"session-details\"><span>{session.task_name}</span><time datetime={session.completed_at}>{format_history_time(session.completed_at)}</time></div><span class=\"duration\">{Math.floor(session_seconds(session.duration) / 60)}m</span></li>\n          {/each}\n        </ul>\n      {/if}\n    </section>\n  </div>\n</main>\n\n<style>\n  :global(*) { box-sizing: border-box; }\n  .page { min-height: 100vh; padding: 2rem 1.25rem; background: var(--page-background, #fafafa); color: var(--heading-text-color, #202020); font-family: var(--body-font, system-ui, sans-serif); }\n  .main-column { width: 100%; max-width: 440px; margin: 0 auto; }\n  h1 { margin: 0 0 1.5rem; font-size: 1.25rem; font-weight: 600; letter-spacing: -.025em; }\n  .timer { padding: 1.5rem; background: var(--card-background, #fff); border: 1px solid var(--border-color, #e5e5e5); border-radius: var(--card-radius, 6px); }\n  label { display: block; margin-bottom: .5rem; font-size: .8125rem; color: var(--secondary-text-color, #737373); }\n  input { width: 100%; padding: .65rem .75rem; border: 1px solid var(--border-color, #e5e5e5); border-radius: 5px; font: inherit; font-size: .9375rem; background: transparent; color: inherit; }\n  input:disabled { opacity: .75; }\n  .mode { margin: 1.75rem 0 .25rem; text-align: center; font-size: .875rem; color: var(--secondary-text-color, #737373); }\n  .time { text-align: center; color: var(--timer-text-color, #202020); font-size: clamp(3.5rem, 17vw, 4.5rem); font-weight: 500; letter-spacing: -.055em; font-variant-numeric: tabular-nums; line-height: 1.2; }\n  .track { height: 3px; margin: 1.25rem 0 1.5rem; overflow: hidden; background: var(--track-color, #f3f4f6); border-radius: 3px; }\n  .track > div { height: 100%; background: var(--work-color, #404040); }\n  .controls { display: flex; gap: .5rem; }\n  button { display: inline-flex; align-items: center; justify-content: center; gap: .4rem; min-height: 40px; padding: .55rem 1rem; border: 1px solid var(--border-color, #e5e5e5); border-radius: var(--button-radius, 5px); font: inherit; font-size: .875rem; cursor: pointer; background: var(--card-background, #fff); color: inherit; }\n  .controls button { flex: 1; }\n  button.primary { background: var(--button-background, #262626); border-color: var(--button-background, #262626); color: #fff; }\n  button:hover { opacity: .85; }\n  button:disabled { cursor: wait; opacity: .6; }\n  .status { min-height: 1.25rem; margin: 1rem 0 0; text-align: center; font-size: .8125rem; color: var(--secondary-text-color, #737373); }\n  .notification { display: flex; margin: .75rem auto 0; padding: .25rem .4rem; min-height: 32px; border-color: transparent; color: var(--secondary-text-color, #737373); font-size: .75rem; }\n  .notification-note { display: block; margin-top: .75rem; text-align: center; font-size: .75rem; color: var(--secondary-text-color, #737373); }\n  .history { margin-top: 1.75rem; }\n  .history-header { display: flex; justify-content: space-between; gap: .75rem; align-items: baseline; padding-bottom: .75rem; border-bottom: 1px solid var(--border-color, #e5e5e5); }\n  h2 { margin: 0; font-size: .9375rem; font-weight: 600; }\n  .history-header > span, .duration, time, .muted, .empty { font-size: .8125rem; color: var(--secondary-text-color, #737373); }\n  ul { margin: 0; padding: 0; list-style: none; }\n  li { display: flex; gap: .75rem; align-items: center; padding: .9rem 0; border-bottom: 1px solid var(--border-color, #e5e5e5); }\n  .session-details { flex: 1; min-width: 0; display: grid; gap: .2rem; font-size: .875rem; overflow-wrap: anywhere; }\n  .duration { white-space: nowrap; font-variant-numeric: tabular-nums; }\n  .empty { padding: 1rem 0; margin: 0; }\n  .error, .save-error, .load-error { font-size: .8125rem; color: #b91c1c; }\n  .save-error, .load-error { padding: .75rem 0; }\n  .save-error p, .load-error p { margin: 0 0 .5rem; }\n  button:focus-visible, input:focus-visible { outline: 2px solid var(--work-color, #404040); outline-offset: 3px; }\n  @media (max-width: 360px) { .page { padding: 1.25rem .875rem; } .timer { padding: 1.125rem; } }\n</style>\n",
