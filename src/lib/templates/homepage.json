{
  "id": "homepage",
  "name": "Homepage",
  "description": "A personal page with projects and contact details.",
  "preview": "lucide:home",
  "tags": [
    "personal-site",
    "personal",
    "beginner"
  ],
  "kits": [
    "personal-site"
  ],
  "frontend_code": "<script>\n\timport { onDestroy } from 'svelte'\n\timport Icon from '@iconify/svelte'\n\timport content from '$content'\n\timport data from '$data'\n\n\tlet projects = $state([])\n\tlet loading = $state(true)\n\tlet load_error = $state('')\n\tlet retrying_load = $state(false)\n\tlet disposed = false\n\tlet load_revision = 0\n\tlet failed_photo_url = $state('')\n\tlet name = $state('')\n\tlet email = $state('')\n\tlet message = $state('')\n\tlet sending = $state(false)\n\tlet sent = $state(false)\n\tlet error = $state('')\n\n\tfunction safe_url(value) {\n\t\tconst raw = String(value ?? '').trim()\n\t\tif (!raw || /[\\u0000-\\u001f\\u007f]/.test(raw)) return ''\n\t\ttry {\n\t\t\tconst url = new URL(raw)\n\t\t\treturn ['https:', 'http:'].includes(url.protocol) ? url.href : ''\n\t\t} catch { return '' }\n\t}\n\n\tfunction photo_url(value) {\n\t\tconst raw = String(value ?? '').trim()\n\t\treturn raw.startsWith('/') && !raw.startsWith('//') && !/[\\\\\\u0000-\\u001f\\u007f]/.test(raw) ? raw : safe_url(raw)\n\t}\n\n\tfunction email_link(value) {\n\t\tconst address = String(value ?? '').trim()\n\t\treturn /^[^\\s@?&#]+@[^\\s@?&#]+$/.test(address) ? `mailto:${address}` : ''\n\t}\n\n\tfunction initials(value) {\n\t\treturn String(value ?? '').trim().split(/\\s+/).filter(Boolean).slice(0, 2).map(part => part[0]).join('').toUpperCase() || 'A'\n\t}\n\n\tfunction receive_projects(items) {\n\t\tif (disposed) return\n\t\tload_revision += 1\n\t\tprojects = [...new Map((Array.isArray(items) ? items : []).filter(item => item?.id).map(item => [item.id, { ...item }])).values()]\n\t\tloading = false\n\t\tload_error = ''\n\t}\n\n\tfunction fail_projects() {\n\t\tif (disposed) return\n\t\tload_revision += 1\n\t\tloading = false\n\t\tload_error = 'Could not load projects. Please try again.'\n\t}\n\n\tconst unsubscribe = data.projects.subscribe(receive_projects, { all: true }, fail_projects)\n\n\tasync function retry_load() {\n\t\tif (retrying_load || disposed) return\n\t\tretrying_load = true\n\t\tconst revision = load_revision\n\t\ttry {\n\t\t\tconst items = await data.projects.list({ all: true })\n\t\t\tif (!disposed && revision === load_revision) receive_projects(items)\n\t\t} catch {\n\t\t\tif (!disposed && revision === load_revision) fail_projects()\n\t\t} finally {\n\t\t\tif (!disposed) retrying_load = false\n\t\t}\n\t}\n\n\tlet socials = $derived.by(() => [\n\t\t{ name: 'Twitter', icon: 'lucide:twitter', href: safe_url(content.twitter_url) },\n\t\t{ name: 'GitHub', icon: 'lucide:github', href: safe_url(content.github_url) },\n\t\t{ name: 'LinkedIn', icon: 'lucide:linkedin', href: safe_url(content.linkedin_url) },\n\t\t{ name: 'Email', icon: 'lucide:mail', href: email_link(content.email) }\n\t].filter(social => social.href))\n\n\tasync function handle_submit(event) {\n\t\tevent.preventDefault()\n\t\tif (sending || disposed) return\n\t\tconst fields = { name: name.trim(), email: email.trim(), message: message.trim() }\n\t\terror = ''\n\t\tif (!fields.name || !fields.email || !fields.message) {\n\t\t\terror = 'Enter your name, email, and message.'\n\t\t\treturn\n\t\t}\n\t\tif (!/^[^\\s@]+@[^\\s@]+$/.test(fields.email)) {\n\t\t\terror = 'Enter a valid email address.'\n\t\t\treturn\n\t\t}\n\t\tsending = true\n\t\ttry {\n\t\t\tawait data.messages.create({ ...fields, created_at: new Date().toISOString() })\n\t\t\tif (disposed) return\n\t\t\tif (name.trim() === fields.name && email.trim() === fields.email && message.trim() === fields.message) {\n\t\t\t\tsent = true\n\t\t\t\tname = ''\n\t\t\t\temail = ''\n\t\t\t\tmessage = ''\n\t\t\t}\n\t\t} catch {\n\t\t\tif (!disposed) error = content.error_message || 'Could not send your message. Please try again.'\n\t\t} finally {\n\t\t\tif (!disposed) sending = false\n\t\t}\n\t}\n\n\tonDestroy(() => { disposed = true; unsubscribe() })\n</script>\n\n<main class=\"page\">\n\t<div class=\"container\">\n\t\t<header class=\"hero\">\n\t\t\t{#if photo_url(content.photo_url) && failed_photo_url !== photo_url(content.photo_url)}\n\t\t\t\t<img class=\"photo\" src={photo_url(content.photo_url)} alt=\"\" width=\"64\" height=\"64\" onerror={() => failed_photo_url = photo_url(content.photo_url)} />\n\t\t\t{:else}\n\t\t\t\t<span class=\"photo initials\" aria-hidden=\"true\">{initials(content.name)}</span>\n\t\t\t{/if}\n\t\t\t<div class=\"identity\">\n\t\t\t\t<h1>{content.name}</h1>\n\t\t\t\t<p class=\"headline\">{content.headline}</p>\n\t\t\t</div>\n\t\t</header>\n\n\t\t{#if socials.length}\n\t\t\t<nav class=\"socials\" aria-label=\"Profiles and contact\">\n\t\t\t\t{#each socials as social (social.name)}\n\t\t\t\t\t<a href={social.href} target={social.name === 'Email' ? undefined : '_blank'} rel=\"noopener noreferrer\" aria-label={social.name}>\n\t\t\t\t\t\t<Icon icon={social.icon} width={18} />\n\t\t\t\t\t\t<span>{social.name}</span>\n\t\t\t\t\t</a>\n\t\t\t\t{/each}\n\t\t\t</nav>\n\t\t{/if}\n\n\t\t<section class=\"about\" aria-labelledby=\"about-title\">\n\t\t\t<h2 id=\"about-title\">{content.about_title}</h2>\n\t\t\t<p>{content.bio}</p>\n\t\t</section>\n\n\t\t<section class=\"projects\" aria-labelledby=\"projects-title\" aria-busy={loading || retrying_load}>\n\t\t\t<h2 id=\"projects-title\">{content.projects_title}</h2>\n\t\t\t{#if load_error}\n\t\t\t\t<div class=\"load-error\" role=\"alert\">\n\t\t\t\t\t<p>{load_error}</p>\n\t\t\t\t\t<button type=\"button\" class=\"btn-secondary\" onclick={retry_load} disabled={retrying_load}>{retrying_load ? 'Retrying…' : 'Retry'}</button>\n\t\t\t\t</div>\n\t\t\t{/if}\n\t\t\t{#if loading && !projects.length}\n\t\t\t\t<p class=\"muted\" role=\"status\">Loading projects…</p>\n\t\t\t{:else if !projects.length && !load_error}\n\t\t\t\t<p class=\"muted\">No projects published yet.</p>\n\t\t\t{:else}\n\t\t\t\t<div class=\"project-list\">\n\t\t\t\t\t{#each projects as project (project.id)}\n\t\t\t\t\t\t<article class=\"project\">\n\t\t\t\t\t\t\t{#if safe_url(project.url)}\n\t\t\t\t\t\t\t\t<a href={safe_url(project.url)} target=\"_blank\" rel=\"noopener noreferrer\" aria-label={`${content.view_project || 'View project'}: ${project.name || 'Untitled project'}`}>\n\t\t\t\t\t\t\t\t\t<div><h3>{project.name || 'Untitled project'}</h3>{#if project.description}<p>{project.description}</p>{/if}</div>\n\t\t\t\t\t\t\t\t\t<Icon icon=\"lucide:arrow-up-right\" width={18} />\n\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t{:else}\n\t\t\t\t\t\t\t\t<div class=\"project-description\"><h3>{project.name || 'Untitled project'}</h3>{#if project.description}<p>{project.description}</p>{/if}</div>\n\t\t\t\t\t\t\t{/if}\n\t\t\t\t\t\t</article>\n\t\t\t\t\t{/each}\n\t\t\t\t</div>\n\t\t\t{/if}\n\t\t</section>\n\n\t\t<section class=\"contact\" aria-labelledby=\"contact-title\">\n\t\t\t<h2 id=\"contact-title\">{content.contact_title}</h2>\n\t\t\t{#if sent}\n\t\t\t\t<div class=\"success\" role=\"status\">\n\t\t\t\t\t<p>{content.success_message}</p>\n\t\t\t\t\t<button type=\"button\" class=\"btn-secondary\" onclick={() => sent = false}>{content.send_another}</button>\n\t\t\t\t</div>\n\t\t\t{:else}\n\t\t\t\t<form onsubmit={handle_submit} aria-busy={sending}>\n\t\t\t\t\t<div class=\"form-row\">\n\t\t\t\t\t\t<label for=\"contact-name\">Name<input id=\"contact-name\" name=\"name\" type=\"text\" autocomplete=\"name\" placeholder={content.name_placeholder} bind:value={name} disabled={sending} required /></label>\n\t\t\t\t\t\t<label for=\"contact-email\">Email<input id=\"contact-email\" name=\"email\" type=\"email\" autocomplete=\"email\" placeholder={content.email_placeholder} bind:value={email} disabled={sending} required /></label>\n\t\t\t\t\t</div>\n\t\t\t\t\t<label for=\"contact-message\">Message<textarea id=\"contact-message\" name=\"message\" placeholder={content.message_placeholder} bind:value={message} rows=\"4\" disabled={sending} required></textarea></label>\n\t\t\t\t\t{#if error}<p class=\"error\" role=\"alert\">{error}</p>{/if}\n\t\t\t\t\t<button type=\"submit\" class=\"btn-primary\" disabled={sending}>{sending ? 'Sending…' : content.send_button}</button>\n\t\t\t\t</form>\n\t\t\t{/if}\n\t\t</section>\n\t</div>\n</main>\n\n<style>\n\t.page, .page :global(*) { box-sizing: border-box; }\n\t.page { min-height: 100vh; padding: 3rem 1.5rem; background: var(--bg-color, #fafafa); color: var(--heading-color, #202020); font-family: var(--font, system-ui, sans-serif); line-height: 1.5; overflow-wrap: anywhere; }\n\t.container { width: 100%; max-width: 640px; margin: 0 auto; }\n\t.hero { display: flex; align-items: center; gap: 1rem; }\n\t.photo { width: 64px; height: 64px; flex: 0 0 64px; border-radius: 50%; object-fit: cover; border: 1px solid var(--border-color, #e5e5e5); }\n\t.initials { display: grid; place-items: center; font-size: 1.125rem; font-weight: 600; background: var(--card-bg, #fff); color: var(--text-color, #666); }\n\t.identity { min-width: 0; }\n\th1 { margin: 0; font-size: 1.75rem; font-weight: 650; letter-spacing: -0.035em; line-height: 1.2; }\n\t.headline { margin: 0.4rem 0 0; color: var(--text-color, #666); font-size: 0.9375rem; }\n\t.socials { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; margin: 1rem 0 -0.5rem; }\n\t.socials a { display: inline-flex; align-items: center; gap: 0.375rem; min-height: 40px; color: var(--text-color, #666); text-decoration: none; font-size: 0.8125rem; }\n\t.socials a:hover { color: var(--accent-color, #2563eb); }\n\tsection { margin-top: 2.25rem; }\n\tsection h2 { font-size: 0.9375rem; font-weight: 600; margin: 0 0 1rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border-color, #e5e5e5); }\n\t.about p { margin: 0; color: var(--text-color, #666); white-space: pre-line; font-size: 0.9375rem; line-height: 1.75; }\n\t.project + .project { border-top: 1px solid var(--border-color, #e5e5e5); }\n\t.project a, .project-description { display: flex; align-items: center; gap: 1rem; padding: 1rem 0; text-decoration: none; color: inherit; }\n\t.project-description { display: block; }\n\t.project a > div { flex: 1; min-width: 0; }\n\t.project a :global(svg) { flex-shrink: 0; color: var(--text-color, #666); }\n\t.project:first-child a, .project:first-child .project-description { padding-top: 0; }\n\t.project a:hover h3 { color: var(--accent-color, #2563eb); }\n\t.project h3 { margin: 0; font-size: 0.9375rem; font-weight: 600; }\n\t.project p { margin: 0.25rem 0 0; font-size: 0.875rem; color: var(--text-color, #666); }\n\t.contact form { display: flex; flex-direction: column; gap: 1rem; }\n\t.form-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1rem; }\n\tlabel { display: flex; flex-direction: column; gap: 0.375rem; font-size: 0.8125rem; font-weight: 500; }\n\tinput, textarea { width: 100%; min-width: 0; padding: 0.625rem 0.75rem; border: 1px solid var(--border-color, #e5e5e5); border-radius: var(--radius, 6px); background: var(--card-bg, #fff); color: var(--heading-color, #202020); font: inherit; font-size: 1rem; font-weight: 400; }\n\tinput { min-height: 44px; }\n\ttextarea { resize: vertical; min-height: 110px; }\n\tbutton { min-height: 40px; padding: 0.625rem 0.875rem; font: inherit; font-size: 0.8125rem; font-weight: 500; border-radius: var(--radius, 6px); cursor: pointer; }\n\t.btn-primary { align-self: flex-start; border: 1px solid transparent; color: #fff; background: var(--accent-color, #2563eb); }\n\t.btn-primary:hover:not(:disabled) { filter: brightness(0.92); }\n\t.btn-secondary { background: var(--card-bg, #fff); color: var(--heading-color, #202020); border: 1px solid var(--border-color, #e5e5e5); }\n\t.btn-secondary:hover:not(:disabled) { background: var(--hover-bg, #f5f5f5); }\n\tbutton:disabled { cursor: wait; opacity: 0.65; }\n\tinput:disabled, textarea:disabled { opacity: 0.7; }\n\t.success p { margin: 0 0 0.75rem; font-size: 0.9375rem; }\n\t.error, .load-error { color: #b91c1c; font-size: 0.875rem; }\n\t.error { margin: 0; }\n\t.load-error { margin-bottom: 1rem; }\n\t.load-error p { margin: 0 0 0.5rem; }\n\t.muted { margin: 0; color: var(--text-color, #666); font-size: 0.875rem; }\n\t:global(button:focus-visible), :global(a:focus-visible), :global(input:focus-visible), :global(textarea:focus-visible) { outline: 2px solid var(--accent-color, #2563eb); outline-offset: 3px; }\n\t@media (max-width: 500px) { .page { padding: 2rem 1.25rem; } .form-row { grid-template-columns: minmax(0, 1fr); } h1 { font-size: 1.5rem; } }\n\t@media (prefers-reduced-motion: reduce) { .page :global(*) { animation: none !important; transition: none !important; } }\n</style>\n",
