{
  "id": "poll",
  "name": "Poll",
  "description": "Collect votes and display results.",
  "preview": "lucide:bar-chart-3",
  "tags": [
    "social",
    "intermediate",
    "realtime"
  ],
  "kits": [
    "community",
    "launch",
    "feedback",
    "club",
    "event"
  ],
  "frontend_code": "<script>\n  import { onMount, onDestroy } from 'svelte'\n  import Icon from '@iconify/svelte'\n  import content from '$content'\n  import data from '$data'\n\n  const list_params = { all: true }\n  let options = $state([])\n  let loading = $state(true)\n  let retrying_load = $state(false)\n  let load_error = $state('')\n  let vote_error = $state('')\n  let storage_warning = $state('')\n  let voted = $state(false)\n  let selected_id = $state(null)\n  let saving = $state(false)\n  let changing_vote = $state(false)\n  let disposed = false\n  let load_revision = 0\n  let storage_key = null\n\n  function vote_count(value) { const number = Number(value); return Number.isFinite(number) ? Math.max(0, Math.floor(number)) : 0 }\n  function receive_options(items) {\n    if (disposed) return\n    load_revision += 1\n    options = [...new Map((Array.isArray(items) ? items : []).filter(item => item && typeof item.id === 'string' && item.id).map(item => [item.id, { ...item }])).values()].sort((a, b) => order_value(a.order) - order_value(b.order))\n    loading = false\n    load_error = ''\n    reconcile_vote()\n  }\n  function order_value(value) {\n    if (value === null || value === undefined || String(value).trim() === '') return Infinity\n    const number = Number(value)\n    return Number.isFinite(number) ? number : Infinity\n  }\n  function reconcile_vote() {\n    if (!saving && selected_id && !options.some(option => option.id === selected_id && vote_count(option.votes) > 0)) {\n      selected_id = null\n      voted = false\n      changing_vote = false\n      remember_vote(null)\n    }\n  }\n  function failed_load() { if (!disposed) { load_revision += 1; loading = false; load_error = 'Could not load the poll. Please try again.' } }\n  const unsubscribe = data.options.subscribe(receive_options, list_params, failed_load)\n  onDestroy(() => { disposed = true; unsubscribe() })\n\n  function remember_vote(id) {\n    if (!storage_key) return\n    try {\n      if (id) localStorage.setItem(storage_key, id)\n      else localStorage.removeItem(storage_key)\n      storage_warning = ''\n    } catch { storage_warning = 'This browser cannot remember your choice after you leave this page.' }\n  }\n  function restore_vote() {\n    if (!storage_key) return\n    changing_vote = false\n    try {\n      const stored = localStorage.getItem(storage_key)\n      if (stored && (loading || options.some(option => option.id === stored && vote_count(option.votes) > 0))) { voted = true; selected_id = stored }\n      else { voted = false; selected_id = null; if (stored) remember_vote(null) }\n    } catch { storage_warning = 'This browser cannot remember your choice after you leave this page.' }\n  }\n  onMount(() => {\n    // Gallery and Studio previews use about:srcdoc and keep their choices in memory.\n    if (window.location.protocol !== 'about:') storage_key = `tinykit:poll:${window.location.pathname}`\n    restore_vote()\n    const on_storage = event => { if ((event.key === storage_key || event.key === null) && !saving) restore_vote() }\n    window.addEventListener('storage', on_storage)\n    return () => window.removeEventListener('storage', on_storage)\n  })\n\n  async function retry_load() {\n    if (disposed || retrying_load || saving) return\n    retrying_load = true\n    const revision = load_revision\n    try { const rows = await data.options.list(list_params); if (!disposed && revision === load_revision) receive_options(rows) }\n    catch { if (!disposed && revision === load_revision) failed_load() }\n    finally { if (!disposed) retrying_load = false }\n  }\n  let total_votes = $derived.by(() => options.reduce((sum, option) => sum + vote_count(option.votes), 0))\n  function get_percentage(votes) { return total_votes > 0 ? Math.round(vote_count(votes) / total_votes * 100) : 0 }\n  function receive_option(record) { if (!disposed) options = options.map(option => option.id === record.id ? { ...option, ...record } : option) }\n\n  async function vote(option_id) {\n    if (disposed || loading || load_error || saving || (voted && !changing_vote) || !options.some(option => option.id === option_id)) return\n    if (voted && selected_id === option_id) { changing_vote = false; return }\n    const previous_counts = new Map(options.map(option => [option.id, vote_count(option.votes)]))\n    saving = true\n    vote_error = ''\n    try {\n      const changes = voted && selected_id ? [{ id: selected_id, field: 'votes', delta: -1 }] : []\n      changes.push({ id: option_id, field: 'votes', delta: 1 })\n      const rows = await data.options.adjust(changes)\n      if (disposed) return\n      for (const row of rows) {\n        const current = options.find(option => option.id === row.id)\n        if (current && vote_count(current.votes) === previous_counts.get(row.id)) receive_option(row)\n      }\n      if (!options.some(option => option.id === option_id)) {\n        selected_id = null\n        voted = false\n        changing_vote = false\n        remember_vote(null)\n        vote_error = 'This option is no longer available. Please choose another.'\n        return\n      }\n      selected_id = option_id\n      voted = true\n      changing_vote = false\n      remember_vote(option_id)\n    } catch { if (!disposed) vote_error = 'Your vote could not be saved. Please try again.' }\n    finally { if (!disposed) { saving = false; reconcile_vote() } }\n  }\n\n  function reset_vote() {\n    if (disposed || loading || load_error || saving || !voted || !selected_id) return\n    changing_vote = !changing_vote\n    vote_error = ''\n  }\n\n</script>\n\n<main class=\"page\">\n  <section class=\"container\" aria-labelledby=\"poll-question\">\n    <header class=\"poll-header\">\n      <span class=\"eyebrow\"><Icon icon=\"lucide:bar-chart-2\" width={16} />Poll</span>\n      <h1 id=\"poll-question\">{content.poll_question}</h1>\n      {#if content.poll_description}<p class=\"description\">{content.poll_description}</p>{/if}\n    </header>\n    {#if loading}<p class=\"loading\" role=\"status\">Loading poll…</p>{/if}\n    {#if load_error}<div class=\"load-error\" role=\"alert\"><p>{load_error}</p><button type=\"button\" class=\"text-button\" disabled={retrying_load} onclick={retry_load}>{retrying_load ? 'Retrying…' : 'Try again'}</button></div>{/if}\n    {#if !loading && !load_error && options.length === 0}<p class=\"empty\">No options yet.</p>{/if}\n    {#if !loading && options.length > 0}\n      <div class=\"options\" aria-busy={saving}>\n        {#each options as option (option.id)}\n          <button type=\"button\" class=\"option\" class:selected={selected_id === option.id} onclick={() => vote(option.id)} disabled={(voted && !changing_vote) || saving || Boolean(load_error)} aria-pressed={selected_id === option.id}>\n            {#if voted}<span class=\"progress-bar\" class:selected={selected_id === option.id} style:width=\"{get_percentage(option.votes)}%\" aria-hidden=\"true\"></span>{/if}\n            <span class=\"option-content\"><span class=\"option-text\">{option.text || 'Untitled option'}</span>{#if voted}<span class=\"option-stats\"><span class=\"votes\">{vote_count(option.votes)} {vote_count(option.votes) === 1 ? 'vote' : 'votes'}</span><span class=\"percentage\">{get_percentage(option.votes)}%</span>{#if selected_id === option.id}<Icon icon=\"lucide:check\" width={16} aria-label=\"Your choice\" />{/if}</span>{/if}</span>\n          </button>\n        {/each}\n      </div>\n      {#if changing_vote}<p class=\"change-hint\" role=\"status\">Choose another option to change your vote.</p>{/if}\n      {#if vote_error}<p class=\"error\" role=\"alert\">{vote_error}</p>{/if}\n      <footer class=\"poll-footer\"><p class=\"total\">{total_votes} {total_votes === 1 ? content.total_vote_singular : content.total_votes_label}</p>{#if voted}<button type=\"button\" class=\"text-button\" disabled={saving || Boolean(load_error)} onclick={reset_vote}>{saving ? 'Saving…' : changing_vote ? 'Keep my vote' : content.change_vote_text}</button>{:else if saving}<span class=\"saving\" role=\"status\">Saving vote…</span>{/if}</footer>\n      {#if !load_error}<p class=\"realtime\">{content.realtime_label}</p>{/if}\n      {#if storage_warning}<p class=\"storage-warning\" role=\"status\">{storage_warning}</p>{/if}\n    {/if}\n  </section>\n</main>\n\n<style>\n  :global(*) { box-sizing: border-box; }\n  .page { min-height: 100vh; min-height: 100dvh; padding: 48px 20px; display: grid; place-items: center; background: var(--page-background, #fafafa); color: var(--body-text-color, #202020); font-family: var(--body-font, system-ui, sans-serif); }\n  .container { width: 100%; max-width: 520px; min-width: 0; padding: 28px; background: var(--card-background, #fff); border: 1px solid var(--option-border, #e5e5e5); border-radius: var(--card-radius, 6px); }\n  .eyebrow { display: flex; align-items: center; gap: 7px; color: var(--secondary-text-color, #737373); font-size: .8rem; }\n  h1 { margin: 18px 0 0; color: var(--heading-text-color, #202020); font-size: 1.5rem; line-height: 1.3; font-weight: 650; letter-spacing: -.025em; overflow-wrap: anywhere; }\n  .description { color: var(--secondary-text-color, #737373); margin: 12px 0 0; font-size: .9rem; line-height: 1.6; overflow-wrap: anywhere; }\n  .poll-header { margin-bottom: 24px; }\n  .options { display: flex; flex-direction: column; gap: 8px; }\n  button { font: inherit; cursor: pointer; }\n  .option { width: 100%; position: relative; padding: 14px; min-height: 50px; border: 1px solid var(--option-border, #e5e5e5); border-radius: var(--option-radius, 5px); background: var(--card-background, #fff); color: var(--body-text-color, #202020); text-align: left; overflow: hidden; }\n  .option:hover:not(:disabled), .option.selected { border-color: var(--accent-color, #2563eb); }\n  .option:disabled { cursor: default; opacity: 1; }\n  .option-content { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 14px; z-index: 1; }\n  .option-text { min-width: 0; overflow-wrap: anywhere; font-size: .9rem; font-weight: 500; line-height: 1.4; }\n  .option-stats { flex-shrink: 0; display: flex; align-items: center; gap: 10px; color: var(--heading-text-color, #202020); }\n  .votes { font-size: .75rem; color: var(--secondary-text-color, #737373); white-space: nowrap; }\n  .percentage { min-width: 2.5em; text-align: right; font-size: .85rem; font-weight: 600; font-variant-numeric: tabular-nums; }\n  .progress-bar { position: absolute; inset: 0 auto 0 0; background: var(--progress-background, #f1f1f1); pointer-events: none; }\n  .progress-bar.selected { background: var(--progress-selected, #e8eefb); }\n  .poll-footer { display: flex; align-items: center; flex-wrap: wrap; justify-content: space-between; gap: 8px 16px; margin-top: 20px; padding-top: 12px; border-top: 1px solid var(--option-border, #e5e5e5); }\n  .total, .saving { margin: 0; color: var(--secondary-text-color, #737373); font-size: .8rem; }\n  .text-button { min-height: 40px; padding: 8px 0; border: 0; background: none; color: var(--accent-color, #2563eb); font-size: .8rem; text-decoration: underline; text-underline-offset: 3px; }\n  .text-button:disabled { opacity: .55; cursor: default; }\n  .realtime { color: var(--secondary-text-color, #737373); font-size: .75rem; margin: 12px 0 0; }\n  .loading, .empty { color: var(--secondary-text-color, #737373); font-size: .875rem; margin: 32px 0; }\n  .error, .load-error { color: #b91c1c; font-size: .85rem; line-height: 1.5; }\n  .error { margin: 14px 0 0; }\n  .load-error p { margin: 0; }\n  .change-hint { color: var(--secondary-text-color, #737373); font-size: .8rem; line-height: 1.5; margin: 14px 0 0; }\n  .storage-warning { color: var(--secondary-text-color, #737373); font-size: .75rem; line-height: 1.5; margin: 12px 0 0; }\n  :global(button:focus-visible), :global(a:focus-visible) { outline: 2px solid var(--accent-color, #2563eb); outline-offset: 3px; }\n  @media (max-width: 480px) { .page { padding: 24px 16px; } .container { padding: 22px 18px; } h1 { font-size: 1.35rem; } .option-content { flex-wrap: wrap; gap: 8px; } .option-stats { width: 100%; justify-content: flex-end; } .option-text { width: 100%; } }\n  @media (prefers-reduced-motion: reduce) { :global(*), :global(*::before), :global(*::after) { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; } }\n</style>\n",
