{
  "id": "bookmarks",
  "name": "Bookmarks",
  "description": "Save links with tags and search.",
  "preview": "lucide:bookmark",
  "tags": [
    "productivity",
    "intermediate",
    "data"
  ],
  "kits": [
    "collections",
    "feeds",
    "personal-site"
  ],
  "frontend_code": "<script>\n\timport Icon from '@iconify/svelte'\n\timport { flip } from 'svelte/animate'\n\timport { onDestroy } from 'svelte'\n\timport { proxy } from '$tinykit'\n\timport content from '$content'\n\timport data from '$data'\n\tconst list_params = { all: true }\n\n\tlet bookmarks = $state([])\n\tlet loading = $state(true)\n\tlet load_error = $state('')\n\tlet retrying_load = $state(false)\n\tlet disposed = false\n\tlet load_request = 0\n\tlet search = $state('')\n\tlet filter_tag = $state('')\n\tlet fetching_meta = $state(false)\n\tlet saving = $state(false)\n\tlet reordering = $state(false)\n\tlet deleting_ids = $state([])\n\tlet action_error = $state('')\n\tlet view_mode = $state(read_view_mode())\n\tlet new_url = $state('')\n\tlet form_error = $state('')\n\tlet new_title = $state('')\n\tlet new_description = $state('')\n\tlet new_tags = $state('')\n\tlet new_favicon = $state('')\n\tlet new_og_image = $state('')\n\tlet dragging_id = $state(null)\n\tlet drag_over_id = $state(null)\n\tlet dialog_el = $state(null)\n\tlet metadata_request = 0\n\tlet metadata_url = ''\n\tlet form_version = 0\n\n\tfunction read_view_mode() {\n\t\ttry { return localStorage.getItem('bookmarks_view_mode') === 'cards' ? 'cards' : 'list' }\n\t\tcatch { return 'list' }\n\t}\n\tfunction set_view_mode(mode) {\n\t\tview_mode = mode\n\t\ttry { localStorage.setItem('bookmarks_view_mode', mode) } catch {}\n\t}\n\tfunction open_dialog() { dialog_el?.showModal(); dialog_el?.querySelector('#bookmark-url')?.focus() }\n\tfunction close_dialog() {\n\t\tif (dialog_el?.open) dialog_el.close()\n\t\telse reset_form()\n\t}\n\tfunction reset_form() {\n\t\tmetadata_request += 1\n\t\tform_version += 1\n\t\tfetching_meta = false\n\t\tform_error = ''\n\t\tnew_url = ''; new_title = ''; new_description = ''; new_tags = ''\n\t\tnew_favicon = ''; new_og_image = ''\n\t}\n\tfunction parse_tags(value = '') {\n\t\treturn [...new Set(String(value ?? '').split(',').map(tag => tag.trim()).filter(Boolean))]\n\t}\n\tfunction receive_bookmarks(items) {\n\t\tif (disposed) return\n\t\tload_request += 1\n\t\tbookmarks = [...items].sort((a, b) => (a.order ?? 999) - (b.order ?? 999))\n\t\tloading = false\n\t\tload_error = ''\n\t}\n\tfunction load_failed() {\n\t\tif (disposed) return\n\t\tloading = false\n\t\tload_error = 'Could not load bookmarks. Please try again.'\n\t}\n\tconst unsubscribe = data.bookmarks.subscribe(receive_bookmarks, list_params, load_failed)\n\tasync function retry_load() {\n\t\tif (retrying_load || disposed) return\n\t\tconst request = ++load_request\n\t\tretrying_load = true\n\t\ttry {\n\t\t\tconst items = await data.bookmarks.list(list_params)\n\t\t\tif (!disposed && request === load_request) receive_bookmarks(items)\n\t\t} catch { if (!disposed && request === load_request) load_failed() }\n\t\tfinally { if (!disposed) retrying_load = false }\n\t}\n\tlet all_tags = $derived.by(() => [...new Set(bookmarks.flatMap(bookmark => parse_tags(bookmark.tags)))].sort())\n\tlet tag_counts = $derived.by(() => {\n\t\tconst counts = Object.create(null)\n\t\tfor (const bookmark of bookmarks) for (const tag of parse_tags(bookmark.tags)) counts[tag] = (counts[tag] || 0) + 1\n\t\treturn counts\n\t})\n\tlet filtered_bookmarks = $derived.by(() => {\n\t\tconst query = search.trim().toLowerCase()\n\t\treturn bookmarks.filter(bookmark => {\n\t\t\tconst tags = parse_tags(bookmark.tags)\n\t\t\tconst matches_search = !query || [bookmark.title, bookmark.url, bookmark.description, ...tags].some(value => (value || '').toLowerCase().includes(query))\n\t\t\treturn matches_search && (!filter_tag || tags.includes(filter_tag))\n\t\t})\n\t})\n\tfunction get_domain(url) {\n\t\ttry { return new URL(url).hostname.replace(/^www\\./, '') } catch { return url }\n\t}\n\tfunction safe_url(value) {\n\t\ttry { const url = new URL(value); return ['http:', 'https:'].includes(url.protocol) ? url.href : null } catch { return null }\n\t}\n\tfunction get_proxied_image(url) { return safe_url(url) ? proxy.url(url) : null }\n\tasync function add_bookmark() {\n\t\tif (saving) return\n\t\tform_error = ''\n\t\tconst href = safe_url(new_url.trim())\n\t\tif (!href) { form_error = 'Enter a valid http or https URL.'; return }\n\t\tconst url = new URL(href)\n\t\tconst version = form_version\n\t\tsaving = true\n\t\ttry {\n\t\t\tawait data.bookmarks.create({\n\t\t\t\tid: crypto.randomUUID(), url: url.href,\n\t\t\t\ttitle: new_title.trim() || get_domain(url.href), description: new_description.trim(),\n\t\t\t\ttags: parse_tags(new_tags).join(', '), favicon: safe_url(new_favicon) || url.origin + '/favicon.ico',\n\t\t\t\tog_image: safe_url(new_og_image) || '',\n\t\t\t\torder: Math.max(-1, ...bookmarks.map(bookmark => Number.isFinite(Number(bookmark.order)) ? Number(bookmark.order) : -1)) + 1,\n\t\t\t\tcreated_at: new Date().toISOString()\n\t\t\t})\n\t\t\tif (version === form_version) close_dialog()\n\t\t} catch { if (version === form_version) form_error = 'Could not save bookmark. Please try again.' }\n\t\tfinally { saving = false }\n\t}\n\tasync function delete_bookmark(id) {\n\t\tif (deleting_ids.includes(id)) return\n\t\tdeleting_ids = [...deleting_ids, id]\n\t\taction_error = ''\n\t\ttry { await data.bookmarks.delete(id) }\n\t\tcatch { action_error = 'Could not delete bookmark. Please try again.' }\n\t\tfinally { deleting_ids = deleting_ids.filter(value => value !== id) }\n\t}\n\tfunction clear_filters() { search = ''; filter_tag = '' }\n\tfunction handle_keydown(event) {\n\t\tif (event.key === 'Enter' && (event.metaKey || event.ctrlKey)) { event.preventDefault(); add_bookmark() }\n\t}\n\tasync function handle_url_paste(event) {\n\t\tconst pasted = (event.clipboardData?.getData('text') || '').trim()\n\t\tif (!safe_url(pasted)) return\n\t\tconst request = ++metadata_request\n\t\tmetadata_url = pasted\n\t\tfetching_meta = true\n\t\tnew_favicon = ''; new_og_image = ''\n\t\ttry {\n\t\t\tconst html = await proxy.text(pasted)\n\t\t\tif (request !== metadata_request || safe_url(new_url.trim()) !== safe_url(pasted)) return\n\t\t\tconst doc = new DOMParser().parseFromString(html, 'text/html')\n\t\t\tconst title = doc.querySelector('meta[property=\"og:title\"]')?.content || doc.querySelector('title')?.textContent\n\t\t\tconst description = doc.querySelector('meta[property=\"og:description\"]')?.content || doc.querySelector('meta[name=\"description\"]')?.content\n\t\t\tconst image = doc.querySelector('meta[property=\"og:image\"]')?.content\n\t\t\tconst icon = doc.querySelector('link[rel=\"icon\"], link[rel=\"shortcut icon\"], link[rel*=\"icon\"]')?.getAttribute('href')\n\t\t\tif (title && !new_title) new_title = title.trim()\n\t\t\tif (description && !new_description) new_description = description.trim()\n\t\t\tif (image) new_og_image = safe_url(new URL(image, pasted).href) || ''\n\t\t\tnew_favicon = icon ? safe_url(new URL(icon, pasted).href) || '' : new URL(pasted).origin + '/favicon.ico'\n\t\t} catch { /* Metadata is optional; the entered link can always be saved. */ }\n\t\tfinally { if (request === metadata_request) fetching_meta = false }\n\t}\n\tfunction url_changed(value) {\n\t\tif (safe_url(value.trim()) === safe_url(metadata_url)) return\n\t\tmetadata_request += 1\n\t\tfetching_meta = false\n\t\tnew_favicon = ''; new_og_image = ''\n\t}\n\tfunction handle_drag_start(event, id) {\n\t\tif (reordering) { event.preventDefault(); return }\n\t\tdragging_id = id\n\t\tevent.dataTransfer.effectAllowed = 'move'\n\t\tevent.dataTransfer.setData('text/plain', id)\n\t}\n\tfunction handle_drag_over(event, id) { event.preventDefault(); if (id !== dragging_id) drag_over_id = id }\n\tfunction handle_drag_leave() { drag_over_id = null }\n\tfunction handle_drag_end() { dragging_id = null; drag_over_id = null }\n\tasync function reorder_bookmark(id, target_id) {\n\t\tif (reordering || id === target_id) return\n\t\tconst from = bookmarks.findIndex(bookmark => bookmark.id === id)\n\t\tconst to = bookmarks.findIndex(bookmark => bookmark.id === target_id)\n\t\tif (from < 0 || to < 0) return\n\t\tconst reordered = [...bookmarks]\n\t\tconst [moved] = reordered.splice(from, 1)\n\t\treordered.splice(to, 0, moved)\n\t\treordering = true\n\t\taction_error = ''\n\t\ttry {\n\t\t\tfor (let index = 0; index < reordered.length; index++) {\n\t\t\t\tif (reordered[index].order !== index) await data.bookmarks.update(reordered[index].id, { order: index })\n\t\t\t}\n\t\t} catch { action_error = 'Could not finish reordering bookmarks. Please try again.' }\n\t\tfinally { reordering = false; handle_drag_end() }\n\t}\n\tasync function move_bookmark(id, direction) {\n\t\tconst index = filtered_bookmarks.findIndex(bookmark => bookmark.id === id)\n\t\tconst target = filtered_bookmarks[index + direction]\n\t\tif (target) await reorder_bookmark(id, target.id)\n\t}\n\tasync function handle_drop(event, target_id) {\n\t\tevent.preventDefault()\n\t\tif (dragging_id) await reorder_bookmark(dragging_id, target_id)\n\t\thandle_drag_end()\n\t}\n\tonDestroy(() => { disposed = true; load_request += 1; unsubscribe(); metadata_request += 1 })\n</script>\n\n<div class=\"page\">\n\t<header class=\"header\">\n\t\t<h1>{content.app_title}</h1>\n\t\t<div class=\"header-center\">\n\t\t\t<div class=\"search-box\">\n\t\t\t\t<Icon icon=\"lucide:search\" width={18} />\n\t\t\t\t<input\n\t\t\t\t\ttype=\"search\" aria-label=\"Search bookmarks\"\n\t\t\t\t\tbind:value={search}\n\t\t\t\t\tplaceholder={content.search_placeholder}\n\t\t\t\t/>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class=\"header-right\">\n\t\t\t<div class=\"view-toggle\">\n\t\t\t\t<button \n\t\t\t\t\tclass=\"view-btn\" \n\t\t\t\t\tclass:active={view_mode === 'list'}\n\t\t\t\t\tonclick={() => set_view_mode('list')}\n\t\t\t\t\ttitle=\"List view\" aria-label=\"List view\" aria-pressed={view_mode === 'list'}\n\t\t\t\t>\n\t\t\t\t\t<Icon icon=\"lucide:list\" width={18} />\n\t\t\t\t</button>\n\t\t\t\t<button \n\t\t\t\t\tclass=\"view-btn\" \n\t\t\t\t\tclass:active={view_mode === 'cards'}\n\t\t\t\t\tonclick={() => set_view_mode('cards')}\n\t\t\t\t\ttitle=\"Card view\" aria-label=\"Card view\" aria-pressed={view_mode === 'cards'}\n\t\t\t\t>\n\t\t\t\t\t<Icon icon=\"lucide:layout-grid\" width={18} />\n\t\t\t\t</button>\n\t\t\t</div>\n\t\t\t<button class=\"add-btn\" onclick={open_dialog}>\n\t\t\t\t<Icon icon={'lucide:plus'} width={20} />\n\t\t\t\t{content.add_button}\n\t\t\t</button>\n\t\t</div>\n\t</header>\n\n\t<dialog bind:this={dialog_el} class=\"dialog\" aria-labelledby=\"bookmark-dialog-title\" onclose={reset_form}>\n\t\t<div class=\"dialog-header\">\n\t\t\t<h2 id=\"bookmark-dialog-title\">Add bookmark</h2>\n\t\t\t<button class=\"dialog-close\" aria-label=\"Close\" onclick={close_dialog}>\n\t\t\t\t<Icon icon=\"lucide:x\" width={20} />\n\t\t\t</button>\n\t\t</div>\n\t\t<div class=\"form-container\">\n\t\t\t<form class=\"form\" onsubmit={(event) => { event.preventDefault(); add_bookmark() }} novalidate>\n\t\t\t\t<label for=\"bookmark-url\">URL</label>\n\t\t\t\t<input onkeydown={handle_keydown} id=\"bookmark-url\" disabled={saving} required aria-invalid={!!form_error} aria-describedby={form_error ? 'bookmark-form-error' : undefined}\n\t\t\t\t\ttype=\"url\"\n\t\t\t\t\tbind:value={new_url}\n\t\t\t\t\tplaceholder={content.url_placeholder}\n\t\t\t\t\tonpaste={handle_url_paste}\n\t\t\t\t\toninput={(event) => url_changed(event.target.value)}\n\t\t\t\t/>\n\t\t\t\t<label for=\"bookmark-title\">Title <span>(optional)</span></label>\n\t\t\t\t<input onkeydown={handle_keydown} id=\"bookmark-title\" disabled={saving}\n\t\t\t\t\ttype=\"text\"\n\t\t\t\t\tbind:value={new_title}\n\t\t\t\t\tplaceholder={content.title_placeholder}\n\t\t\t\t/>\n\t\t\t\t<label for=\"bookmark-description\">Description <span>(optional)</span></label>\n\t\t\t\t<input onkeydown={handle_keydown} id=\"bookmark-description\" disabled={saving}\n\t\t\t\t\ttype=\"text\"\n\t\t\t\t\tbind:value={new_description}\n\t\t\t\t\tplaceholder={content.description_placeholder}\n\t\t\t\t/>\n\t\t\t\t<label for=\"bookmark-tags\">Tags <span>(optional)</span></label>\n\t\t\t\t<input onkeydown={handle_keydown} id=\"bookmark-tags\" disabled={saving}\n\t\t\t\t\ttype=\"text\"\n\t\t\t\t\tbind:value={new_tags}\n\t\t\t\t\tplaceholder={content.tags_placeholder}\n\t\t\t\t/>\n\t\t\t\t{#if fetching_meta}<p class=\"form-hint\" role=\"status\">Fetching page details…</p>{/if}\n\t\t\t\t{#if new_og_image}\n\t\t\t\t\t<div class=\"preview-image\">\n\t\t\t\t\t\t<img src={get_proxied_image(new_og_image)} alt=\"Preview\" />\n\t\t\t\t\t</div>\n\t\t\t\t{/if}\n\t\t\t\t{#if form_error}<p id=\"bookmark-form-error\" role=\"alert\" class=\"form-error\">{form_error}</p>{/if}\n\t\t\t\t<button class=\"submit-btn\" type=\"submit\" disabled={saving}>{saving ? 'Saving…' : content.save_button}</button>\n\t\t\t</form>\n\t\t</div>\n\t</dialog>\n\n\t<div class=\"layout\">\n\t\t<aside class=\"sidebar\">\n\t\t\t<div class=\"sidebar-section\">\n\t\t\t\t<span class=\"sidebar-label\">Filter by tag</span>\n\t\t\t\t<button \n\t\t\t\t\tclass=\"sidebar-tag\" \n\t\t\t\t\tclass:active={!filter_tag} aria-pressed={!filter_tag}\n\t\t\t\t\tonclick={() => filter_tag = ''}\n\t\t\t\t>\n\t\t\t\t\tAll Bookmarks\n\t\t\t\t\t<span class=\"tag-count\">{bookmarks.length}</span>\n\t\t\t\t</button>\n\t\t\t\t{#each all_tags as tag (tag)}\n\t\t\t\t\t<button \n\t\t\t\t\t\tclass=\"sidebar-tag\" \n\t\t\t\t\t\tclass:active={filter_tag === tag} aria-pressed={filter_tag === tag}\n\t\t\t\t\t\tonclick={() => filter_tag = tag}\n\t\t\t\t\t>\n\t\t\t\t\t\t#{tag}\n\t\t\t\t\t\t<span class=\"tag-count\">{tag_counts[tag] || 0}</span>\n\t\t\t\t\t</button>\n\t\t\t\t{/each}\n\t\t\t</div>\n\t\t</aside>\n\n\t\t<main class=\"main-content\">\n\t\t\t{#if load_error}<div class=\"load-error\" role=\"alert\"><p>{load_error}</p><button onclick={retry_load} disabled={retrying_load}>{retrying_load ? 'Retrying…' : 'Retry'}</button></div>{/if}\n\t\t\t{#if action_error}<div class=\"action-error\" role=\"alert\">{action_error}<button onclick={() => action_error = ''} aria-label=\"Dismiss error\"><Icon icon=\"lucide:x\" width={16} /></button></div>{/if}\n\t\t\t{#if loading}\n\t\t\t\t<div class=\"loading\" role=\"status\" aria-label=\"Loading bookmarks\">\n\t\t\t\t\t<Icon icon=\"lucide:loader-2\" width={24} class=\"spin\" />\n\t\t\t\t</div>\n\t\t\t{:else if filtered_bookmarks.length === 0 && load_error}\n\t\t\t\t<!-- The load error above provides the retry action. -->\n\t\t\t{:else if filtered_bookmarks.length === 0}\n\t\t\t\t<div class=\"empty\">\n\t\t\t\t\t<Icon icon=\"lucide:bookmark-plus\" width={48} />\n\t\t\t\t\t<p>{search || filter_tag ? content.no_results : content.empty_state}</p>\n\t\t\t\t\t{#if search || filter_tag}<button class=\"empty-action\" onclick={clear_filters}>Clear filters</button>{:else}<button class=\"empty-action\" onclick={open_dialog}>{content.add_button}</button>{/if}\n\t\t\t\t</div>\n\t\t\t{:else if view_mode === 'cards'}\n\t\t\t\t<div class=\"bookmarks cards-view\" role=\"list\">\n\t\t\t\t\t{#each filtered_bookmarks as bookmark (bookmark.id)}\n\t\t\t\t\t\t<div \n\t\t\t\t\t\t\tclass=\"card\" role=\"listitem\"\n\t\t\t\t\t\t\tclass:dragging={dragging_id === bookmark.id}\n\t\t\t\t\t\t\tclass:drag-over={drag_over_id === bookmark.id}\n\t\t\t\t\t\t\tdraggable=\"true\"\n\t\t\t\t\t\t\tondragstart={(e) => handle_drag_start(e, bookmark.id)}\n\t\t\t\t\t\t\tondragover={(e) => handle_drag_over(e, bookmark.id)}\n\t\t\t\t\t\t\tondragleave={handle_drag_leave}\n\t\t\t\t\t\t\tondrop={(e) => handle_drop(e, bookmark.id)}\n\t\t\t\t\t\t\tondragend={handle_drag_end}\n\t\t\t\t\t\t\tanimate:flip={{ duration: 200 }}\n\t\t\t\t\t\t>\n\t\t\t\t\t\t\t{#if bookmark.og_image}\n\t\t\t\t\t\t\t\t<div class=\"card-image\">\n\t\t\t\t\t\t\t\t\t<img src={get_proxied_image(bookmark.og_image)} alt=\"\" />\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t{/if}\n\t\t\t\t\t\t\t<div class=\"card-body\">\n\t\t\t\t\t\t\t\t<div class=\"card-header\">\n\t\t\t\t\t\t\t\t\t<a class=\"card-title\" href={safe_url(bookmark.url)} target=\"_blank\" rel=\"noopener noreferrer\">{bookmark.title || get_domain(bookmark.url)}</a>\n\t\t\t\t\t\t\t\t\t<div class=\"row-actions\">\n\t\t\t\t\t\t\t\t<button class=\"move-btn\" aria-label=\"Move {bookmark.title || 'bookmark'} up\" title=\"Move up\" disabled={reordering || filtered_bookmarks[0]?.id === bookmark.id} onclick={() => move_bookmark(bookmark.id, -1)}><Icon icon=\"lucide:chevron-up\" width={16} /></button>\n\t\t\t\t\t\t\t\t<button class=\"move-btn\" aria-label=\"Move {bookmark.title || 'bookmark'} down\" title=\"Move down\" disabled={reordering || filtered_bookmarks[filtered_bookmarks.length - 1]?.id === bookmark.id} onclick={() => move_bookmark(bookmark.id, 1)}><Icon icon=\"lucide:chevron-down\" width={16} /></button>\n\t\t\t\t\t\t\t\t<button \n\t\t\t\t\t\t\t\t\t\tclass=\"delete-btn\" aria-label=\"Delete {bookmark.title}\" disabled={deleting_ids.includes(bookmark.id)} \n\t\t\t\t\t\t\t\t\t\tonclick={(e) => { e.preventDefault(); e.stopPropagation(); delete_bookmark(bookmark.id) }}\n\t\t\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t\t\t<Icon icon=\"lucide:x\" width={16} />\n\t\t\t\t\t\t\t\t\t</button></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<a href={safe_url(bookmark.url)} target=\"_blank\" rel=\"noopener\" class=\"card-url\">{bookmark.url}</a>\n\t\t\t\t\t\t\t\t{#if bookmark.description}\n\t\t\t\t\t\t\t\t\t<p class=\"card-desc\">{bookmark.description}</p>\n\t\t\t\t\t\t\t\t{/if}\n\t\t\t\t\t\t\t\t{#if bookmark.tags}\n\t\t\t\t\t\t\t\t\t<div class=\"card-tags\">\n\t\t\t\t\t\t\t\t\t\t{#each parse_tags(bookmark.tags) as tag (tag)}\n\t\t\t\t\t\t\t\t\t\t\t<span class=\"mini-tag\">#{tag.trim()}</span>\n\t\t\t\t\t\t\t\t\t\t{/each}\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t{/if}\n\t\t\t\t\t\t\t\t<a href={safe_url(bookmark.url)} target=\"_blank\" rel=\"noopener\" class=\"visit-btn\">\n\t\t\t\t\t\t\t\t\tVisit Site\n\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t{/each}\n\t\t\t\t</div>\n\t\t\t{:else}\n\t\t\t\t<div class=\"bookmarks list-view\" role=\"list\">\n\t\t\t\t\t{#each filtered_bookmarks as bookmark (bookmark.id)}\n\t\t\t\t\t\t<div\n\t\t\t\t\t\t\tclass=\"bookmark-row\" role=\"listitem\"\n\t\t\t\t\t\t\tclass:dragging={dragging_id === bookmark.id}\n\t\t\t\t\t\t\tclass:drag-over={drag_over_id === bookmark.id}\n\t\t\t\t\t\t\tdraggable=\"true\"\n\t\t\t\t\t\t\tondragstart={(e) => handle_drag_start(e, bookmark.id)}\n\t\t\t\t\t\t\tondragover={(e) => handle_drag_over(e, bookmark.id)}\n\t\t\t\t\t\t\tondragleave={handle_drag_leave}\n\t\t\t\t\t\t\tondrop={(e) => handle_drop(e, bookmark.id)}\n\t\t\t\t\t\t\tondragend={handle_drag_end}\n\t\t\t\t\t\t\tanimate:flip={{ duration: 200 }}\n\t\t\t\t\t\t>\n\t\t\t\t\t\t\t<div class=\"drag-handle\">\n\t\t\t\t\t\t\t\t<Icon icon=\"lucide:grip-vertical\" width={16} />\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"favicon\">\n\t\t\t\t\t\t\t\t{#if bookmark.favicon}\n\t\t\t\t\t\t\t\t\t<img src={safe_url(bookmark.favicon)} alt=\"\" onerror={(e) => e.target.style.display = 'none'} />\n\t\t\t\t\t\t\t\t{:else}\n\t\t\t\t\t\t\t\t\t<Icon icon=\"lucide:link\" width={16} />\n\t\t\t\t\t\t\t\t{/if}\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<a class=\"bookmark-content\" href={safe_url(bookmark.url)} target=\"_blank\" rel=\"noopener noreferrer\">\n\t\t\t\t\t\t\t\t<span class=\"bookmark-title\">{bookmark.title || get_domain(bookmark.url)}</span>\n\t\t\t\t\t\t\t\t<span class=\"bookmark-url\">{get_domain(bookmark.url)}</span>\n\t\t\t\t\t\t\t\t{#if bookmark.description}\n\t\t\t\t\t\t\t\t\t<span class=\"bookmark-desc\">{bookmark.description}</span>\n\t\t\t\t\t\t\t\t{/if}\n\t\t\t\t\t\t\t\t{#if bookmark.tags}\n\t\t\t\t\t\t\t\t\t<div class=\"bookmark-tags\">\n\t\t\t\t\t\t\t\t\t\t{#each parse_tags(bookmark.tags) as tag (tag)}\n\t\t\t\t\t\t\t\t\t\t\t<span class=\"mini-tag\">#{tag.trim()}</span>\n\t\t\t\t\t\t\t\t\t\t{/each}\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t{/if}\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t<div class=\"row-actions\">\n\t\t\t\t\t\t\t\t<button class=\"move-btn\" aria-label=\"Move {bookmark.title || 'bookmark'} up\" title=\"Move up\" disabled={reordering || filtered_bookmarks[0]?.id === bookmark.id} onclick={() => move_bookmark(bookmark.id, -1)}><Icon icon=\"lucide:chevron-up\" width={16} /></button>\n\t\t\t\t\t\t\t\t<button class=\"move-btn\" aria-label=\"Move {bookmark.title || 'bookmark'} down\" title=\"Move down\" disabled={reordering || filtered_bookmarks[filtered_bookmarks.length - 1]?.id === bookmark.id} onclick={() => move_bookmark(bookmark.id, 1)}><Icon icon=\"lucide:chevron-down\" width={16} /></button>\n\t\t\t\t\t\t\t\t<button\n\t\t\t\t\t\t\t\tclass=\"delete-btn\" aria-label=\"Delete {bookmark.title}\" disabled={deleting_ids.includes(bookmark.id)} \n\t\t\t\t\t\t\t\tonclick={(e) => { e.preventDefault(); e.stopPropagation(); delete_bookmark(bookmark.id) }}\n\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t<Icon icon=\"lucide:trash-2\" width={16} />\n\t\t\t\t\t\t\t</button></div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t{/each}\n\t\t\t\t</div>\n\t\t\t{/if}\n\t\t</main>\n\t</div>\n</div>\n\n<style>\n\t.page {\n\t\tmin-height: 100vh;\n\t\tbackground: var(--page-background, #f8fafc);\n\t\tfont-family: var(--body-font, system-ui, sans-serif);\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\t}\n\n\t.header {\n\t\tdisplay: flex;\n\t\tjustify-content: space-between;\n\t\talign-items: center;\n\t\tpadding: 1rem 1.5rem;\n\t\tbackground: var(--header-background, #ffffff);\n\t\tborder-bottom: 1px solid var(--border-color, #e2e8f0);\n\t\tgap: 1rem;\n\t}\n\n\t.header h1 {\n\t\tmargin: 0;\n\t\tfont-size: 1.25rem;\n\t\tfont-weight: 600;\n\t\tcolor: var(--heading-text-color, #1e293b);\n\t\twhite-space: nowrap;\n\t}\n\n\t.header-center {\n\t\tflex: 1;\n\t\tmax-width: 400px;\n\t}\n\n\t.header-right {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tgap: 12px;\n\t}\n\n\t.search-box {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tgap: 10px;\n\t\tpadding: 8px 14px;\n\t\tbackground: var(--input-background, #ffffff);\n\t\tborder: 1px solid var(--border-color, #e2e8f0);\n\t\tborder-radius: 8px;\n\t\tcolor: var(--placeholder-color, #94a3b8);\n\t}\n\n\t.search-box input {\n\t\tflex: 1;\n\t\tborder: none;\n\t\toutline: none;\n\t\tfont-size: 0.9rem;\n\t\tcolor: var(--body-text-color, #334155);\n\t\tbackground: transparent;\n\t\tmin-width: 0;\n\t}\n\n\t.search-box input::placeholder {\n\t\tcolor: var(--placeholder-color, #94a3b8);\n\t}\n\n\t.view-toggle {\n\t\tdisplay: flex;\n\t\tbackground: var(--tag-background, #f1f5f9);\n\t\tborder-radius: 6px;\n\t\tpadding: 2px;\n\t}\n\n\t.view-btn {\n\t\tpadding: 6px 10px;\n\t\tbackground: transparent;\n\t\tborder: none;\n\t\tborder-radius: 4px;\n\t\tcolor: var(--secondary-text-color, #64748b);\n\t\tcursor: pointer;\n\t\ttransition: background-color 150ms, color 150ms, border-color 150ms;\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t}\n\n\t.view-btn:hover {\n\t\tcolor: var(--body-text-color, #334155);\n\t}\n\n\t.view-btn.active {\n\t\tbackground: var(--card-background, #ffffff);\n\t\tcolor: var(--accent-color, #3b82f6);\n\t}\n\n\t.add-btn {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tgap: 6px;\n\t\tpadding: 8px 16px;\n\t\tbackground: var(--accent-color, #3b82f6);\n\t\tcolor: #ffffff;\n\t\tborder: none;\n\t\tborder-radius: 8px;\n\t\tfont-weight: 500;\n\t\tfont-size: 0.875rem;\n\t\tcursor: pointer;\n\t\ttransition: opacity 0.15s;\n\t}\n\n\t.add-btn:hover {\n\t\topacity: 0.9;\n\t}\n\n\t.form-container {\n\t\tbackground: var(--header-background, #ffffff);\n\t\tborder-bottom: 1px solid var(--border-color, #e2e8f0);\n\t\tpadding: 1rem 1.5rem 1.5rem;\n\t}\n\n\t.form {\n\t\tmax-width: 600px;\n\t\tmargin: 0 auto;\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\t\tgap: 10px;\n\t}\n\n\t.form input {\n\t\tpadding: 10px 14px;\n\t\tborder: 1px solid var(--border-color, #e2e8f0);\n\t\tborder-radius: 8px;\n\t\tfont-size: 1rem;\n\t\tcolor: var(--body-text-color, #334155);\n\t\tbackground: var(--input-background, #ffffff);\n\t}\n\n\t.form input:focus {\n\t\toutline: none;\n\t\tborder-color: var(--accent-color, #3b82f6);\n\t\tbox-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);\n\t}\n\n\t.form input::placeholder {\n\t\tcolor: var(--placeholder-color, #94a3b8);\n\t}\n\n\t.preview-image {\n\t\tborder-radius: 8px;\n\t\toverflow: hidden;\n\t\tmax-height: 150px;\n\t}\n\n\t.preview-image img {\n\t\twidth: 100%;\n\t\theight: 100%;\n\t\tobject-fit: cover;\n\t}\n\n\t.submit-btn {\n\t\tpadding: 10px 20px;\n\t\tbackground: var(--accent-color, #3b82f6);\n\t\tcolor: #ffffff;\n\t\tborder: none;\n\t\tborder-radius: 8px;\n\t\tfont-weight: 500;\n\t\tcursor: pointer;\n\t\ttransition: opacity 0.15s;\n\t}\n\n\t.submit-btn:hover {\n\t\topacity: 0.9;\n\t}\n\n\t.layout {\n\t\tdisplay: flex;\n\t\tflex: 1;\n\t}\n\n\t.sidebar {\n\t\twidth: 220px;\n\t\tbackground: var(--header-background, #ffffff);\n\t\tborder-right: 1px solid var(--border-color, #e2e8f0);\n\t\tpadding: 1.25rem 0;\n\t\tflex-shrink: 0;\n\t\toverflow-y: auto;\n\t}\n\n\t.sidebar-section {\n\t\tpadding: 0 1rem;\n\t}\n\n\t.sidebar-label {\n\t\tdisplay: block;\n\t\tfont-size: 0.7rem;\n\t\tfont-weight: 600;\n\t\ttext-transform: none;\n\t\tletter-spacing: normal;\n\t\tcolor: var(--secondary-text-color, #64748b);\n\t\tmargin-bottom: 0.75rem;\n\t\tpadding: 0 0.5rem;\n\t}\n\n\t.sidebar-tag {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tjustify-content: space-between;\n\t\twidth: 100%;\n\t\tpadding: 8px 12px;\n\t\tbackground: transparent;\n\t\tborder: none;\n\t\tborder-radius: 6px;\n\t\tcolor: var(--body-text-color, #334155);\n\t\tfont-size: 0.875rem;\n\t\ttext-align: left;\n\t\tcursor: pointer;\n\t\ttransition: background-color 150ms, color 150ms, border-color 150ms;\n\t\tmargin-bottom: 2px;\n\t}\n\n\t.sidebar-tag:hover {\n\t\tbackground: var(--tag-background, #f1f5f9);\n\t}\n\n\t.sidebar-tag.active {\n\t\tbackground: var(--accent-light, #dbeafe);\n\t\tcolor: var(--accent-color, #3b82f6);\n\t\tfont-weight: 500;\n\t}\n\n\t.tag-count {\n\t\tfont-size: 0.75rem;\n\t\tcolor: var(--secondary-text-color, #94a3b8);\n\t}\n\n\t.sidebar-tag.active .tag-count {\n\t\tcolor: var(--accent-color, #3b82f6);\n\t}\n\n\t.main-content {\n\t\tfl