{
	"id": "time-tracker",
	"name": "Time tracker",
	"description": "Track time by project and billable hours.",
	"preview": "lucide:timer",
	"tags": [
		"business",
		"freelance",
		"intermediate",
		"data"
	],
	"kits": [
		"freelance",
		"business"
	],
	"frontend_code": "<script>\n  import { onDestroy, onMount } from 'svelte'\n  import Icon from '@iconify/svelte'\n  import content from '$content'\n  import data from '$data'\n\n  function date_key(date = new Date()) {\n    return [date.getFullYear(), String(date.getMonth() + 1).padStart(2, '0'), String(date.getDate()).padStart(2, '0')].join('-')\n  }\n  const list_params = { all: true }\n  let disposed = false\n  let retrying_load = $state(false)\n  const load_failures = new Map()\n  let entries = $state([])\n  let projects = $state([])\n  let entries_loaded = $state(false)\n  let projects_loaded = $state(false)\n  let load_error = $state('')\n  let now = $state(new Date())\n  let view = $state('today')\n  let filter_project = $state('all')\n  let filter_billable = $state('all')\n  let timer_running = $state(false)\n  let timer_start = $state(null)\n  let timer_project = $state('')\n  let timer_description = $state('')\n  let timer_billable = $state(true)\n  let timer_elapsed = $state(0)\n  let timer_pending = $state(null)\n  let timer_saving = $state(false)\n  let timer_error = $state('')\n  let timer_interval = null\n  let clock_interval = null\n  let modal_open = $state(false)\n  let entry_dialog = $state(null)\n  let editing_entry = $state(null)\n  let saving = $state(false)\n  let form_error = $state('')\n  let form = $state({ project_id: '', description: '', date: date_key(), start_time: '09:00', end_time: '10:00', next_day: false, billable: true })\n  let original_timing = null\n  let project_form_open = $state(false)\n  let project_name = $state('')\n  let project_saving = $state(false)\n  let project_error = $state('')\n\n  function receive_entries(rows) {\n    if (disposed) return\n    load_failures.delete('entries'); load_error = [...load_failures.values()].join(' ')\n    entries = rows.map(row => ({ ...row, description: String(row.description ?? ''), duration: safe_duration(row.duration), billable: Boolean(row.billable) }))\n    entries_loaded = true\n  }\n  function receive_projects(rows) {\n    if (disposed) return\n    load_failures.delete('projects'); load_error = [...load_failures.values()].join(' ')\n    projects = rows.map(row => ({ ...row, name: String(row.name ?? '').trim() || 'Untitled project' })); projects_loaded = true\n  }\n  function fail_load(name, message) {\n    if (disposed) return\n    load_failures.set(name, message); load_error = [...load_failures.values()].join(' ')\n  }\n  const unsubscribe_entries = data.entries.subscribe(receive_entries, list_params, () => fail_load('entries', 'Could not load time entries.'))\n  const unsubscribe_projects = data.projects.subscribe(receive_projects, list_params, () => fail_load('projects', 'Could not load projects.'))\n  async function retry_load() {\n    if (retrying_load || disposed) return\n    retrying_load = true\n    await Promise.all([\n      ['entries', receive_entries, 'Could not load time entries.'],\n      ['projects', receive_projects, 'Could not load projects.']\n    ].map(async ([name, receive, message]) => {\n      try { receive(await data[name].list(list_params)) } catch { fail_load(name, message) }\n    }))\n    if (!disposed) retrying_load = false\n  }\n\n  let today = $derived(date_key(now))\n  function safe_duration(value) {\n    const duration = Number(value)\n    return Number.isFinite(duration) && duration >= 0 ? Math.floor(duration) : 0\n  }\n  function filter_entries(rows = entries) {\n    let result = rows\n    if (view === 'today') result = result.filter(entry => entry.date === today)\n    else if (view === 'week') {\n      const first_day = new Date(now)\n      first_day.setDate(first_day.getDate() - 6)\n      const first = date_key(first_day)\n      result = result.filter(entry => entry.date >= first && entry.date <= today)\n    }\n    if (filter_project !== 'all') result = result.filter(entry => (entry.project_id || '') === filter_project)\n    if (filter_billable !== 'all') result = result.filter(entry => Boolean(entry.billable) === (filter_billable === 'billable'))\n    return [...result].sort((a, b) => String(b.date || '').localeCompare(String(a.date || '')) || String(b.start_time || '').localeCompare(String(a.start_time || '')))\n  }\n  let filtered_entries = $derived.by(() => filter_entries())\n  let grouped_entries = $derived.by(() => {\n    const groups = new Map()\n    for (const entry of filtered_entries) {\n      const rows = groups.get(entry.date) || []\n      rows.push(entry)\n      groups.set(entry.date, rows)\n    }\n    return [...groups]\n  })\n  let stats = $derived.by(() => ({\n    total_hours: filtered_entries.reduce((sum, entry) => sum + safe_duration(entry.duration), 0) / 3600,\n    billable_hours: filtered_entries.filter(entry => entry.billable).reduce((sum, entry) => sum + safe_duration(entry.duration), 0) / 3600,\n    entry_count: filtered_entries.length\n  }))\n  function get_project(id) { return projects.find(project => project.id === id) }\n  function format_duration(value) {\n    const seconds = safe_duration(value)\n    const hours = Math.floor(seconds / 3600)\n    const minutes = Math.floor(seconds % 3600 / 60)\n    return (hours ? hours + ':' + String(minutes).padStart(2, '0') : String(minutes)) + ':' + String(seconds % 60).padStart(2, '0')\n  }\n  function format_hours(hours) {\n    const seconds = safe_duration(Math.round(hours * 3600)), minutes = Math.floor(seconds / 60)\n    if (seconds < 60 && seconds > 0) return seconds + 's'\n    return minutes < 60 ? minutes + 'm' : Math.floor(minutes / 60) + 'h ' + minutes % 60 + 'm'\n  }\n  function format_date_header(value) {\n    if (!valid_date(value)) return 'Unknown date'\n    if (value === today) return 'Today'\n    const yesterday = new Date(now)\n    yesterday.setDate(yesterday.getDate() - 1)\n    if (value === date_key(yesterday)) return 'Yesterday'\n    const date = new Date(value + 'T12:00:00')\n    return Number.isNaN(date.getTime()) ? 'Unknown date' : date.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric', year: date.getFullYear() === now.getFullYear() ? undefined : 'numeric' })\n  }\n  function update_elapsed() {\n    if (timer_running && timer_start !== null) timer_elapsed = Math.max(0, Math.floor((Date.now() - timer_start) / 1000))\n  }\n  function start_timer() {\n    if (timer_running || timer_pending || timer_saving || project_saving || !entries_loaded || !projects_loaded) return\n    timer_error = ''\n    if (timer_project && !get_project(timer_project)) { timer_error = 'Choose an available project or no project.'; return }\n    timer_start = Date.now()\n    timer_elapsed = 0\n    timer_running = true\n    timer_interval = setInterval(update_elapsed, 250)\n  }\n  async function stop_timer() {\n    if (!timer_running) return\n    update_elapsed()\n    clearInterval(timer_interval)\n    timer_interval = null\n    timer_running = false\n    if (!timer_elapsed) { timer_start = null; return }\n    const start = new Date(timer_start), end = new Date()\n    timer_pending = {\n      project_id: timer_project, description: timer_description.trim(), date: date_key(start),\n      start_time: start.toTimeString().slice(0, 5), end_time: end.toTimeString().slice(0, 5),\n      duration: timer_elapsed, billable: timer_billable\n    }\n    await save_timer()\n  }\n  async function save_timer() {\n    if (!timer_pending || timer_saving) return\n    timer_saving = true\n    timer_error = ''\n    try {\n      await data.entries.create({ ...timer_pending })\n      timer_pending = null\n      timer_start = null\n      timer_elapsed = 0\n      timer_description = ''\n    } catch { timer_error = 'This time entry could not be saved. Retry to keep the recorded time.' }\n    finally { timer_saving = false }\n  }\n  function discard_timer() {\n    if (timer_saving || !confirm('Discard this unsaved time entry?')) return\n    timer_pending = null\n    timer_start = null\n    timer_elapsed = 0\n    timer_error = ''\n  }\n  function open_manual_modal() {\n    if (saving || !entries_loaded || !projects_loaded) return\n    editing_entry = null\n    original_timing = null\n    form = { project_id: timer_project, description: '', date: date_key(new Date()), start_time: '09:00', end_time: '10:00', next_day: false, billable: true }\n    form_error = ''\n    modal_open = true\n  }\n  function open_edit_modal(entry) {\n    if (saving) return\n    editing_entry = entry\n    const start_time = entry.start_time || '09:00'\n    const start_minutes = time_minutes(start_time) ?? 540\n    const end_minutes = (start_minutes + Math.floor(safe_duration(entry.duration) / 60)) % 1440\n    const end_time = entry.end_time || String(Math.floor(end_minutes / 60)).padStart(2, '0') + ':' + String(end_minutes % 60).padStart(2, '0')\n    const next_day = (time_minutes(end_time) ?? 0) < start_minutes || safe_duration(entry.duration) >= 86400\n    original_timing = { start_time, end_time, next_day, duration: safe_duration(entry.duration) }\n    form = {\n      project_id: entry.project_id || '', description: entry.description || '', date: entry.date || date_key(new Date()),\n      start_time, end_time, next_day, billable: Boolean(entry.billable)\n    }\n    form_error = ''\n    modal_open = true\n  }\n  function close_modal() { if (!saving) { modal_open = false; editing_entry = null; form_error = '' } }\n  $effect(() => {\n    if (modal_open && entry_dialog && !entry_dialog.open) entry_dialog.showModal()\n    if (!modal_open && entry_dialog?.open) entry_dialog.close()\n  })\n  function time_minutes(value) {\n    if (!/^(?:[01]\\d|2[0-3]):[0-5]\\d$/.test(value || '')) return null\n    const [hours, minutes] = value.split(':').map(Number)\n    return hours * 60 + minutes\n  }\n  function calc_duration(start, end, next_day = false) {\n    const from = time_minutes(start), to = time_minutes(end)\n    if (from === null || to === null) return null\n    const seconds = (to - from + (next_day ? 1440 : 0)) * 60\n    return seconds > 0 && seconds <= 86400 ? seconds : null\n  }\n  function valid_date(value) {\n    const date = new Date(value + 'T12:00:00')\n    return /^\\d{4}-\\d{2}-\\d{2}$/.test(value || '') && !Number.isNaN(date.getTime()) && date_key(date) === value\n  }\n  async function save_entry() {\n    if (saving) return\n    form_error = ''\n    if (!valid_date(form.date)) { form_error = 'Enter a valid date.'; return }\n    const unchanged = editing_entry && original_timing && form.start_time === original_timing.start_time && form.end_time === original_timing.end_time && form.next_day === original_timing.next_day\n    const duration = unchanged ? original_timing.duration : calc_duration(form.start_time, form.end_time, form.next_day)\n    if (!duration) { form_error = 'Enter valid times with the end after the start. Select next day for an overnight entry.'; return }\n    if (form.project_id && !get_project(form.project_id) && form.project_id !== editing_entry?.project_id) { form_error = 'Choose an available project or no project.'; return }\n    const payload = {\n      project_id: form.project_id, description: form.description.trim(), date: form.date,\n      start_time: form.start_time, end_time: form.end_time, duration, billable: form.billable\n    }\n    saving = true\n    try {\n      if (editing_entry) await data.entries.update(editing_entry.id, payload)\n      else await data.entries.create(payload)\n      saving = false\n      close_modal()\n    } catch { form_error = 'Could not save this entry. Your changes are still here.' }\n    finally { saving = false }\n  }\n  async function delete_entry(id) {\n    if (saving || !confirm('Delete this time entry?')) return\n    saving = true\n    form_error = ''\n    try { await data.entries.delete(id); saving = false; close_modal() }\n    catch { form_error = 'Could not delete this entry. Try again.' }\n    finally { saving = false }\n  }\n  async function add_project(event) {\n    event?.preventDefault()\n    if (project_saving) return\n    if (!project_name.trim()) { project_error = 'Enter a project name.'; return }\n    project_saving = true\n    project_error = ''\n    try {\n      const project = await data.projects.create({ name: project_name.trim(), hourly_rate: 0, color: '#737373' })\n      timer_project = project.id\n      project_name = ''\n      project_form_open = false\n    } catch { project_error = 'Could not add the project. Your name is still here.' }\n    finally { project_saving = false }\n  }\n  function csv_cell(value) {\n    let text = String(value ?? '')\n    if (/^[\\s]*[=+\\-@]/.test(text) || /^[\\t\\r]/.test(text)) text = \"'\" + text\n    return '\"' + text.replaceAll('\"', '\"\"') + '\"'\n  }\n  function timesheet_csv(rows = filtered_entries) {\n    return 'Date,Project,Description,Start,End,Duration (hrs),Billable\\r\\n' + rows.map(entry => [\n      entry.date, get_project(entry.project_id)?.name || '', entry.description, entry.start_time, entry.end_time,\n      (safe_duration(entry.duration) / 3600).toFixed(6).replace(/0+$/, '').replace(/\\.$/, ''), entry.billable ? 'Yes' : 'No'\n    ].map(csv_cell).join(',')).join('\\r\\n')\n  }\n  function export_timesheet() {\n    const blob = new Blob([timesheet_csv()], { type: 'text/csv;charset=utf-8' })\n    const url = URL.createObjectURL(blob)\n    const anchor = document.createElement('a')\n    anchor.href = url\n    anchor.download = 'timesheet-' + today + '.csv'\n    anchor.click()\n    setTimeout(() => URL.revokeObjectURL(url), 0)\n  }\n  function before_unload(event) {\n    if (timer_running || timer_pending || saving) { event.preventDefault(); event.returnValue = '' }\n  }\n  onMount(() => {\n    clock_interval = setInterval(() => { now = new Date() }, 30000)\n    window.addEventListener('beforeunload', before_unload)\n    return () => window.removeEventListener('beforeunload', before_unload)\n  })\n  onDestroy(() => {\n    disposed = true\n    clearInterval(timer_interval)\n    clearInterval(clock_interval)\n    unsubscribe_entries?.()\n    unsubscribe_projects?.()\n  })\n</script>\n\n<main class=\"page\">\n  <header class=\"header\">\n    <h1>{content.title}</h1>\n    <button class=\"secondary\" onclick={export_timesheet} disabled={!entries_loaded || !projects_loaded || !filtered_entries.length}><Icon icon=\"lucide:download\" width={15} />{content.export_button}</button>\n  </header>\n  {#if load_error}<div class=\"notice\" role=\"alert\"><span>{load_error}</span><button onclick={retry_load} disabled={retrying_load}>{retrying_load ? 'Retrying…' : 'Retry'}</button></div>{/if}\n  <section class=\"timer-section\" aria-label=\"Track time\">\n    <div class=\"timer-topline\">\n      <span class=\"timer-time\" class:running={timer_running} aria-label=\"Elapsed time\">{format_duration(timer_elapsed)}</span>\n      <span class=\"timer-state\">{timer_running ? 'Recording' : timer_pending ? 'Not saved' : entries_loaded && projects_loaded ? 'Ready' : load_error ? 'Unavailable' : 'Loading…'}</span>\n    </div>\n    <div class=\"timer-controls\">\n      <select bind:value={timer_project} disabled={timer_running || !!timer_pending || timer_saving || !projects_loaded} aria-label=\"Timer project\">\n        <option value=\"\">No project</option>\n        {#each projects as project (project.id)}<option value={project.id}>{project.name}</option>{/each}\n      </select>\n      <input type=\"text\" class=\"timer-description\" bind:value={timer_description} disabled={!!timer_pending || timer_saving} placeholder={content.description_placeholder} aria-label=\"Time entry description\" />\n      <label class=\"billable-toggle\"><input type=\"checkbox\" bind:checked={timer_billable} disabled={timer_running || !!timer_pending || timer_saving} />Billable</label>\n      {#if timer_running}\n        <button class=\"primary stop\" onclick={stop_timer}><Icon icon=\"lucide:square\" width={15} />Stop</button>\n      {:else if timer_pending}\n        <button class=\"primary\" onclick={save_timer} disabled={timer_saving}>{timer_saving ? 'Saving…' : 'Retry save'}</button>\n        <button class=\"secondary\" onclick={discard_timer} disabled={timer_saving}>Discard</button>\n      {:else}\n        <button class=\"primary start\" onclick={start_timer} disabled={!entries_loaded || !projects_loaded || project_saving}><Icon icon=\"lucide:play\" width={15} />Start</button>\n      {/if}\n    </div>\n    <button class=\"text-button\" onclick={() => { project_form_open = !project_form_open; project_error = '' }} disabled={timer_running || !!timer_pending || timer_saving || !projects_loaded} aria-expanded={project_form_open}>New project</button>\n    {#if project_form_open}\n      <form class=\"project-form\" onsubmit={add_project}>\n        <label for=\"project-name\">Project name</label>\n        <input id=\"project-name\" bind:value={project_name} disabled={project_saving} required maxlength=\"120\" />\n        <button class=\"secondary\" type=\"submit\" disabled={project_saving}>{project_saving ? 'Adding…' : 'Add project'}</button>\n        <button class=\"text-button\" type=\"button\" onclick={() => project_form_open = false} disabled={project_saving}>Cancel</button>\n      </form>\n    {/if}\n    {#if timer_error}<p class=\"inline-error\" role=\"alert\">{timer_error}</p>{/if}\n    {#if project_error}<p class=\"inline-error\" role=\"alert\">{project_error}</p>{/if}\n  </section>\n  <div class=\"stats-bar\" aria-label=\"Filtered time totals\">\n    <div class=\"stat\"><span class=\"stat-value\">{format_hours(stats.total_hours)}</span><span class=\"stat-label\">Total</span></div>\n    <div class=\"stat\"><span class=\"stat-value\">{format_hours(stats.billable_hours)}</span><span class=\"stat-label\">Billable</span></div>\n    <div class=\"stat\"><span class=\"stat-value\">{stats.entry_count}</span><span class=\"stat-label\">Entries</span></div>\n  </div>\n  <div class=\"filters\">\n    <div class=\"view-tabs\" aria-label=\"Time period\">\n      <button class:active={view === 'today'} aria-pressed={view === 'today'} onclick={() => view = 'today'}>Today</button>\n      <button class:active={view === 'week'} aria-pressed={view === 'week'} onclick={() => view = 'week'}>Last 7 days</button>\n      <button class:active={view === 'all'} aria-pressed={view === 'all'} onclick={() => view = 'all'}>All</button>\n    </div>\n    <div class=\"filter-controls\">\n      <select bind:value={filter_project} aria-label=\"Filter by project\">\n        <option value=\"all\">All projects</option><option value=\"\">No project</option>\n        {#each projects as project (project.id)}<option value={project.id}>{project.name}</option>{/each}\n      </select>\n      <select bind:value={filter_billable} aria-label=\"Filter by billable status\"><option value=\"all\">All entries</option><option value=\"billable\">Billable</option><option value=\"non-billable\">Non-billable</option></select>\n      <button class=\"secondary\" onclick={open_manual_modal} disabled={!entries_loaded || !projects_loaded}><Icon icon=\"lucide:plus\" width={15} />Manual entry</button>\n    </div>\n  </div>\n  <div class=\"entries-list\">\n    {#if !entries_loaded && !load_error}<p class=\"empty\" role=\"status\">Loading time entries…</p>\n    {:else if entries_loaded && grouped_entries.length === 0}<p class=\"empty\">{entries.length ? 'No entries match these filters.' : content.empty_state}</p>\n    {:else}\n      {#each grouped_entries as [date, day_entries] (date)}\n        <section class=\"day-group\" aria-label={format_date_header(date)}>\n          <div class=\"day-header\"><h2>{format_date_header(date)}</h2><span>{format_hours(day_entries.reduce((sum, entry) => sum + safe_duration(entry.duration), 0) / 3600)}</span></div>\n          {#each day_entries as entry (entry.id)}\n            {@const project = get_project(entry.project_id)}\n            <button class=\"entry-row\" onclick={() => open_edit_modal(entry)}>\n              <span class=\"entry-project\"><span class=\"project-dot\" style:background={project?.color || '#737373'}></span>{project?.name || 'No project'}</span>\n              <span class=\"entry-description\">{entry.description || 'No description'}</span>\n              <span class=\"entry-meta\">{entry.start_time || '—'}{entry.end_time ? ' – ' + entry.end_time : ''}<span class=\"billable-label\" class:billable={entry.billable}>{entry.billable ? 'Billable' : 'Non-billable'}</span></span>\n              <span class=\"entry-duration\">{format_duration(entry.duration)}</span>\n            </button>\n          {/each}\n        </section>\n      {/each}\n    {/if}\n  </div>\n</main>\n\n<dialog class=\"entry-dialog\" bind:this={entry_dialog} aria-labelledby=\"entry-title\" oncancel={event => { if (saving) event.preventDefault(); else close_modal() }} onclose={() => { if (!saving) close_modal() }}>\n  <form onsubmit={event => { event.preventDefault(); void save_entry() }}>\n    <header class=\"modal-header\"><h2 id=\"entry-title\">{editing_entry ? 'Edit entry' : 'Manual entry'}</h2><button type=\"button\" class=\"close-button\" onclick={close_modal} disabled={saving} aria-label=\"Close entry\">×</button></header>\n    <fieldset disabled={saving}>\n      <label for=\"entry-project\">Project</label>\n      <select id=\"entry-project\" bind:value={form.project_id}>\n        <option value=\"\">No project</option>\n        {#each projects as project (project.id)}<option value={project.id}>{project.name}</option>{/each}\n        {#if form.project_id && !get_project(form.project_id)}<option value={form.project_id}>Unavailable project</option>{/if}\n      </select>\n      <label for=\"entry-description\">Description</label><input id=\"entry-description\" type=\"text\" bind:value={form.description} placeholder=\"What did you work on?\" />\n      <label for=\"entry-date\">Date</label><input id=\"entry-date\" type=\"date\" bind:value={form.date} required />\n      <div class=\"form-row\">\n        <div><label for=\"entry-start\">Start time</label><input id=\"entry-start\" type=\"time\" bind:value={form.start_time} required /></div>\n        <div><label for=\"entry-end\">End time</label><input id=\"entry-end\" type=\"time\" bind:value={form.end_time} required /></div>\n      </div>\n      <label class=\"checkbox-label\"><input type=\"checkbox\" bind:checked={form.next_day} />Ends the next day</label>\n      <label class=\"checkbox-label\"><input type=\"checkbox\" bind:checked={form.billable} />Billable</label>\n    </fieldset>\n    {#if form_error}<p class=\"inline-error modal-error\" role=\"alert\">{form_error}</p>{/if}\n    <footer class=\"modal-footer\">\n      {#if editing_entry}<button type=\"button\" class=\"delete-button\" onclick={() => delete_entry(editing_entry.id)} disabled={saving}>Delete entry</button>{/if}\n      <div class=\"footer-actions\"><button type=\"button\" class=\"secondary\" onclick={close_modal} disabled={saving}>Cancel</button><button type=\"submit\" class=\"primary\" disabled={saving}>{saving ? 'Saving…' : 'Save entry'}</button></div>\n    </footer>\n  </form>\n</dialog>\n\n<style>\n  :global(*) { box-sizing: border-box; }\n  :global(body) { margin: 0; background: var(--page-background, #fafafa); font-family: var(--font-family, system-ui, sans-serif); color: var(--body-text, #202020); font-size: 14px; }\n  .page { width: min(1100px, 100%); margin: 0 auto; padding: 24px; }\n  .header { background: var(--header-background, #fff); display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 22px; }\n  h1 { min-width: 0; overflow-wrap: anywhere; font-size: 21px; font-weight: 600; margin: 0; color: var(--heading-color, #202020); }\n  button, input, select { font: inherit; color: inherit; }\n  button { cursor: pointer; }\n  button:disabled { opacity: .55; cursor: default; }\n  input:not([type=\"checkbox\"]), select { width: 100%; min-width: 0; height: 38px; padding: 8px 10px; border: 1px solid var(--border-color, #e5e5e5); border-radius: 5px; background: var(--card-background, #fff); }\n  input[type=\"checkbox\"] { width: 16px; height: 16px; accent-color: var(--primary-color, #2563eb); flex-shrink: 0; }\n  .primary, .secondary { display: inline-flex; justify-content: center; align-items: center; gap: 6px; min-height: 38px; padding: 8px 12px; border: 1px solid var(--border-color, #e5e5e5); border-radius: 5px; background: var(--card-background, #fff); white-space: nowrap; font-weight: 500; font-size: 13px; }\n  .primary { background: var(--primary-color, #2563eb); color: #fff; border-color: transparent; }\n  .secondary:hover { background: var(--page-background, #fafafa); }\n  .primary:hover { filter: brightness(.94); }\n  .primary.start { background: var(--start-color, #2563eb); }\n  .primary.stop { background: var(--stop-color, #b42318); }\n  .timer-section { padding: 20px; background: var(--timer-background, #fff); border: 1px solid var(--border-color, #e5e5e5); border-radius: 6px; }\n  .timer-topline { display: flex; gap: 16px; align-items: center; margin-bottom: 16px; }\n  .timer-time { font-size: 36px; font-weight: 500; line-height: 1.2; font-variant-numeric: tabular-nums; color: var(--heading-color, #202020); }\n  .timer-time.running { color: var(--timer-running-color, #202020); }\n  .timer-state { font-size: 12px; color: var(--secondary-text, #737373); }\n  .timer-controls { display: flex; align-items: center; gap: 10px; }\n  .timer-controls select { max-width: 180px; }\n  .timer-description { flex: 1; }\n  .billable-toggle { display: flex; gap: 5px; align-items: center; font-size: 13px; white-space: nowrap; }\n  .text-button { border: 0; background: transparent; padding: 0; min-height: 32px; color: var(--secondary-text, #737373); font-size: 12px; }\n  .text-button:hover { color: var(--body-text, #202020); text-decoration: underline; }\n  .timer-section > .text-button { margin-top: 8px; }\n  .project-form { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-top: 8px; padding-top: 12px; border-top: 1px solid var(--border-color, #e5e5e5); }\n  .project-form label { font-size: 12px; color: var(--secondary-text, #737373); }\n  .project-form input { max-width: 270px; flex: 1; }\n  .stats-bar { display: flex; gap: 40px; padding: 20px 0; border-bottom: 1px solid var(--border-color, #e5e5e5); }\n  .stat { display: flex; gap: 8px; align-items: baseline; }\n  .stat-value { font-size: 18px; font-weight: 600; font-variant-numeric: tabular-nums; }\n  .stat-label { font-size: 12px; color: var(--secondary-text, #737373); }\n  .filters { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; padding: 18px 0; }\n  .view-tabs { display: flex; gap: 3px; padding: 3px; background: var(--border-color, #e5e5e5); border-radius: 5px; }\n  .view-tabs button { border: 0; padding: 6px 10px; border-radius: 3px; background: transparent; color: var(--secondary-text, #737373); font-size: 12px; white-space: nowrap; }\n  .view-tabs button.active { background: var(--card-background, #fff); color: var(--body-text, #202020); }\n  .filter-controls { display: flex; gap: 8px; align-items: center; }\n  .filter-controls select { width: auto; max-width: 180px; font-size: 12px; }\n  .empty { color: var(--secondary-text, #737373); text-align: center; padding: 44px 16px; font-size: 13px; }\n  .day-group { margin-bottom: 26px; }\n  .day-header { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; font-size: 12px; color: var(--secondary-text, #737373); border-bottom: 1px solid var(--border-color, #e5e5e5); }\n  .day-header h2 { margin: 0; font: inherit; font-weight: 600; color: var(--heading-color, #202020); }\n  .entry-row { display: grid; grid-template-columns: minmax(100px, 1fr) minmax(0, 2fr) 145px 80px; gap: 16px; align-items: center; width: 100%; padding: 14px 8px; background: transparent; border: 0; border-bottom: 1px solid var(--border-color, #e5e5e5); text-align: left; }\n  .entry-row:hover { background: var(--card-background, #fff); }\n  .entry-project { display: flex; gap: 8px; align-items: center; font-size: 12px; overflow-wrap: anywhere; }\n  .project-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }\n  .entry-description { font-size: 13px; overflow-wrap: anywhere; }\n  .entry-meta { display: flex; flex-direction: column; gap: 3px; font-size: 11px; color: var(--secondary-text, #737373); }\n  .billable-label { font-size: 10px; }\n  .billable-label.billable { color: var(--billable-color, #202020); }\n  .entry-duration { font-variant-numeric: tabular-nums; font-weight: 500; text-align: right; }\n  .notice { display: flex; justify-content: space-between; gap: 12px; align-items: center; padding: 12px; margin-bottom: 16px; border: 1px solid #b42318; border-radius: 5px; font-size: 13px; }\n  .notice button { padding: 6px 12px; border: 1px solid var(--border-color, #e5e5e5); border-radius: 4px; background: var(--card-background, #fff); }\n  .inline-error { color: #b42318; font-size: 13px; margin: 12px 0 0; }\n  .entry-dialog { width: min(460px, calc(100% - 32px)); max-height: calc(100dvh - 32px); margin: auto; padding: 0; color: var(--body-text, #202020); background: var(--card-background, #fff); border: 1px solid var(--border-color, #e5e5e5); border-radius: 6px; overflow-y: auto; }\n  .entry-dialog::backdrop { background: rgb(0 0 0 / .3); }\n  .modal-header { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; border-bottom: 1px solid var(--border-color, #e5e5e5); }\n  .modal-header h2 { font-size: 16px; font-weight: 600; margin: 0; }\n  .close-button { width: 32px; height: 32px; padding: 0; font-size: 24px; color: var(--secondary-text, #737373); background: transparent; border: 0; border-radius: 4px; }\n  fieldset { border: 0; padding: 20px; margin: 0; display: flex; flex-direction: column; gap: 7px; min-width: 0; }\n  fieldset > label:not(.checkbox-label), .form-row label { font-size: 12px; margin-top: 8px; color: var(--secondary-text, #737373); }\n  fieldset > label:first-child { margin-top: 0; }\n  .form-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; margin: 8px 0; }\n  .form-row label { display: block; margin: 0 0 7px; }\n  .checkbox-label { display: flex; gap: 6px; align-items: center; font-size: 13px; margin-top: 5px; }\n  .modal-error { margin: 0 20px 16px; }\n  .modal-footer { display: flex; gap: 12px; align-items: center; padding: 14px 20px; border-top: 1px solid var(--border-color, #e5e5e5); }\n  .footer-actions { margin-left: auto; display: flex; gap: 8px; }\n  .delete-button { padding: 6px 0; border: 0; background: transparent; color: #b42318; font-size: 12px; }\n  :global(button:focus-visible), :global(input:focus-visible), :global(select:focus-visible) { outline: 2px solid var(--primary-color, #2563eb); outline-offset: 2px; }\n  @media (max-width: 720px) {\n    .page { padding: 16px; }\n    .timer-section { padding: 16px; }\n    .timer-controls { display: grid; grid-template-columns: minmax(0, 1fr) auto; }\n    .timer-controls select { max-width: 100%; grid-column: 1 / -1; }\n    .timer-description { grid-column: 1 / -1; }\n    .timer-controls .primary { min-width: 95px; }\n    input:not([type=\"checkbox\"]), select { font-size: 16px; }\n    .stats-bar { gap: 22px; justify-content: space-between; }\n    .stat { flex-direction: column; gap: 3px; }\n    .stat-value { font-size: 17px; }\n    .filter-controls { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); width: 100%; }\n    .filter-controls select { max-width: 100%; width: 100%; font-size: 14px; }\n    .filter-controls .secondary { grid-column: 1 / -1; }\n    .entry-row { grid-template-columns: minmax(0, 1fr) auto; gap: 8px 14px; padding: 14px 0; }\n    .entry-project { grid-column: 1; grid-row: 1; }\n    .entry-description { grid-column: 1 / -1; grid-row: 2; }\n    .entry-meta { flex-direction: row; gap: 10px; grid-column: 1 / -1; grid-row: 3; }\n    .entry-duration { grid-column: 2; grid-row: 1; }\n    .project-form label { width: 100%; }\n    .project-form input { flex-basis: 100%; max-width: 100%; }\n    .notice { align-items: flex-start; }\n    .modal-footer { flex-wrap: wrap; }\n  }\n  @media (prefers-reduced-motion: reduce) { :global(*) { transition: none !important; animation: none !important; } }\n</style>\n",
