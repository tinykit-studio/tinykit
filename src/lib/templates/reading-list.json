{
	"id": "reading-list",
	"name": "Reading list",
	"description": "Track books, ratings, and reading progress.",
	"preview": "lucide:book-open",
	"tags": [
		"daily",
		"personal",
		"beginner"
	],
	"kits": [
		"collections",
		"feeds",
		"personal-site"
	],
	"frontend_code": "<script>\n  import Icon from '@iconify/svelte'\n  import { onDestroy } from 'svelte'\n  import content from '$content'\n  import data from '$data'\n\n  const list_params = { all: true }\n  let books = $state([])\n  let loading = $state(true)\n  let load_error = $state('')\n  let retrying_load = $state(false)\n  let action_error = $state('')\n  let disposed = false\n  let filter_status = $state('all')\n  let search = $state('')\n  let sort_by = $state('added')\n  let busy_ids = $state([])\n  let pending_delete_id = $state(null)\n  const status_options = [\n    { value: 'want', label: 'Want to read' },\n    { value: 'reading', label: 'Reading' },\n    { value: 'finished', label: 'Finished' }\n  ]\n\n  function receive_books(items) {\n    if (disposed) return\n    books = [...new Map(items.filter(item => item?.id).map(item => [item.id, item])).values()]\n    loading = false\n    load_error = ''\n  }\n  const unsubscribe = data.books.subscribe(receive_books, list_params, () => {\n    if (disposed) return\n    loading = false\n    load_error = 'Could not load your books. Try again.'\n  })\n  async function retry_load() {\n    if (retrying_load || disposed) return\n    retrying_load = true\n    try { receive_books(await data.books.list(list_params)) }\n    catch { if (!disposed) load_error = 'Could not load your books. Try again.' }\n    finally { if (!disposed) retrying_load = false }\n  }\n  onDestroy(() => { disposed = true; if (typeof unsubscribe === 'function') unsubscribe() })\n\n  let filtered_books = $derived.by(() => {\n    const query = search.trim().toLocaleLowerCase()\n    return books.filter(book =>\n      (filter_status === 'all' || book.status === filter_status) &&\n      (!query || [book.title, book.author].some(value => String(value || '').toLocaleLowerCase().includes(query)))\n    ).sort((a, b) => {\n      if (sort_by === 'title' || sort_by === 'author') return String(a[sort_by] || '').localeCompare(String(b[sort_by] || ''))\n      if (sort_by === 'rating') return (Number(b.rating) || 0) - (Number(a.rating) || 0)\n      return (Date.parse(b.added_at) || 0) - (Date.parse(a.added_at) || 0)\n    })\n  })\n  let stats = $derived.by(() => ({\n    want: books.filter(book => book.status === 'want').length,\n    reading: books.filter(book => book.status === 'reading').length,\n    finished: books.filter(book => book.status === 'finished').length\n  }))\n\n  let show_form = $state(false)\n  let editing_book_id = $state(null)\n  let new_title = $state('')\n  let new_author = $state('')\n  let new_cover = $state('')\n  let adding = $state(false)\n  let form_error = $state('')\n\n  function http_url(value) {\n    const text = String(value ?? '').trim()\n    if (!text) return ''\n    try { const url = new URL(text); return ['http:', 'https:'].includes(url.protocol) ? url.href : null }\n    catch { return null }\n  }\n  function close_form() {\n    if (adding) return\n    show_form = false\n    editing_book_id = null\n    new_title = ''; new_author = ''; new_cover = ''; form_error = ''\n  }\n  function open_form(book = null) {\n    if (adding || (book && busy_ids.includes(book.id))) return\n    editing_book_id = book?.id || null\n    new_title = book?.title || ''; new_author = book?.author || ''; new_cover = book?.cover_url || ''\n    form_error = ''; show_form = true\n  }\n  async function add_book(event) {\n    event?.preventDefault()\n    if (adding) return\n    form_error = ''\n    if (!new_title.trim()) { form_error = 'Enter a book title.'; return }\n    const cover_url = http_url(new_cover)\n    if (cover_url === null) { form_error = 'Use an http or https URL for the cover.'; return }\n    adding = true\n    const id = editing_book_id\n    try {\n      const fields = { title: new_title.trim(), author: new_author.trim(), cover_url }\n      if (id) await data.books.update(id, fields)\n      else await data.books.create({ ...fields, status: 'want', rating: 0, notes: '', added_at: new Date().toISOString() })\n      adding = false\n      close_form()\n    } catch { form_error = 'Could not save this book. Your changes are still here.' }\n    finally { adding = false }\n  }\n  async function update_book(id, fields, message) {\n    if (busy_ids.includes(id)) return false\n    busy_ids = [...busy_ids, id]\n    action_error = ''\n    try { await data.books.update(id, fields); return true }\n    catch { action_error = message; return false }\n    finally { busy_ids = busy_ids.filter(value => value !== id) }\n  }\n  async function update_status(book, status) {\n    if (!status_options.some(option => option.value === status)) return\n    return await update_book(book.id, { status }, 'Could not update this reading status. Try again.')\n  }\n  async function set_rating(book, rating) {\n    if (!Number.isInteger(rating) || rating < 0 || rating > 5) return\n    await update_book(book.id, { rating }, 'Could not save this rating. Try again.')\n  }\n  let editing_notes = $state(null)\n  let notes_text = $state('')\n  const notes_drafts = new Map()\n  function start_editing_notes(book) {\n    if (busy_ids.includes(book.id)) return\n    if (editing_notes && editing_notes !== book.id) notes_drafts.set(editing_notes, notes_text)\n    editing_notes = book.id\n    notes_text = notes_drafts.get(book.id) ?? book.notes ?? ''\n  }\n  async function save_notes(book) {\n    const text = notes_text\n    if (await update_book(book.id, { notes: text }, 'Could not save your notes. Your changes are still here.')) {\n      if (editing_notes === book.id && notes_text === text) { editing_notes = null; notes_drafts.delete(book.id) }\n      else if (editing_notes !== book.id && notes_drafts.get(book.id) === text) notes_drafts.delete(book.id)\n    }\n  }\n  async function delete_book(book) {\n    if (busy_ids.includes(book.id)) return\n    busy_ids = [...busy_ids, book.id]\n    action_error = ''\n    try {\n      await data.books.delete(book.id)\n      if (editing_notes === book.id) editing_notes = null\n      notes_drafts.delete(book.id)\n      if (editing_book_id === book.id) close_form()\n      pending_delete_id = null\n    } catch { action_error = 'Could not delete this book. Try again.' }\n    finally { busy_ids = busy_ids.filter(id => id !== book.id) }\n  }\n</script>\n\n<div class=\"page\">\n  <header>\n    <div class=\"heading\"><h1>{content.title}</h1><button class=\"primary\" disabled={adding} onclick={() => show_form ? close_form() : open_form()}><Icon icon={show_form ? 'lucide:x' : 'lucide:plus'} width={16} />{show_form ? content.cancel : content.add_book}</button></div>\n    <p class=\"stats\">{stats.want} {content.want_label}<span>·</span>{stats.reading} {content.reading_label}<span>·</span>{stats.finished} {content.finished_label}</p>\n  </header>\n\n  {#if show_form}\n    <form class=\"add-form\" onsubmit={add_book}>\n      <h2>{editing_book_id ? 'Edit book' : content.add_book}</h2>\n      <div class=\"form-fields\">\n        <label>Title<input required placeholder={content.title_placeholder} bind:value={new_title} disabled={adding} /></label>\n        <label>Author<input placeholder={content.author_placeholder} bind:value={new_author} disabled={adding} /></label>\n        <label class=\"cover-field\">Cover image URL<input type=\"url\" placeholder={content.cover_placeholder} bind:value={new_cover} disabled={adding} /></label>\n      </div>\n      {#if form_error}<p class=\"error-text\" role=\"alert\">{form_error}</p>{/if}\n      <div class=\"form-actions\"><button class=\"primary\" disabled={adding}>{adding ? 'Saving…' : editing_book_id ? 'Save changes' : content.add_button}</button><button type=\"button\" onclick={close_form} disabled={adding}>{content.cancel}</button></div>\n    </form>\n  {/if}\n\n  <div class=\"controls\">\n    <label class=\"search\"><Icon icon=\"lucide:search\" width={16} /><input type=\"search\" aria-label=\"Search books\" placeholder={content.search_placeholder} bind:value={search} /></label>\n    <label class=\"sort\">Sort<select bind:value={sort_by}><option value=\"added\">{content.sort_added}</option><option value=\"title\">{content.sort_title}</option><option value=\"author\">{content.sort_author}</option><option value=\"rating\">{content.sort_rating}</option></select></label>\n  </div>\n  <div class=\"filters\" role=\"group\" aria-label=\"Reading status\">\n    <button class:active={filter_status === 'all'} aria-pressed={filter_status === 'all'} onclick={() => filter_status = 'all'}>All <span>{books.length}</span></button>\n    {#each status_options as status (status.value)}<button class:active={filter_status === status.value} aria-pressed={filter_status === status.value} onclick={() => filter_status = status.value}>{status.label} <span>{stats[status.value]}</span></button>{/each}\n  </div>\n\n  {#if load_error}<div class=\"notice\" role=\"alert\"><span>{load_error}</span><button onclick={retry_load} disabled={retrying_load}>{retrying_load ? 'Retrying…' : 'Retry'}</button></div>{/if}\n  {#if action_error}<div class=\"notice\" role=\"alert\"><span>{action_error}</span><button onclick={() => action_error = ''}>Dismiss</button></div>{/if}\n  {#if loading}<p class=\"empty\" role=\"status\">Loading books…</p>\n  {:else if filtered_books.length === 0 && !load_error}\n    <div class=\"empty\"><p>{search.trim() || filter_status !== 'all' ? content.no_results : content.empty_text}</p>{#if search.trim() || filter_status !== 'all'}<button onclick={() => { search = ''; filter_status = 'all' }}>Clear filters</button>{/if}</div>\n  {:else}\n    <div class=\"book-list\">\n      {#each filtered_books as book (book.id)}\n        <article class=\"book-row\">\n          <div class=\"cover\">{#if http_url(book.cover_url || '')}<img src={http_url(book.cover_url)} alt=\"\" loading=\"lazy\" />{:else}<Icon icon=\"lucide:book\" width={22} />{/if}</div>\n          <div class=\"book-info\">\n            <div class=\"book-heading\"><div><h2>{book.title || 'Untitled book'}</h2>{#if book.author}<p class=\"author\">{book.author}</p>{/if}</div><div class=\"row-actions\"><button class=\"icon-btn\" aria-label={`Edit ${book.title || 'book'}`} title=\"Edit book\" disabled={busy_ids.includes(book.id)} onclick={() => open_form(book)}><Icon icon=\"lucide:pencil\" width={15} /></button><button class=\"icon-btn\" aria-label={`Delete ${book.title || 'book'}`} title=\"Delete book\" disabled={busy_ids.includes(book.id)} onclick={() => pending_delete_id = book.id}><Icon icon=\"lucide:trash-2\" width={15} /></button></div></div>\n            <div class=\"book-controls\">\n              <select aria-label={`Reading status for ${book.title || 'book'}`} value={book.status || 'want'} disabled={busy_ids.includes(book.id)} onchange={async (event) => { const select = event.currentTarget; if (!await update_status(book, select.value)) select.value = book.status || 'want' }}>{#each status_options as status (status.value)}<option value={status.value}>{status.label}</option>{/each}</select>\n              <div class=\"rating\" role=\"group\" aria-label={`Rating for ${book.title || 'book'}`}>\n                {#each [1, 2, 3, 4, 5] as star (star)}<button class=\"star\" class:filled={star <= (book.rating || 0)} aria-label={star === book.rating ? 'Clear rating' : `Rate ${star} out of 5`} aria-pressed={star === book.rating} disabled={busy_ids.includes(book.id)} onclick={() => set_rating(book, star === book.rating ? 0 : star)}><Icon icon=\"lucide:star\" width={16} /></button>{/each}\n              </div>\n            </div>\n            {#if pending_delete_id === book.id}<div class=\"delete-confirm\"><span>Delete this book?</span><button class=\"danger\" disabled={busy_ids.includes(book.id)} onclick={() => delete_book(book)}>{busy_ids.includes(book.id) ? 'Deleting…' : 'Delete'}</button><button disabled={busy_ids.includes(book.id)} onclick={() => pending_delete_id = null}>Cancel</button></div>{/if}\n            {#if editing_notes === book.id}\n              <div class=\"notes-editor\"><label>Notes<textarea bind:value={notes_text} rows=\"3\" placeholder={content.notes_placeholder}></textarea></label><div class=\"form-actions\"><button class=\"primary\" disabled={busy_ids.includes(book.id)} onclick={() => save_notes(book)}>{busy_ids.includes(book.id) ? 'Saving…' : content.save_notes}</button><button onclick={() => { notes_drafts.delete(book.id); editing_notes = null }} disabled={busy_ids.includes(book.id)}>{content.cancel}</button></div></div>\n            {:else}\n              {#if book.notes}<p class=\"book-notes\">{book.notes}</p>{/if}<button class=\"notes-btn\" disabled={busy_ids.includes(book.id)} onclick={() => start_editing_notes(book)}><Icon icon=\"lucide:file-text\" width={14} />{book.notes ? content.edit_notes : content.add_notes}</button>\n            {/if}\n          </div>\n        </article>\n      {/each}\n    </div>\n  {/if}\n</div>\n\n<style>\n  :global(*) { box-sizing: border-box; }\n  .page { min-height: 100vh; padding: 1.75rem 1.25rem 3rem; background: var(--bg-color, #fafafa); color: var(--heading-color, #202020); font-family: var(--font, system-ui, sans-serif); font-size: .875rem; }\n  header, .controls, .filters, .book-list, .add-form, .notice, .empty { max-width: 860px; margin-left: auto; margin-right: auto; }\n  .heading, .book-heading, .controls, .book-controls, .form-actions, .row-actions, .notice, .delete-confirm { display: flex; align-items: center; gap: .625rem; }\n  .heading, .book-heading { justify-content: space-between; }\n  h1 { min-width: 0; overflow-wrap: anywhere; margin: 0; font-size: 1.375rem; font-weight: 650; letter-spacing: -.025em; }\n  h2 { margin: 0; font-size: .9375rem; font-weight: 600; line-height: 1.4; overflow-wrap: anywhere; }\n  .stats { display: flex; flex-wrap: wrap; gap: .5rem; color: var(--text-color, #737373); font-size: .8125rem; margin: .625rem 0 1.5rem; }\n  button, input, textarea, select { font: inherit; }\n  button, select { cursor: pointer; }\n  button { display: inline-flex; align-items: center; justify-content: center; gap: .375rem; min-height: 34px; padding: .375rem .625rem; border: 1px solid var(--border-color, #e5e5e5); border-radius: var(--radius, 6px); color: inherit; background: var(--card-bg, #fff); }\n  button:hover:not(:disabled) { border-color: var(--text-color, #737373); }\n  button:disabled, select:disabled { opacity: .55; cursor: default; }\n  .primary { background: var(--accent-color, #92400e); border-color: transparent; color: white; white-space: nowrap; }\n  .primary:hover:not(:disabled) { filter: brightness(.94); border-color: transparent; }\n  label { display: flex; flex-direction: column; gap: .375rem; font-size: .8125rem; }\n  input, textarea, select { min-width: 0; width: 100%; padding: .5rem .625rem; border: 1px solid var(--border-color, #e5e5e5); border-radius: var(--radius, 6px); background: var(--card-bg, #fff); color: inherit; }\n  textarea { resize: vertical; }\n  .add-form { padding: 1rem; border: 1px solid var(--border-color, #e5e5e5); border-radius: var(--radius, 6px); background: var(--card-bg, #fff); margin-bottom: 1.25rem; }\n  .form-fields { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; margin: .875rem 0; }\n  .cover-field { grid-column: 1 / -1; }\n  .form-actions { margin-top: .625rem; }\n  .controls { gap: 1rem; margin-bottom: .75rem; }\n  .search { flex: 1; flex-direction: row; align-items: center; gap: .5rem; padding: 0 .625rem; min-width: 0; border: 1px solid var(--border-color, #e5e5e5); border-radius: var(--radius, 6px); background: var(--card-bg, #fff); color: var(--text-color, #737373); }\n  .search input { border: 0; background: none; padding: .625rem 0; }\n  .sort { flex-direction: row; align-items: center; color: var(--text-color, #737373); white-space: nowrap; }\n  .sort select { width: auto; }\n  .filters { display: flex; flex-wrap: wrap; gap: .375rem; margin-bottom: 1rem; }\n  .filters button { font-size: .8125rem; }\n  .filters button span { color: var(--text-color, #737373); }\n  .filters .active { border-color: var(--accent-color, #92400e); color: var(--accent-color, #92400e); }\n  .book-list { border: 1px solid var(--border-color, #e5e5e5); border-radius: var(--radius, 6px); background: var(--card-bg, #fff); overflow: hidden; }\n  .book-row { display: flex; align-items: flex-start; gap: 1rem; padding: 1.125rem; border-bottom: 1px solid var(--border-color, #e5e5e5); }\n  .book-row:last-child { border-bottom: none; }\n  .cover { display: flex; align-items: center; justify-content: center; width: 50px; height: 72px; flex: none; background: var(--bg-color, #fafafa); border: 1px solid var(--border-color, #e5e5e5); border-radius: 3px; color: var(--text-color, #737373); overflow: hidden; }\n  .cover img { width: 100%; height: 100%; object-fit: cover; }\n  .book-info { flex: 1; min-width: 0; }\n  .book-heading { align-items: flex-start; gap: .5rem; }\n  .row-actions { gap: .125rem; flex: none; }\n  .icon-btn { padding: .375rem; border-color: transparent; color: var(--text-color, #737373); }\n  .author { margin: .125rem 0 0; color: var(--text-color, #737373); font-size: .8125rem; overflow-wrap: anywhere; }\n  .book-controls { flex-wrap: wrap; margin-top: .625rem; }\n  .book-controls select { width: auto; font-size: .8125rem; padding: .375rem .5rem; }\n  .rating { display: flex; gap: 0; }\n  .star { min-width: 32px; min-height: 34px; padding: .375rem; border-color: transparent; color: var(--text-color, #737373); }\n  .star.filled { color: var(--star-color, #b45309); }\n  .star.filled :global(svg) { fill: currentColor; }\n  .book-notes { margin: .625rem 0 .25rem; line-height: 1.5; color: var(--text-color, #737373); white-space: pre-wrap; overflow-wrap: anywhere; }\n  .notes-btn { color: var(--text-color, #737373); padding: .25rem 0; min-height: 32px; border: none; background: none; font-size: .8125rem; }\n  .notes-editor { margin-top: .75rem; }\n  .notice { justify-content: space-between; flex-wrap: wrap; margin-top: .75rem; margin-bottom: .75rem; padding: .625rem .75rem; border: 1px solid #fecaca; border-radius: var(--radius, 6px); color: #991b1b; background: #fff7f7; font-size: .8125rem; }\n  .error-text { color: #b91c1c; font-size: .8125rem; }\n  .delete-confirm { flex-wrap: wrap; margin-top: .75rem; font-size: .8125rem; }\n  .danger { color: #b91c1c; border-color: #fecaca; }\n  .empty { text-align: center; padding: 2rem 1rem; color: var(--text-color, #737373); }\n  :global(button:focus-visible), :global(input:focus-visible), :global(textarea:focus-visible), :global(select:focus-visible) { outline: 2px solid var(--accent-color, #92400e); outline-offset: 2px; }\n  @media (max-width: 580px) {\n    .page { padding: 1.25rem .875rem 2rem; }\n    h1 { font-size: 1.25rem; }\n    .controls { align-items: stretch; flex-direction: column; gap: .5rem; }\n    .sort { align-self: flex-end; }\n    .form-fields { grid-template-columns: 1fr; }\n    .book-row { gap: .625rem; padding: .875rem .75rem; }\n    .cover { width: 38px; height: 56px; }\n    input, textarea, select, .book-controls select { font-size: 16px; }\n    .star { min-width: 34px; min-height: 38px; }\n    .book-controls { gap: .375rem; }\n    .icon-btn { min-height: 38px; min-width: 34px; }\n  }\n  @media (prefers-reduced-motion: reduce) { :global(*) { scroll-behavior: auto !important; } }\n</style>\n",
	"design": [
		{
