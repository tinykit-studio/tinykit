{
  "id": "client-crm",
  "name": "Clients",
  "description": "Keep client details and follow-up dates.",
  "preview": "lucide:users",
  "tags": [
    "business",
    "intermediate",
    "data"
  ],
  "kits": [
    "business",
    "freelance"
  ],
  "frontend_code": "<script>\n\timport Icon from '@iconify/svelte'\n\timport { onDestroy } from 'svelte'\n\timport content from '$content'\n\timport data from '$data'\n\n\tconst list_params = { all: true }\n\tlet clients = $state([])\n\tlet loading = $state(true)\n\tlet load_error = $state('')\n\tlet error = $state('')\n\tlet saving = $state(false)\n\tlet pending_ids = $state([])\n\tlet filter = $state('all')\n\tlet sort_by = $state('last_contact')\n\tlet view = $state('list')\n\tlet search = $state('')\n\tlet modal_open = $state(false)\n\tlet dialog = $state(null)\n\tlet editing_client = $state(null)\n\tlet just_logged = $state(null)\n\tlet dragging_id = $state(null)\n\tlet drag_over_status = $state(null)\n\tlet today = $state(new Date())\n\tlet disposed = false\n\tlet logged_timer\n\tlet form = $state(empty_form())\n\n\tconst statuses = [\n\t\t{ id: 'lead', label: 'Lead', color: 'var(--lead-color)' },\n\t\t{ id: 'active', label: 'Active', color: 'var(--active-color)' },\n\t\t{ id: 'inactive', label: 'Inactive', color: 'var(--inactive-color)' },\n\t\t{ id: 'churned', label: 'Churned', color: 'var(--overdue-color)' }\n\t]\n\tconst sources = ['referral', 'website', 'social', 'cold', 'other']\n\tfunction receive(items) {\n\t\tif (disposed) return\n\t\tclients = items.map(client => ({ ...client, name: String(client.name ?? '').trim() || 'Unnamed client',\n\t\t\tcompany: String(client.company ?? ''), email: String(client.email ?? ''), phone: String(client.phone ?? ''), notes: String(client.notes ?? ''),\n\t\t\tstatus: statuses.some(status => status.id === client.status) ? client.status : 'lead' }))\n\t\tloading = false; load_error = ''\n\t}\n\tfunction fail_load() { if (disposed) return; loading = false; load_error = 'Could not load clients.' }\n\tconst unsubscribe = data.clients.subscribe(receive, list_params, fail_load)\n\tconst clock = setInterval(() => { today = new Date() }, 60000)\n\tonDestroy(() => { disposed = true; unsubscribe(); clearInterval(clock); clearTimeout(logged_timer) })\n\tasync function retry_load() {\n\t\tif (loading || disposed) return\n\t\tloading = true\n\t\ttry { receive(await data.clients.list(list_params)) } catch { fail_load() }\n\t}\n\n\tfunction get_view_from_url() {\n\t\tif (typeof window === 'undefined') return 'list'\n\t\tconst value = new URLSearchParams(window.location.search).get('view')\n\t\treturn ['list', 'table', 'kanban'].includes(value) ? value : 'list'\n\t}\n\tview = get_view_from_url()\n\t$effect(() => {\n\t\tif (typeof window === 'undefined') return\n\t\ttry {\n\t\t\tconst params = new URLSearchParams(window.location.search)\n\t\t\tif (view === 'list') params.delete('view'); else params.set('view', view)\n\t\t\twindow.history.replaceState({}, '', window.location.pathname + (params.size ? `?${params}` : '') + window.location.hash)\n\t\t} catch { /* Sandboxed previews do not always allow history changes. */ }\n\t})\n\t$effect(() => {\n\t\tif (modal_open && dialog && !dialog.open) dialog.showModal()\n\t\telse if (!modal_open && dialog?.open) dialog.close()\n\t})\n\n\tfunction day_number(value) {\n\t\tif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(value || '')) return null\n\t\tconst [year, month, day] = value.split('-').map(Number)\n\t\tconst date = new Date(0)\n\t\tdate.setUTCFullYear(year, month - 1, day); date.setUTCHours(0, 0, 0, 0)\n\t\treturn date.getUTCFullYear() === year && date.getUTCMonth() === month - 1 && date.getUTCDate() === day ? date.getTime() / 86400000 : null\n\t}\n\tfunction date_key(date) { return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}` }\n\tfunction is_overdue(value) { const day = day_number(value); return day !== null && day < day_number(date_key(today)) }\n\tfunction is_due(value) { const day = day_number(value); return day !== null && day <= day_number(date_key(today)) }\n\tfunction contacted_today(value) { return value === date_key(today) }\n\tfunction format_relative_date(value) {\n\t\tconst day = day_number(value)\n\t\tif (day === null) return '\u2014'\n\t\tconst diff = day_number(date_key(today)) - day\n\t\tif (diff === 0) return 'Today'\n\t\tif (diff === 1) return 'Yesterday'\n\t\tif (diff === -1) return 'Tomorrow'\n\t\tif (diff < 0 && diff > -7) return `In ${-diff} days`\n\t\tif (diff > 1 && diff < 7) return `${diff} days ago`\n\t\treturn new Date(day * 86400000).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })\n\t}\n\tfunction has_value(value) { return value !== null && value !== undefined && value !== '' && Number.isFinite(Number(value)) && Number.isSafeInteger(Math.round(Number(value) * 100)) }\n\tfunction cents(value) { const number = Number(value); return has_value(value) && number >= 0 ? Math.round((number + Number.EPSILON) * 100) : 0 }\n\tfunction format_currency(value) { return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: cents(value) % 100 === 0 ? 0 : 2, maximumFractionDigits: 2 }).format(cents(value) / 100) }\n\tfunction get_status_info(id) { return statuses.find(status => status.id === id) || statuses[0] }\n\tfunction get_filtered_clients() {\n\t\tlet rows = clients\n\t\tif (filter === 'leads') rows = rows.filter(client => client.status === 'lead')\n\t\telse if (filter === 'active') rows = rows.filter(client => client.status === 'active')\n\t\telse if (filter === 'follow-up') rows = rows.filter(client => is_due(client.next_follow_up))\n\t\tconst query = search.trim().toLowerCase()\n\t\tif (query) rows = rows.filter(client => [client.name, client.company, client.email, client.phone].some(value => String(value || '').toLowerCase().includes(query)))\n\t\treturn [...rows].sort((a, b) => {\n\t\t\tif (sort_by === 'name') return (a.name || '').localeCompare(b.name || '')\n\t\t\tif (sort_by === 'value') return cents(b.value) - cents(a.value)\n\t\t\tif (sort_by === 'follow_up') return (day_number(a.next_follow_up) ?? Infinity) - (day_number(b.next_follow_up) ?? Infinity) || (a.name || '').localeCompare(b.name || '')\n\t\t\treturn (day_number(b.last_contact) ?? -Infinity) - (day_number(a.last_contact) ?? -Infinity) || (a.name || '').localeCompare(b.name || '')\n\t\t})\n\t}\n\tlet filtered_clients = $derived.by(get_filtered_clients)\n\tfunction get_stats() {\n\t\treturn { total: clients.length, leads: clients.filter(client => client.status === 'lead').length,\n\t\t\toverdue: clients.filter(client => is_overdue(client.next_follow_up)).length,\n\t\t\tpipeline: clients.filter(client => ['lead', 'active'].includes(client.status)).reduce((sum, client) => sum + cents(client.value), 0) / 100 }\n\t}\n\tlet stats = $derived.by(get_stats)\n\tlet clients_by_status = $derived.by(() => Object.fromEntries(statuses.map(status => [status.id, filtered_clients.filter(client => client.status === status.id)])))\n\n\tfunction empty_form() { return { name: '', company: '', email: '', phone: '', status: 'lead', source: 'other', notes: '', last_contact: '', next_follow_up: '', value: '' } }\n\tfunction open_add_modal() {\n\t\tif (saving) return\n\t\tediting_client = null; form = empty_form(); error = ''; modal_open = true\n\t}\n\tfunction open_edit_modal(client) {\n\t\tif (saving || pending_ids.includes(client.id)) return\n\t\tediting_client = client; error = ''\n\t\tform = { name: client.name || '', company: client.company || '', email: client.email || '', phone: client.phone || '',\n\t\t\tstatus: get_status_info(client.status).id, source: sources.includes(client.source) ? client.source : 'other', notes: client.notes || '',\n\t\t\tlast_contact: client.last_contact || '', next_follow_up: client.next_follow_up || '', value: client.value ?? '' }\n\t\tmodal_open = true\n\t}\n\tfunction close_modal() { if (saving) return; modal_open = false; editing_client = null; error = '' }\n\tasync function save_client(event) {\n\t\tevent?.preventDefault()\n\t\tif (saving || (editing_client && pending_ids.includes(editing_client.id))) return\n\t\terror = ''\n\t\tconst name = String(form.name || '').trim(), email = String(form.email || '').trim()\n\t\tconst blank_value = form.value === '' || form.value === null || form.value === undefined\n\t\tif (!name) { error = 'Enter a client name.'; return }\n\t\tif (email && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) { error = 'Enter a valid email address or leave it blank.'; return }\n\t\tif (!blank_value && (!Number.isFinite(Number(form.value)) || Number(form.value) < 0 || !Number.isSafeInteger(Math.round(Number(form.value) * 100)))) { error = 'Enter a value of zero or more.'; return }\n\t\tif ((form.last_contact && day_number(form.last_contact) === null) || (form.next_follow_up && day_number(form.next_follow_up) === null)) { error = 'Enter valid contact and follow-up dates.'; return }\n\t\tif (form.last_contact && day_number(form.last_contact) > day_number(date_key(today))) { error = 'Last contact cannot be in the future.'; return }\n\t\tconst fields = { name, company: form.company.trim(), email, phone: form.phone.trim(), status: form.status, source: form.source,\n\t\t\tnotes: form.notes.trim(), last_contact: form.last_contact, next_follow_up: form.next_follow_up, value: blank_value ? null : cents(form.value) / 100 }\n\t\tsaving = true\n\t\ttry {\n\t\t\tif (editing_client) await data.clients.update(editing_client.id, fields)\n\t\t\telse await data.clients.create(fields)\n\t\t\tsaving = false; close_modal()\n\t\t} catch { error = 'Could not save the client. Your changes are still here.' }\n\t\tfinally { saving = false }\n\t}\n\tasync function log_contact(client) {\n\t\tif (pending_ids.includes(client.id)) return\n\t\terror = ''; pending_ids = [...pending_ids, client.id]\n\t\tconst updates = { last_contact: date_key(new Date()) }\n\t\tif (is_due(client.next_follow_up)) updates.next_follow_up = ''\n\t\ttry {\n\t\t\tawait data.clients.update(client.id, updates)\n\t\t\tif (!disposed) { just_logged = client.id; clearTimeout(logged_timer); logged_timer = setTimeout(() => { just_logged = null }, 2000) }\n\t\t} catch { error = 'Could not log contact. Try again.' }\n\t\tfinally { pending_ids = pending_ids.filter(id => id !== client.id) }\n\t}\n\tasync function delete_client(id) {\n\t\tif (saving || pending_ids.includes(id) || !confirm('Delete this client?')) return\n\t\tsaving = true; error = ''\n\t\ttry { await data.clients.delete(id); saving = false; close_modal() }\n\t\tcatch { error = 'Could not delete the client. Try again.' }\n\t\tfinally { saving = false }\n\t}\n\tasync function change_status(id, status) {\n\t\tif (!statuses.some(item => item.id === status) || pending_ids.includes(id)) return false\n\t\tconst client = clients.find(item => item.id === id)\n\t\tif (!client) return false\n\t\tif (client.status === status) return true\n\t\terror = ''; pending_ids = [...pending_ids, id]\n\t\ttry { await data.clients.update(id, { status }); return true }\n\t\tcatch { error = 'Could not change client status. Try again.'; return false }\n\t\tfinally { pending_ids = pending_ids.filter(value => value !== id) }\n\t}\n\tasync function select_status(event, client) {\n\t\tconst select = event.currentTarget\n\t\tif (!await change_status(client.id, select.value)) select.value = clients.find(item => item.id === client.id)?.status || client.status\n\t}\n\tfunction handle_drag_start(event, client) { if (pending_ids.includes(client.id)) { event.preventDefault(); return }; dragging_id = client.id; event.dataTransfer.effectAllowed = 'move'; event.dataTransfer.setData('text/plain', client.id) }\n\tfunction handle_drag_end() { dragging_id = null; drag_over_status = null }\n\tfunction handle_drag_over(event, status) { event.preventDefault(); event.dataTransfer.dropEffect = 'move'; drag_over_status = status }\n\tfunction handle_drag_leave(event, status) { if (!event.currentTarget.contains(event.relatedTarget) && drag_over_status === status) drag_over_status = null }\n\tasync function handle_drop(event, status) { event.preventDefault(); const id = dragging_id; handle_drag_end(); if (id) await change_status(id, status) }\n</script>\n\n<div class=\"page\">\n\t<header class=\"header\">\n\t\t<div class=\"header-content\"><h1>{content.title}</h1><button class=\"primary\" disabled={loading || !!load_error} onclick={open_add_modal}><Icon icon=\"lucide:plus\" width={17} />{content.add_button_text}</button></div>\n\t\t<div class=\"stats\"><span><strong>{stats.total}</strong> Clients</span><span><strong>{stats.leads}</strong> Leads</span><span class:overdue={stats.overdue > 0}><strong>{stats.overdue}</strong> Overdue</span><span><strong>{format_currency(stats.pipeline)}</strong> Open value</span></div>\n\t</header>\n\t<div class=\"filters\">\n\t\t<div class=\"tabs\" aria-label=\"Filter clients\">{#each [{id:'all',label:'All'}, {id:'leads',label:'Leads'}, {id:'active',label:'Active'}, {id:'follow-up',label:'Follow-up'}] as item}<button class=\"tab\" class:active={filter === item.id} aria-pressed={filter === item.id} onclick={() => filter = item.id}>{item.label}</button>{/each}</div>\n\t\t<div class=\"filter-controls\">\n\t\t\t<label class=\"search\"><Icon icon=\"lucide:search\" width={16} /><input type=\"search\" aria-label=\"Search clients\" bind:value={search} placeholder={content.search_placeholder} /></label>\n\t\t\t<select class=\"sort-select\" aria-label=\"Sort clients\" bind:value={sort_by}><option value=\"last_contact\">Last contact</option><option value=\"name\">Name</option><option value=\"value\">Value</option><option value=\"follow_up\">Follow-up</option></select>\n\t\t\t<div class=\"view-toggle\" aria-label=\"Client view\">{#each [{id:'list',label:'List',icon:'lucide:layout-list'}, {id:'table',label:'Table',icon:'lucide:table-2'}, {id:'kanban',label:'Board',icon:'lucide:columns-3'}] as item}<button class=\"view-btn\" class:active={view === item.id} aria-label={`${item.label} view`} aria-pressed={view === item.id} onclick={() => view = item.id}><Icon icon={item.icon} width={17} /></button>{/each}</div>\n\t\t</div>\n\t</div>\n\t<main>\n\t\t{#if load_error}<div class=\"notice\" role=\"alert\"><span>{load_error}</span><button onclick={retry_load} disabled={loading}>{loading ? 'Retrying\u2026' : 'Retry'}</button></div>{/if}\n\t\t{#if error && !modal_open}<p class=\"notice\" role=\"alert\">{error}</p>{/if}\n\t\t{#if just_logged}<p class=\"sr-only\" role=\"status\">Contact logged.</p>{/if}\n\t\t{#if loading && !clients.length}<p class=\"empty\" role=\"status\">Loading clients\u2026</p>\n\t\t{:else if !filtered_clients.length && !load_error}<div class=\"empty\"><h2>{clients.length ? 'No matching clients' : content.empty_state}</h2>{#if clients.length}<p>Try another search or filter.</p><button onclick={() => { search = ''; filter = 'all' }}>Clear filters</button>{:else}<p>Add contact details and keep track of follow-ups.</p><button class=\"primary\" onclick={open_add_modal}>{content.add_button_text}</button>{/if}</div>\n\t\t{:else if view === 'kanban'}\n\t\t\t<div class=\"kanban-board\">{#each statuses as status (status.id)}<section class=\"kanban-column\" class:drag-over={drag_over_status === status.id} aria-label={`${status.label} clients`} ondragover={event => handle_drag_over(event, status.id)} ondragleave={event => handle_drag_leave(event, status.id)} ondrop={event => handle_drop(event, status.id)}>\n\t\t\t\t<h2><span class=\"status-dot\" style:background={status.color}></span>{status.label}<span class=\"count\">{clients_by_status[status.id].length}</span></h2>\n\t\t\t\t{#each clients_by_status[status.id] as client (client.id)}<article class=\"kanban-card\" class:dragging={dragging_id === client.id} draggable={!pending_ids.includes(client.id)} ondragstart={event => handle_drag_start(event, client)} ondragend={handle_drag_end}>\n\t\t\t\t\t<button class=\"client-title\" onclick={() => open_edit_modal(client)}>{client.name}</button>{#if client.company}<p>{client.company}</p>{/if}\n\t\t\t\t\t{#if has_value(client.value)}<p class=\"value\">{format_currency(client.value)}</p>{/if}\n\t\t\t\t\t{#if client.next_follow_up}<p class:overdue={is_overdue(client.next_follow_up)}>Follow up: {format_relative_date(client.next_follow_up)}</p>{/if}\n\t\t\t\t\t<select aria-label={`Status for ${client.name}`} value={client.status} disabled={pending_ids.includes(client.id)} onchange={event => select_status(event, client)}>{#each statuses as option}<option value={option.id}>{option.label}</option>{/each}</select>\n\t\t\t\t</article>{:else}<p class=\"column-empty\">No clients</p>{/each}\n\t\t\t</section>{/each}</div>\n\t\t{:else if view === 'table'}\n\t\t\t<div class=\"table-scroll\"><table><caption class=\"sr-only\">Clients and contact details</caption><thead><tr><th scope=\"col\">Name</th><th scope=\"col\">Company</th><th scope=\"col\">Email</th><th scope=\"col\">Status</th><th scope=\"col\">Value</th><th scope=\"col\">Last contact</th><th scope=\"col\">Follow-up</th></tr></thead><tbody>\n\t\t\t\t{#each filtered_clients as client (client.id)}{@const status = get_status_info(client.status)}<tr><th scope=\"row\"><button class=\"client-title\" onclick={() => open_edit_modal(client)}>{client.name}</button></th><td>{client.company || '\u2014'}</td><td>{#if client.email}<a href={`mailto:${client.email}`}>{client.email}</a>{:else}\u2014{/if}</td><td><span class=\"status-badge\" style:color={status.color} style:background={`color-mix(in srgb, ${status.color} 9%, transparent)`}>{status.label}</span></td><td>{has_value(client.value) ? format_currency(client.value) : '\u2014'}</td><td>{format_relative_date(client.last_contact)}</td><td class:overdue={is_overdue(client.next_follow_up)}>{format_relative_date(client.next_follow_up)}</td></tr>{/each}\n\t\t\t</tbody></table></div>\n\t\t{:else}\n\t\t\t<div class=\"clients-list\">{#each filtered_clients as client (client.id)}{@const status = get_status_info(client.status)}<article class=\"client-row\">\n\t\t\t\t<div class=\"client-main\"><div class=\"client-heading\"><button class=\"client-title\" onclick={() => open_edit_modal(client)}>{client.name}</button><span class=\"status-badge\" style:color={status.color} style:background={`color-mix(in srgb, ${status.color} 9%, transparent)`}>{status.label}</span></div>\n\t\t\t\t\t<div class=\"details\">{#if client.company}<span>{client.company}</span>{/if}{#if has_value(client.value)}<span>{format_currency(client.value)}</span>{/if}</div>\n\t\t\t\t\t<div class=\"contact-details\">{#if client.email}<a href={`mailto:${client.email}`}>{client.email}</a>{/if}{#if client.phone}<a href={`tel:${client.phone}`}>{client.phone}</a>{/if}</div>\n\t\t\t\t\t{#if client.notes}<p class=\"notes\">{client.notes}</p>{/if}\n\t\t\t\t\t<div class=\"meta\">{#if client.last_contact}<span>Contacted {format_relative_date(client.last_contact).toLowerCase()}</span>{/if}{#if client.next_follow_up}<span class:overdue={is_overdue(client.next_follow_up)}>Follow up: {format_relative_date(client.next_follow_up)}</span>{/if}</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"client-actions\">{#if !contacted_today(client.last_contact)}<button class=\"log-button\" aria-label={`Log contact with ${client.name}`} disabled={pending_ids.includes(client.id)} onclick={() => log_contact(client)}><Icon icon={just_logged === client.id ? 'lucide:check' : 'lucide:user-check'} width={16} /><span>{pending_ids.includes(client.id) ? 'Saving\u2026' : 'Log contact'}</span></button>{/if}<button class=\"edit-button\" aria-label={`Edit ${client.name}`} onclick={() => open_edit_modal(client)} disabled={pending_ids.includes(client.id)}><Icon icon=\"lucide:pencil\" width={16} /></button></div>\n\t\t\t</article>{/each}</div>\n\t\t{/if}\n\t</main>\n</div>\n\n<dialog bind:this={dialog} aria-labelledby=\"client-form-title\" oncancel={event => { if (saving) event.preventDefault(); else close_modal() }} onclose={close_modal} onclick={event => { if (event.target === dialog) close_modal() }}>\n\t<form onsubmit={save_client}>\n\t\t<div class=\"dialog-heading\"><h2 id=\"client-form-title\">{editing_client ? 'Edit client' : content.add_button_text}</h2><button type=\"button\" class=\"close-button\" aria-label=\"Close client form\" disabled={saving} onclick={close_modal}><Icon icon=\"lucide:x\" width={18} /></button></div>\n\t\t{#if error}<p class=\"notice\" role=\"alert\">{error}</p>{/if}\n\t\t<fieldset disabled={saving}>\n\t\t\t<div class=\"form-row\"><label for=\"client-name\"><span>Name <span class=\"required\">(required)</span></span><input id=\"client-name\" bind:value={form.name} autocomplete=\"name\" required /></label><label for=\"client-company\">Company<input id=\"client-company\" bind:value={form.company} autocomplete=\"organization\" /></label></div>\n\t\t\t<div class=\"form-row\"><label for=\"client-email\">Email<input id=\"client-email\" type=\"email\" bind:value={form.email} autocomplete=\"email\" /></label><label for=\"client-phone\">Phone<input id=\"client-phone\" type=\"tel\" bind:value={form.phone} autocomplete=\"tel\" /></label></div>\n\t\t\t<div class=\"form-row\"><label for=\"client-status\">Status<select id=\"client-status\" bind:value={form.status}>{#each statuses as status}<option value={status.id}>{status.label}</option>{/each}</select></label><label for=\"client-source\">Source<select id=\"client-source\" bind:value={form.source}>{#each sources as source}<option value={source}>{source.charAt(0).toUpperCase() + source.slice(1)}</option>{/each}</select></label></div>\n\t\t\t<div class=\"form-row\"><label for=\"client-last-contact\">Last contact<input id=\"client-last-contact\" type=\"date\" max={date_key(today)} bind:value={form.last_contact} /></label><label for=\"client-follow-up\">Next follow-up<input id=\"client-follow-up\" type=\"date\" bind:value={form.next_follow_up} /></label></div>\n\t\t\t<label for=\"client-value\">Value (USD)<input id=\"client-value\" type=\"number\" min=\"0\" step=\"0.01\" inputmode=\"decimal\" bind:value={form.value} placeholder=\"0.00\" /></label>\n\t\t\t<label for=\"client-notes\">Notes<textarea id=\"client-notes\" bind:value={form.notes} rows=\"3\"></textarea></label>\n\t\t</fieldset>\n\t\t<div class=\"form-actions\">{#if editing_client}<button type=\"button\" class=\"danger\" disabled={saving} onclick={() => delete_client(editing_client.id)}>Delete</button>{/if}<button type=\"button\" disabled={saving} onclick={close_modal}>Cancel</button><button class=\"primary\" disabled={saving}>{saving ? 'Saving\u2026' : editing_client ? 'Save changes' : content.add_button_text}</button></div>\n\t</form>\n</dialog>\n\n<style>\n\t:global(body) { margin: 0; background: var(--page-background); }\n\t:global(*) { box-sizing: border-box; }\n\t.page { min-height: 100vh; background: var(--page-background); color: var(--body-text); font-family: var(--font-family); font-size: 14px; }\n\tbutton, input, select, textarea { font: inherit; }\n\tbutton { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 38px; padding: 8px 12px; border: 1px solid var(--border-color); border-radius: var(--card-radius); background: transparent; color: var(--body-text); cursor: pointer; }\n\tbutton:hover:not(:disabled) { background: color-mix(in srgb, var(--body-text) 4%, transparent); }\n\tbutton:disabled { opacity: .5; cursor: default; }\n\tbutton.primary { background: var(--primary-color); border-color: var(--primary-color); color: white; }\n\tbutton.primary:hover:not(:disabled) { filter: brightness(.95); }\n\ta { color: inherit; text-decoration-color: var(--border-color); text-underline-offset: 3px; }\n\ta:hover { color: var(--primary-color); }\n\t.header { padding: 24px; background: var(--header-background); border-bottom: 1px solid var(--border-color); }\n\t.header-content { display: flex; align-items: center; justify-content: space-between; gap: 16px; }\n\th1 { min-width: 0; overflow-wrap: anywhere; font-size: 22px; letter-spacing: -.4px; font-weight: 600; margin: 0; color: var(--heading-color); }\n\t.stats { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 16px; color: var(--secondary-text); font-size: 12px; }\n\t.stats strong { color: var(--heading-color); font-weight: 600; margin-right: 3px; }\n\t.overdue, .stats .overdue strong { color: var(--overdue-color); }\n\t.filters { padding: 12px 24px; background: var(--header-background); border-bottom: 1px solid var(--border-color); display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; }\n\t.tabs { display: flex; gap: 2px; min-width: 0; }\n\t.tab { border-color: transparent; padding: 7px 10px; font-size: 13px; white-space: nowrap; color: var(--secondary-text); }\n\t.tab.active { background: color-mix(in srgb, var(--body-text) 6%, transparent); color: var(--heading-color); }\n\t.filter-controls { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; min-width: 0; }\n\t.search { display: flex; flex-direction: row; gap: 6px; align-items: center; border: 1px solid var(--border-color); padding: 0 10px; border-radius: var(--card-radius); color: var(--secondary-text); min-height: 38px; }\n\t.search input { width: 170px; border: 0; padding: 8px 0; background: transparent; min-height: 34px; }\n\t.search:focus-within { outline: 2px solid var(--primary-color); outline-offset: 2px; }\n\t.search input:focus-visible { outline: 0; }\n\t.sort-select { width: auto; min-height: 38px; font-size: 12px; }\n\t.view-toggle { display: flex; border: 1px solid var(--border-color); border-radius: var(--card-radius); }\n\t.view-btn { min-width: 38px; min-height: 36px; padding: 7px; border: 0; border-radius: 0; color: var(--secondary-text); }\n\t.view-btn.active { color: var(--heading-color); background: color-mix(in srgb, var(--body-text) 6%, transparent); }\n\tmain { padding: 24px; min-width: 0; max-width: 1400px; margin: auto; }\n\t.notice { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; padding: 12px; border: 1px solid var(--border-color); border-radius: var(--card-radius); margin: 0 0 16px; }\n\t.empty { padding: 56px 12px; text-align: center; color: var(--secondary-text); }\n\t.empty h2 { margin: 0 0 8px; color: var(--heading-color); font-size: 18px; font-weight: 600; }\n\t.empty p { margin: 0 0 20px; line-height: 1.6; }\n\t.clients-list { border: 1px solid var(--border-color); border-radius: var(--card-radius); background: var(--card-background); }\n\t.client-row { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 18px 20px; border-bottom: 1px solid var(--border-color); }\n\t.client-row:last-child { border-bottom: 0; }\n\t.client-main { min-width: 0; flex: 1; }\n\t.client-heading { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }\n\t.client-title { min-height: 28px; min-width: 0; padding: 0; border: 0; border-radius: 2px; text-align: left; justify-content: flex-start; font-weight: 600; color: var(--heading-color); overflow-wrap: anywhere; }\n\t.client-title:hover:not(:disabled) { background: transparent; color: var(--primary-color); }\n\t.status-badge { font-size: 11px; font-weight: 500; padding: 3px 6px; border-radius: 4px; white-space: nowrap; }\n\t.details, .contact-details, .meta { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: 6px; color: var(--secondary-text); font-size: 12px; line-height: 1.5; }\n\t.contact-details a { overflow-wrap: anywhere; }\n\t.notes { font-size: 12px; line-height: 1.5; color: var(--secondary-text); margin: 6px 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere; }\n\t.meta { font-size: 11px; }\n\t.client-actions { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }\n\t.log-button { font-size: 12px; }\n\t.edit-button { min-width: 38px; padding: 8px; }\n\t.table-scroll { overflow-x: auto; max-width: 100%; border: 1px solid var(--border-color); border-radius: var(--card-radius); }\n\ttable { width: 100%; min-width: 820px; border-collapse: collapse; background: var(--card-background); text-align: left; font-size: 12px; }\n\tth, td { padding: 14px 16px; border-bottom: 1px solid var(--border-color); white-space: nowrap; }\n\tthead th { color: var(--secondary-text); background: var(--page-background); font-size: 11px; font-weight: 500; }\n\ttbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }\n\t.kanban-board { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }\n\t.kanban-column { min-width: 0; padding: 12px; background: color-mix(in srgb, var(--body-text) 3%, var(--page-background)); border: 1px solid var(--border-color); border-radius: var(--card-radius); }\n\t.kanban-column.drag-over { border-color: var(--primary-color); }\n\t.kanban-column h2 { display: flex; gap: 8px; align-items: center; margin: 0 0 14px; font-size: 12px; font-weight: 600; }\n\t.status-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }\n\t.count { margin-left: auto; color: var(--secondary-text); font-weight: 400; }\n\t.kanban-card { padding: 12px; border: 1px solid var(--border-color); border-radius: var(--card-radius); background: var(--card-background); margin-top: 8px; cursor: grab; }\n\t.kanban-card.dragging { opacity: .5; }\n\t.kanban-card p { font-size: 11px; color: var(--secondary-text); margin: 6px 0; line-height: 1.5; overflow-wrap: anywhere; }\n\t.kanban-card p.overdue { color: var(--overdue-color); }\n\t.kanban-card .value { color: var(--body-text); }\n\t.kanban-card select { margin-top: 10px; padding: 7px; font-size: 12px; }\n\t.column-empty { margin: 20px 0; text-align: center; font-size: 12px; color: var(--secondary-text); }\n\tdialog { width: min(560px, calc(100% - 32px)); max-height: calc(100dvh - 32px); padding: 24px; background: var(--card-background); color: var(--body-text); border: 1px solid var(--border-color); border-radius: var(--card-radius); font-family: var(--font-family); }\n\tdialog::backdrop { background: rgb(0 0 0 / .35); }\n\t.dialog-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }\n\t.dialog-heading h2 { margin: 0; font-size: 18px; font-weight: 600; }\n\t.close-button { border: 0; min-width: 36px; min-height: 36px; padding: 6px; }\n\tfieldset { min-width: 0; border: 0; padding: 0; margin: 0; display: grid; gap: 16px; }\n\t.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }\n\tlabel { display: flex; flex-direction: column; gap: 7px; font-size: 12px; min-width: 0; }\n\t.required { display: inline; color: var(--secondary-text); font-size: 11px; }\n\tinput, select, textarea { width: 100%; min-width: 0; min-height: 38px; padding: 9px 10px; border: 1px solid var(--border-color); border-radius: var(--card-radius); color: var(--body-text); background: var(--card-background); }\n\ttextarea { resize: vertical; }\n\t.form-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 24px; }\n\t.danger { color: var(--overdue-color); margin-right: auto; }\n\t.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }\n\t:global(button:focus-visible), :global(a:focus-visible), :global(input:focus-visible), :global(select:focus-visible), :global(textarea:focus-visible) { outline: 2px solid var(--primary-color); outline-offset: 3px; }\n\t@media (max-width: 1000px) { .kanban-board { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n\t@media (max-width: 600px) {\n\t\t.header { padding: 18px 16px; }\n\t\t.stats { gap: 8px 16px; }\n\t\t.filters { padding: 10px 16px; gap: 10px; }\n\t\t.filter-controls { width: 100%; }\n\t\t.search { width: 100%; }\n\t\t.search input { width: 100%; }\n\t\t.sort-select { flex: 1; }\n\t\tmain { padding: 16px; }\n\t\t.client-row { padding: 16px; gap: 12px; align-items: flex-start; }\n\t\t.client-actions { flex-direction: column-reverse; }\n\t\t.log-button { min-width: 38px; padding: 9px; }\n\t\t.log-button span { display: none; }\n\t\t.kanban-board { grid-template-columns: 1fr; }\n\t\tdialog { p